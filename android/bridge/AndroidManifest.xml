<?xml version="1.0" encoding="utf-8"?>
<!--
  parallel-root bridge: the one capability shell uid provably cannot have.

  Shell (uid 2000) can READ every notification through dumpsys, including
  which of them carry direct-reply actions. It cannot FIRE one: a
  PendingIntent is a live Binder token held in system_server, and dumpsys
  prints a description of it, not the thing itself. There is no path from
  that text back to a fireable object.

  Nor can Shizuku shortcut it. INotificationManager.registerListener() calls
  enforceSystemOrSystemUI(), which admits uid 1000 (system), 1001 (phone) and
  0 (root), and that check runs SERVER side, inside system_server. Shizuku's
  trick is bypassing the CLIENT side hidden-API blocklist, a different layer
  entirely. Verified against AOSP source, not guessed.

  So: an app, holding a bound NotificationListenerService, which is the only
  process that ever gets the live Notification.Action. The app is that
  listener plus a loopback server for it (Listener and Bridge), and nothing
  else: no activity, no UI, no RESOURCES. The icon is a platform drawable,
  which is what keeps the build to a handful of tool invocations and no
  Gradle.

  Installed with `pm install` and granted with `cmd notification
  allow_listener`, which also happens to be the documented way past Android
  13's "Restricted settings" wall for sideloaded apps.

  (XML comments cannot contain a double hyphen, which is why no flag is
  spelled out above: aapt2 rejects one as an invalid token.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="parallelroot.bridge">

    <!-- Loopback only. The bridge is reached the same way `phone shelld` is:
         an ssh forward from the controller. Nothing listens off-device. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application android:label="parallel-root bridge"
                 android:icon="@android:drawable/sym_action_chat"
                 android:allowBackup="false">

        <!-- BIND_NOTIFICATION_LISTENER_SERVICE is a signature permission the
             SYSTEM holds, not us. Declaring it here is how we say "only the
             system may bind this service". -->
        <service
            android:name=".Listener"
            android:exported="true"
            android:label="parallel-root bridge"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
    </application>
</manifest>
