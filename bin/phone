                   help="fraction of the safe band to travel")
    s.add_argument("--ms", type=int, default=260)
    s.add_argument("--pause", type=float, default=0.45)
    s.add_argument("--look", action="store_true")
    s.add_argument("--limit", type=int, default=40)

    s = add("scan", cmd_scan, "scroll until a label appears — loop on device")
    s.add_argument("query")
    s.add_argument("--max", type=int, default=8,
                   help="how many screenfuls to try before giving up")
    s.add_argument("--direction", default="down",
                   choices=["down", "up", "left", "right"])
    s.add_argument("--tap", action="store_true", help="tap it when found")
    s.add_argument("--look", action="store_true")
    s.add_argument("--after", metavar="LABEL")
    s.add_argument("--exact", action="store_true")
