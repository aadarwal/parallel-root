#!/usr/bin/env python3
"""phone — the parallel-root CLI: let agents drive an Android phone.

One verb layer over the two mechanisms an unrooted Android phone actually
offers.

  termux-api   the device as a peripheral — speak, listen, notifications,
               camera, torch, location, clipboard, SMS.
  shell        the device as a system and a screen, at shell uid — read its
               state (content query, dumpsys, settings), launch it (am
               start), see it (screencap), read it as text (uiautomator),
               touch it (input). Reached through Shizuku (rish), which once
               started needs no PC and no network connection at all; adb
               against the phone's own wireless-debugging endpoint is the
               fallback for a phone without it.

Everything an agent needs is a verb here, so the agent never has to know
whether a capability comes from termux-api or the shell. The same file runs
in two places: on the phone, in Termux, and on any controller that can ssh
to it. With `--device <ssh-host>` every verb addresses that phone — shell
verbs over a forwarded socket, termux-api verbs by running this CLI on the
phone itself — so an agent anywhere drives the phone by calling these verbs.

Stdlib only, Python 3.8+.

The parsing verbs (`ui`, `look`, `find`, `notifs`, `cal`, `contacts`,
`media`) accept `--from FILE` so the logic that an LLM depends on is testable
off-device.
"""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

# Friendly names -> packages. An agent says "whatsapp", not a reverse-DNS id.
APPS = {
    "whatsapp": "com.whatsapp",
    "gmail": "com.google.android.gm",
    "mail": "com.google.android.gm",
    "signal": "org.thoughtcrime.securesms",
    "telegram": "org.telegram.messenger",
    "messages": "com.google.android.apps.messaging",
    "sms": "com.google.android.apps.messaging",
    "ytmusic": "com.google.android.apps.youtube.music",
    "youtubemusic": "com.google.android.apps.youtube.music",
    "youtube": "com.google.android.youtube",
    "spotify": "com.spotify.music",
    "maps": "com.google.android.apps.maps",
    "chrome": "com.android.chrome",
    "photos": "com.google.android.apps.photos",
    "calendar": "com.google.android.calendar",
    "slack": "com.Slack",
    "instagram": "com.instagram.android",
}


# Deep links: the LEVEL-1 path to app control. Android switches wireless
# debugging OFF on a network change or after idle, so anything that matters
# must not need adb. termux-open-url hands a link to Android, which routes it
# to the owning app — same result as `am start`, no adb involved.
#
# Which of these apps ALSO declares a play-from-search handler is not written
# down here. A music app on the reference device DOES declare one — reading
# the query-activities output through `head` once suggested it did not,
# which is the same mistake as trusting any other truncated view of the
# artifact. Six packages on the reference device declared it, and which six
# depends entirely on what a phone has installed. Which is exactly why the
# handler set is READ (intent_handlers), never written down here.
LINKS = {
    "ytmusic": "https://music.youtube.com/search?q={q}",
    "youtubemusic": "https://music.youtube.com/search?q={q}",
    "spotify": "https://open.spotify.com/search/{q}",
    "applemusic": "https://music.apple.com/search?term={q}",
    "apple": "https://music.apple.com/search?term={q}",
    "youtube": "https://www.youtube.com/results?search_query={q}",
    "whatsapp": "https://wa.me/",
    "gmail": "https://mail.google.com/",
    "mail": "https://mail.google.com/",
    "maps": "https://maps.google.com/?q={q}",
    "photos": "https://photos.google.com/",
    "calendar": "https://calendar.google.com/",
    "chrome": "https://www.google.com/",
}


def is_url(s):
    return "://" in s or s.startswith("www.")


_PKGS = None


_PKGS_ALL = None


def installed_packages(third_party_only=True):
    """Packages on the device, cached per process.

    RESOLUTION uses the full list, not `-3`. Third-party-only made every
    system app invisible — chrome, youtube, photos, calendar — including
    names the CLI's own error message advertises as valid. Worse, an
    unresolvable name then fell through to a substring search over the
    third-party list and took the single hit, so `--app chrome` answered
    about com.google.android.apps.chromecast.app: Google Home.
    """
    global _PKGS, _PKGS_ALL
    if third_party_only:
        if _PKGS is None:
            rc, out = dev_shell("pm list packages -3", timeout=40)
            _PKGS = sorted(l.replace("package:", "").strip()
                           for l in (out or "").splitlines() if l.strip()) \
                if rc == 0 else []
        return _PKGS
    if _PKGS_ALL is None:
        rc, out = dev_shell("pm list packages", timeout=40)
        _PKGS_ALL = sorted(l.replace("package:", "").strip()
                           for l in (out or "").splitlines() if l.strip()) \
            if rc == 0 else []
    return _PKGS_ALL


def package_present(pkg):
    """Is this exact package on the device? True / False / None.

    NOT installed_packages(): that asks `pm list packages -3`, third-party
    only, and the apps a `play` link targets are frequently SYSTEM packages —
    on a Pixel, com.google.android.youtube and ...youtube.music both are.
    Checking the third-party list would refuse to play music on a phone that
    has the player, which is a false refusal traded for a false success and
    no better than what it replaced.

    None means "could not look" (no device shell) and must never be read as
    absence: losing level 2 would otherwise start refusing level 1 work.
    """
    rc, out = dev_shell("pm list packages %s" % pkg, timeout=25)
    if rc != 0:
        return None
    want = "package:" + pkg
    return any(l.strip() == want for l in (out or "").splitlines())


def pkg_of(name):
    """Resolve a friendly name to a package that is ACTUALLY on this device.

    The hardcoded table was written from habit, not from the phone: a table
    maps apps a given phone does not have and knows nothing about apps it
    does. So `open keep` failed on a phone with Keep while `open whatsapp`
    pretended to work on a phone without WhatsApp. The table is now only a
    set of aliases — the device's own package list is the authority.
    """
    if not name:
        return None
    n = name.strip().lower()
    if "." in name:
        return name
    pkgs = installed_packages(third_party_only=False)
    if not pkgs:                       # no shell — fall back to the aliases
        return APPS.get(n)
    alias = APPS.get(n)
    if alias and alias in pkgs:
        return alias
    # WHOLE SEGMENTS ONLY. "chrome" is a substring of "chromecast", and a
    # substring search resolved it to Google Home with full confidence and no
    # warning — the same failure as tapping a coordinate that turned out to
    # belong to a different button.
    def segs(p):
        return [x.lower() for x in p.split(".")]

    last = [p for p in pkgs if segs(p)[-1] == n]
    if len(last) == 1:
        return last[0]
    anywhere = [p for p in pkgs if n in segs(p)]
    cands = last or anywhere
    if len(cands) == 1:
        return cands[0]
    if cands:
        # Ambiguity is NAMED, never narrowed. Picking the shortest is a coin
        # flip wearing a heuristic's clothes, and the caller cannot tell it
        # happened.
        die("%r matches %d packages on this device — say which:\n  %s"
            % (name, len(cands), "\n  ".join(sorted(cands))), 4)
    return None


def die(msg, code=2):
    sys.stderr.write("phone: %s\n" % msg)
    sys.exit(code)


def run(cmd, timeout=30, want_bytes=False):
    """Run a command. Returns (rc, out). Never raises on a non-zero exit."""
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           text=not want_bytes)
        return r.returncode, (r.stdout if r.stdout is not None else
                              (b"" if want_bytes else ""))
    except FileNotFoundError:
        return 127, (b"" if want_bytes else "")
    except subprocess.TimeoutExpired:
        return 124, (b"" if want_bytes else "")


def have_termux():
    if os.environ.get("PHONE_NO_DEVICE"):
        return False
    return shutil.which("termux-tts-speak") is not None


def need_termux():
    if not have_termux():
        die("no device: termux-api tools are not available here. These "
            "verbs run ON the phone (Termux); from a controller, name the "
            "phone with --device <ssh-host>.", 3)


def termux(name, *args, **kw):
    need_termux()
    exe = shutil.which(name)
    if not exe:
        die("no device: %s is missing (install the termux-api package AND "
            "the Termux:API app, signed by the same key as Termux)" % name, 3)
    return run([exe] + [str(a) for a in args], timeout=kw.get("timeout", 30))


def adb(*args, **kw):
    """adb against the phone's own wireless-debugging endpoint."""
    if os.environ.get("PHONE_NO_DEVICE"):
        die("no device: adb is unavailable", 3)
    exe = shutil.which("adb")
    if not exe:
        die("no device: adb is missing (pkg install android-tools)", 3)
    rc, out = run([exe] + [str(a) for a in args],
                  timeout=kw.get("timeout", 40),
                  want_bytes=kw.get("want_bytes", False))
    if rc == 127:
        die("no device: adb could not run", 3)
    return rc, out


def adb_ready():
    rc, out = adb("devices", timeout=15)
    return rc == 0 and re.search(r"\tdevice\s*$", out or "", re.M) is not None


def need_adb():
    if not adb_ready():
        die("adb is not connected — reconnect it with `adb connect "
            "<phone-ip>:<port>` (the port rotates after a reboot; pairing "
            "itself persists)", 3)



# ---------------------------------------------------------- the device shell
# Two ways to reach shell UID on this phone, and they are not equal:
#
#   shizuku  a privileged service bootstrapped ONCE from wireless debugging,
#            then reached over Binder IPC. No port, no connection, no network
#            state — nothing for Android to switch off. This is the real one.
#   adb      the same power over TCP, which Android tears down on a network
#            change or after idle, and which the phone cannot re-enable
#            itself (SELinux blocks `settings put` from an app's shell).
#
# Everything that needs shell goes through dev_shell(), which prefers shizuku
# and treats adb as a fallback for devices that do not have it. That is why
# the watchdog's adb step is opt-in: with shizuku present, adb is not
# load-bearing.

def rish_path():
    return os.environ.get("PHONE_RISH") or os.path.join(
        os.path.expanduser("~"), "rish")


def have_rish():
    if os.environ.get("PHONE_NO_DEVICE"):
        return False
    p = rish_path()
    return os.path.isfile(p) and os.access(p, os.X_OK)


def _rish(cmd, timeout=40, want_bytes=False):
    env = dict(os.environ)
    # rish identifies the caller to shizuku by application id; termux is the
    # app the human authorised.
    env.setdefault("RISH_APPLICATION_ID", "com.termux")
    try:
        r = subprocess.run([rish_path(), "-c", cmd], capture_output=True,
                           timeout=timeout, text=not want_bytes, env=env,
                           cwd=os.path.expanduser("~"))
        return r.returncode, (r.stdout if r.stdout is not None
                              else (b"" if want_bytes else ""))
    except FileNotFoundError:
        return 127, (b"" if want_bytes else "")
    except subprocess.TimeoutExpired:
        return 124, (b"" if want_bytes else "")


def merged(cmd):
    """Wrap a device command so its STDERR comes home too.

    We hand back a single stream, and everything that fails loudly on a phone
    fails on stderr — a denied `content query` prints a SecurityException
    there and exits 0. Dropped, that arrives as RC=0 with no output, which is
    byte-for-byte identical to "readable and empty". The verb built to tell
    those two apart could not tell them apart.

    NOT applied to every command: bulk readers parse stdout strictly, and a
    stray warning folded into a UI dump turns valid XML into a parse error.
    Opt-in, at the call sites that want a diagnosis rather than a document.

    Braces, not a subshell — `{ ...; } 2>&1` keeps the command's own exit
    status, which is half of what we came for.
    """
    return "{ %s ; } 2>&1" % cmd


def dev_shell(cmd, timeout=40, want_bytes=False):
    """Run a command at shell UID on this device. Returns (rc, out)."""
    # The persistent shell first: it skips the ~1.1s process spawn entirely.
    # It carries text only — anything binary goes via dev_read().
    if not want_bytes:
        r = shelld_call(cmd, timeout=timeout)
        if r is not None:
            return r
    if have_rish():
        rc, out = _rish(cmd, timeout=timeout, want_bytes=want_bytes)
        if rc != 127:
            return rc, out
    if not os.environ.get("PHONE_NO_DEVICE") and shutil.which("adb") \
            and adb_ready():
        return adb("shell", cmd, timeout=timeout, want_bytes=want_bytes)
    return 127, (b"" if want_bytes else "")


# On Android /tmp is owned by shell:shell, and an app UID cannot write there
# EVEN IF the directory is mode 0777 — SELinux, not Unix permissions.
# (Tested: created a directory under /tmp as shell via Shizuku, chmod 777,
# and Termux still got EACCES.) That is why TMPDIR is exported in every shell
# profile rather than "fixed" by relaxing a mode, and why removing that export
# silently breaks every tool in Termux that writes a temp file — including an
# agent CLI that runs each command through one.


_CHECK_RE = re.compile(r"\A__PHONE_MD5__ ([0-9a-fA-F]{32}) (-?\d+)\n", re.S)


def dev_shell_checked(cmd, timeout=90, attempts=4):
    """Run a command on the device and PROVE its output arrived intact.

    The persistent shell corrupts large reads. Not truncation — the byte
    count and the line count come back exactly right, with a region
    substituted by content from earlier in the stream, sometimes from the
    PREVIOUS command entirely. Measured over a 169 KB self-verifying payload:
    plain ssh 4/4 clean, shelld 4/4 corrupt, on-device and over the forward
    alike. Clean at 4 KB, half at 9 KB, none at 61 KB.

    Every guard we had passes it. rc is 0, the length is right, and a UI dump
    still opens with <hierarchy and closes with </hierarchy>. XML is merely
    brittle enough to notice; a package list or a dumpsys has nothing to
    notice with and would simply be believed.

    So the DEVICE states what it sent, and we check. The command writes to a
    file there, the file's md5 comes back ahead of the data, and a mismatch
    is retried. Retries converge quickly (measured 1-5 attempts) because the
    corruption is intermittent rather than deterministic.

    Root cause is still open — this is a check, not a cure. But a channel
    that is known to corrupt should be verified whether or not we understand
    why, and a verified read is correct even if there turn out to be several
    causes.
    """
    # Expanded by the DEVICE's shell, not here. /data/local/tmp is the only
    # place shell can reliably write on Android (/sdcard is a fuse mount the
    # installer cannot even read), but honouring TMPDIR first keeps the same
    # code exercisable off-device instead of needing a test-only flag — the
    # kind that has caused real damage in this file before.
    tmp = "${TMPDIR:-/data/local/tmp}/phone-rd-%d-%d" % (
        os.getpid(), int(time.time() * 1000))
    # md5 FIRST, then the data: a prefix can be located without trusting the
    # length of what follows.
    wrapped = ('{ %s ; } > %s 2>&1; __rc=$?; '
               'printf "__PHONE_MD5__ %%s %%s\n" '
               '"$(md5sum %s | cut -d" " -f1)" "$__rc"; '
               'cat %s; printf "#"; rm -f %s' % (cmd, tmp, tmp, tmp, tmp))
    last = None
    for _ in range(attempts):
        rc, out = dev_shell(wrapped, timeout=timeout)
        m = _CHECK_RE.match(out or "")
        if not m:
            last = "no checksum in the reply"
            continue
        want, inner_rc = m.group(1).lower(), int(m.group(2))
        body = (out or "")[m.end():]
        # The trailing "#" is load-bearing. The daemon strips ONE trailing
        # newline from every response — "byte-identical either way" is true
        # for a human reading it and fatal for a checksum — so a payload
        # ending in a newline could never match its own md5. Anchoring with a
        # non-newline byte means nothing is removed. Without this the check
        # failed 100% of the time, on reads that were perfectly intact.
        if not body.endswith("#"):
            last = "the end-anchor is missing — the reply was truncated"
            continue
        body = body[:-1]
        import hashlib
        got = hashlib.md5(body.encode("utf-8", "replace")).hexdigest()
        if got == want:
            return inner_rc, body
        last = "checksum %s, got %s (%d bytes)" % (want[:8], got[:8], len(body))
    die("the read did not survive the trip after %d attempts — %s. "
        "This is the known large-read corruption; the data is NOT "
        "trustworthy, so none is returned." % (attempts, last), 5)


def dev_read(remote_path, want_bytes=False):
    """Read a file the device shell just wrote.

    The shell channel truncates: a UI dump streamed back through rish
    arrived as exactly 8192 bytes — a pipe-buffer boundary — while the same
    file read directly was 24KB. So anything bulky goes through the filesystem: the
    privileged side WRITES it, and we read it ourselves. /sdcard is readable
    by this app, which is what makes the split possible.
    """
    mode = "rb" if want_bytes else "r"
    kw = {} if want_bytes else {"encoding": "utf-8", "errors": "replace"}
    try:
        with open(remote_path, mode, **kw) as f:
            return f.read()
    except OSError:
        pass
    # Fall back to streaming it, accepting the truncation risk, for devices
    # where the path is not directly readable.
    rc, out = dev_shell("cat %s" % remote_path, timeout=60,
                        want_bytes=want_bytes)
    return out if rc == 0 else (b"" if want_bytes else "")


_SHELL_OK = None


def have_shell():
    """Is there a device shell at all? Memoised, and asks the DAEMON first.

    This used to prove liveness by spawning rish — paying the full ~1.14s
    process launch in front of every verb, purely to answer a yes/no. The
    persistent shell removed that cost from the command and left it standing
    in the doorway. Asking the daemon costs ~2ms, and if it answers it IS the
    shell, so nothing further needs proving.
    """
    global _SHELL_OK
    if _SHELL_OK is None:
        _SHELL_OK = _probe_shell()
    return _SHELL_OK


def _probe_shell():
    if os.environ.get("PHONE_NO_DEVICE") and not os.environ.get(
            "PHONE_SHELL_SOCK"):
        return False
    r = shelld_call("true", timeout=8)
    if r is not None and r[0] == 0:
        return True
    if have_rish():
        rc, _ = _rish("true", timeout=25)
        if rc == 0:
            return True
    return (not os.environ.get("PHONE_NO_DEVICE")
            and shutil.which("adb") is not None and adb_ready())


def need_shell():
    if not have_shell():
        die("no device shell: shizuku is not answering and adb is down. "
            "Start Shizuku on the phone (it survives network changes), or "
            "reconnect adb (`phone watchdog` does, when PHONE_ADB_ADDR is "
            "set).", 3)



# ------------------------------------------------------- the persistent shell
# The spawn IS the cost. Measured on a reference device (Pixel 10, Android
# 16): every rish invocation spends ~1.14s starting app_process and loading
# its dex, while the command itself takes milliseconds. Paying that per verb
# is what made the agent feel glacial — a single `phone ui` paid it twice.
#
# So: start ONE privileged shell and keep it. A tiny daemon owns that process
# and serves commands over a unix socket; every verb becomes a socket
# round-trip instead of a process launch. The shell is the same process
# across calls, so working directory and environment persist too.
#
# The protocol is deliberately dumb: write the command, then echo a sentinel
# carrying the exit status. Read until the sentinel. Nothing is parsed that
# the shell did not emit.

SENTINEL = "__PHONE_EOC__"

_TIMING_WARNED = set()


def _seconds(name, default, never_ok=False):
    """A timing variable in seconds, or its default when it is not one.

    These are read by EVERY invocation, not only by the daemon, so a value
    that does not parse must not take the whole CLI down with it. It used to:
    float() raised at import, and once the config file could set these, one
    typo in that file was a traceback from every verb. Warned about once per
    process and by name only, the way the config loader reports a line.

    `never_ok` is for the one timing where zero or less has always meant
    something — PHONE_SHELLD_IDLE, where it means "never exit" — and it comes
    back as 0. Everywhere else a value has to be a positive number.
    """
    import math
    raw = (os.environ.get(name) or "").strip()
    if not raw:
        return float(default)
    try:
        v = float(raw)
    except ValueError:
        v = None
    if never_ok and v is not None and math.isfinite(v) and v <= 0:
        return 0.0
    if v is None or not math.isfinite(v) or v <= 0:
        if name not in _TIMING_WARNED:
            _TIMING_WARNED.add(name)
            sys.stderr.write("phone: warning: %s is not a number of seconds "
                             "the daemon can use; using %g\n"
                             % (name, default))
        return float(default)
    return v


def read_timings():
    """The daemon's timings, from the environment.

    Read at import, and read AGAIN by main() once the config file is loaded:
    a timing set in that file reaches the environment only then, and a
    daemon started in the foreground would otherwise never see it.
    """
    global _SHELLD_DEADLINE, _SHELLD_TICK, _SHELLD_IDLE
    # How long the daemon waits for one command before killing its shell.
    _SHELLD_DEADLINE = _seconds("PHONE_SHELL_DEADLINE", 75)
    # How often the daemon looks up from accept() to ask whether it should
    # still be alive, and how long it may sit unused before deciding it
    # should not. IDLE=0, or anything below it, means "run forever", which is
    # what every daemon here used to do.
    _SHELLD_TICK = _seconds("PHONE_SHELLD_TICK", 30)
    _SHELLD_IDLE = _seconds("PHONE_SHELLD_IDLE", 3600, never_ok=True)


read_timings()
SHELLD_CTL = "\0shelld "        # NUL: a shell command can never begin this way


def _wait_gone(pid, seconds):
    """True once pid is no longer running. Polled, because there is no
    portable way to wait on a process that is not our child — and a daemon
    started with start_new_session() never is."""
    end = time.time() + seconds
    while time.time() < end:
        try:
            os.kill(pid, 0)
        except OSError:
            return True
        time.sleep(0.1)
    try:
        os.kill(pid, 0)
    except OSError:
        return True
    return False


def shell_pidfile(path=None):
    """Where the daemon says who it is.

    Without this there is no way to END a daemon: unlinking the socket only
    removes the NAME, leaving the process blocked in accept() on a socket
    nobody can dial, still holding its device shell. That is not theoretical
    — it left 727 orphans and 5GB of swap on a controller.
    """
    return (path or shell_sock()) + ".pid"


def _shelld_pid(path=None):
    """The live daemon a pidfile names, or 0.

    A pid is not an identity on its own. A daemon killed outright — Android's
    low-memory killer does not ask — leaves its pidfile behind, and the
    number in it goes to whatever process starts next. Trusted as it stands,
    that file makes a dead daemon look alive and hands `--stop` an unrelated
    process to signal. So the process has to be alive, ours to signal, and a
    shelld.
    """
    try:
        with open(shell_pidfile(path)) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return 0
    if pid <= 1:
        return 0
    try:
        os.kill(pid, 0)
    except OSError:
        return 0                # gone, or another uid's: not a daemon of ours
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            cmd = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        # No /proc (macOS). ps answers the same question; when it cannot be
        # asked either, the pid is all there is to go on.
        rc, out = run(["ps", "-ww", "-o", "command=", "-p", str(pid)],
                      timeout=10)
        cmd = out if rc == 0 else None
    if cmd is not None and " shelld" not in cmd:
        return 0
    return pid


def _sock_listening(path, timeout=2.0):
    """Does anything accept connections on this unix socket?

    A CONNECT, not a command. A daemon in the middle of somebody's long
    command still completes a connect — the kernel queues it — where a `true`
    round trip times out and makes a busy daemon look dead. A full queue says
    EAGAIN on Linux, which is still a listener; macOS refuses instead, which
    is why _incumbent() asks the pidfile as well.
    """
    import socket as _s
    c = _s.socket(_s.AF_UNIX, _s.SOCK_STREAM)
    c.settimeout(timeout)
    try:
        c.connect(path)
        return True
    except (BlockingIOError, InterruptedError, _s.timeout):
        return True
    except OSError:
        return False
    finally:
        try:
            c.close()
        except OSError:
            pass


def _incumbent(path):
    """Is a daemon already serving this socket, busy or not?"""
    if not os.path.exists(path):
        return False            # a daemon whose name is gone serves nobody
    return _sock_listening(path) or _shelld_pid(path) > 0


_LANE_RE = re.compile(r"\A[a-z0-9][a-z0-9_-]{0,30}\Z")


def lane():
    """This driver's own shell, if it asked for one.

    shelld is TWO things wearing one name: a fast shell, and the arbiter that
    holds the lease. The arbiter has to be shared — that is the entire point
    of a lease — but the shell does not, and while they were the same socket
    every driver's commands queued behind every other driver's. The accept
    loop is single-threaded and feeds ONE persistent sh, so a 3-second
    `uiautomator dump` is three seconds nobody else's `settings get` can run.
    
    A lane is a driver saying "give me my own shell". Empty by default, and
    then every path in this file is byte-identical to what it was. The lease
    stays keyed by DISPLAY inside whichever daemon holds it, so two lanes on
    the same display still arbitrate — see the note in cmd_shelld.
    """
    v = (os.environ.get("PHONE_LANE") or "").strip()
    if v and not _LANE_RE.match(v):
        die("PHONE_LANE wants a short lowercase name, got %r" % v, 2)
    return v


def _laned(path):
    """`.../phone-shell.sock` -> `.../phone-shell-<lane>.sock`."""
    ln = lane()
    if not ln:
        return path
    base, _, ext = path.rpartition(".")
    return "%s-%s.%s" % (base, ln, ext) if base else "%s-%s" % (path, ln)


def shell_sock():
    return os.environ.get("PHONE_SHELL_SOCK") or _laned(os.path.join(
        os.environ.get("PREFIX", "/tmp"), "tmp", "phone-shell.sock"))


def _shell_argv():
    """What the daemon keeps alive. Overridable so the protocol is testable
    off-device against a plain sh."""
    override = os.environ.get("PHONE_SHELL_ARGV")
    if override:
        return [override]
    # rish reads RISH_APPLICATION_ID from ITS OWN environment before it
    # starts — prefixing it to the command it runs sets it for the inner
    # shell, far too late, and rish exits complaining it is unset.
    return [rish_path(), "-c", "sh"]


def shelld_call(cmd, timeout=90):
    """Run a command in the persistent shell. Returns (rc, out) or None if
    the daemon is not reachable — callers fall back to spawning."""
    import socket as _s
    path = shell_sock()
    if not os.path.exists(path):
        return None
    c = _s.socket(_s.AF_UNIX, _s.SOCK_STREAM)
    c.settimeout(timeout)
    try:
        c.connect(path)
        c.sendall((cmd + "\n").encode("utf-8", "replace"))
        buf = b""
        while True:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
            if b"\n" + SENTINEL.encode() in buf or buf.startswith(
                    SENTINEL.encode()):
                break
    except (OSError, _s.timeout):
        return None
    finally:
        try:
            c.close()
        except OSError:
            pass
    text = buf.decode("utf-8", "replace")
    i = text.rfind(SENTINEL)
    if i < 0:
        return None
    rc_part = text[i + len(SENTINEL):].strip()
    try:
        rc = int(rc_part.split()[0]) if rc_part else 0
    except ValueError:
        rc = 0
    out = text[:i]
    if out.endswith("\n"):
        out = out[:-1]
    return rc, out


def cmd_shelld(args):
    # ONE DAEMON PER LANE. $PHONE_LANE picks the socket (see lane()), so
    # `PHONE_LANE=a phone shelld --start` and `PHONE_LANE=b ...` are two
    # independent shells that do not queue behind each other.
    #
    # The lease is keyed by display INSIDE a daemon, which means two drivers
    # sharing a lane arbitrate correctly and two drivers in different lanes
    # do not see each other's leases at all. That is the right trade only
    # because a lane is something a driver opts into: the default lane is
    # shared, so the default behaviour is still one arbiter for the phone.
    import socket as _s
    path = shell_sock()
    if args.stop:
        # Ask first, signal second, and only then remove the names.
        #
        # The old version did the LAST step alone: it unlinked the socket and
        # printed "stopped" while the daemon ran on untouched. Every such
        # "stop" produced an immortal process holding a shell, and a later
        # --start bound a fresh socket over the same path, orphaning any
        # incumbent the same way.
        pidf = shell_pidfile(path)
        # Only a pid that is still a daemon of ours gets signalled: a stale
        # pidfile names whatever process took that number next.
        pid = _shelld_pid(path)
        asked = shelld_call(SHELLD_CTL + "stop", timeout=5)
        gone = _wait_gone(pid, 5.0) if pid > 1 else asked is not None
        if not gone and pid > 1:
            # It did not answer (wedged in a command, or its socket was
            # already taken away). The pidfile is what makes this reachable.
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(os.getpgid(pid), sig)
                except OSError:
                    try:
                        os.kill(pid, sig)
                    except OSError:
                        break
                if _wait_gone(pid, 3.0):
                    gone = True
                    break
        for p in (path, pidf):
            try:
                os.unlink(p)
            except OSError:
                pass
        if pid > 1 and not gone:
            die("daemon %d would not die" % pid, 4)
        print("stopped")
        return 0
    if args.start:
        # A live daemon is reused, never bound over. Binding over the top is
        # how an incumbent becomes unreachable-but-running, which is the
        # orphan this whole path exists to prevent — and it costs more than a
        # process: the leases live only in the incumbent's memory, so every
        # display it held becomes free for the next driver who asks.
        #
        # Live is not "answered `true` within five seconds". A daemon in the
        # middle of somebody's long command answers nobody until that command
        # is done (the deadline allows 75 s), and reading that as dead
        # replaced it. Measured: a lease held across a `sleep 9` read `free`
        # after one --start, and a second driver took the display.
        live = shelld_call("true", timeout=5)
        if live is not None and live[0] == 0:
            print("shelld already listening on %s" % path)
            return 0
        if live is not None:
            # It answered, so its accept loop is fine and its leases are
            # real; only its SHELL is not. A fresh daemon would start the
            # same shell into the same state, and cost every lease.
            die("shelld on %s answers, but its shell does not (exit %d) — is "
                "Shizuku running? `phone shelld --stop` replaces it, and "
                "frees every lease it holds" % (path, live[0]), 4)
        if _incumbent(path):
            print("shelld on %s is busy; leaving it be" % path)
            return 0
        # Nothing is serving the socket. Re-exec ourselves detached.
        me = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
        me = os.path.realpath(me)
        argv = [sys.executable or "python3", me, "shelld"]
        proc = subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                stdin=subprocess.DEVNULL,
                                start_new_session=True)
        # Up means ANSWERING, not "its files exist". A daemon that dies at
        # birth leaves a socket and a pidfile behind, and the files alone
        # read as "listening" for a process that was already gone. An answer
        # also means the pidfile is there — the daemon writes it before it
        # accepts anything — so a caller can stop what it just started.
        # Bounded by the clock, not by a count: each probe can wait.
        end = time.time() + 15
        while time.time() < end:
            r = shelld_call("true", timeout=max(1, min(5, end - time.time())))
            if r is not None:
                if r[0] == 0:
                    print("shelld listening on %s" % path)
                    return 0
                die("shelld is listening on %s, but its shell does not "
                    "answer (exit %d) — is Shizuku running?" % (path, r[0]), 4)
            code = proc.poll()
            if code is not None:
                if _incumbent(path):
                    # Another daemon bound the socket between our look and
                    # ours, and ours stood down. Reused like any other.
                    print("shelld on %s was started by someone else; "
                          "leaving it be" % path)
                    return 0
                if code == 3:
                    die("shelld has no shell to keep: %s could not be "
                        "started" % _shell_argv()[0], 3)
                die("shelld exited before it served anything (status %d)"
                    % code, 4)
            time.sleep(0.25)
        die("shelld did not come up", 4)

    # foreground: own the shell and serve it
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d, 0o700)
    # Never over the top of a live daemon, however this one was started:
    # `phone shelld` can be run by hand, and two --starts at once can both
    # find nothing listening. Asking again here narrows that to the moment
    # between this check and the bind.
    if _incumbent(path):
        die("a daemon is already serving %s — `phone shelld --stop` first "
            "(it frees every lease that daemon holds)" % path, 4)
    try:
        os.unlink(path)
    except OSError:
        pass
    srv = _s.socket(_s.AF_UNIX, _s.SOCK_STREAM)
    srv.bind(path)
    os.chmod(path, 0o600)           # this socket IS shell-level power
    srv.listen(8)
    # Remember WHICH socket file is ours. A path is not an identity: unlink
    # and rebind gives the same name a different inode, and the daemon that
    # bound the old one can no longer be reached by anyone. Comparing inodes
    # is how it finds that out about itself.
    try:
        me_st = os.stat(path)
        my_sock = (me_st.st_dev, me_st.st_ino)
    except OSError:
        my_sock = None
    pidf = shell_pidfile(path)
    with open(pidf, "w") as f:
        f.write("%d\n" % os.getpid())
    try:
        os.chmod(pidf, 0o600)
    except OSError:
        pass

    # The lease. Held in this process, and guarded by its OWN lock.
    #
    # It is tempting to skip the lock: the accept loop below is
    # single-threaded, so check-and-set is already atomic. But that makes the
    # lease's correctness depend on a distant, unrelated property of the
    # daemon — and the most natural future change here, serving connections
    # concurrently so one slow verb stops blocking others, would silently
    # make it racy. Nothing would fail and nothing would error; you would
    # just occasionally get two drivers, which is exactly what the lease
    # exists to prevent, and it would be nearly unreproducible.
    # The lock costs nothing while this stays single-threaded, and it keeps
    # the correctness local to the thing being protected.
    import threading as _th
    # ONE LEASE PER DISPLAY, not one per phone.
    #
    # A driver takes a screen, and since `phone display` this phone can have
    # more than one. A single global holder would make a second display
    # pointless: the first driver would still lock out the second, which is
    # the exact contention the display was created to remove.
    #
    # The key rides at the END of the line, not the front. An older daemon
    # parses `acquire <who> <ttl>` positionally and ignores what follows, so a
    # new CLI against an old daemon degrades to the single global lease it
    # already had — rather than reading a display id as a TTL, throwing
    # ValueError inside the accept loop, and wedging the daemon for everyone.
    leases = {}
    lease_lock = _th.Lock()

    def lease_op(line):
        # A request that cannot be read is a refused REQUEST, never the end
        # of the daemon. This loop is the arbiter for every driver on the
        # phone: a ValueError escaping it (a holder name with a space in it,
        # read as a TTL) took every lease it held down with it. The CLI
        # checks what it sends; this is for whatever else speaks the
        # protocol.
        try:
            with lease_lock:
                return _lease_op_locked(line)
        except Exception:
            return 2, "bad lease request"

    def _lease_op_locked(line):
        import math
        parts = line.split()
        op = parts[0] if parts else "status"
        now = time.time()
        for dead in [k for k, v in leases.items() if now >= v[1]]:
            del leases[dead]                # a dead holder must not brick it
        if op == "status":
            key = parts[1] if len(parts) > 1 else "0"
            held = leases.get(key)
            if not held:
                return 0, "-"
            return 0, "%s %d" % (held[0], max(0, int(held[1] - now)))
        if op == "acquire":
            who = parts[1] if len(parts) > 1 else "anon"
            ttl = float(parts[2]) if len(parts) > 2 else DEFAULT_TTL
            # Finite, or the lease never expires — the brick the TTL exists
            # to prevent — and every later status on that display fails.
            if not math.isfinite(ttl):
                return 2, "bad lease request"
            key = parts[3] if len(parts) > 3 else "0"
            held = leases.get(key)
            if held and held[0] != who:
                return 1, held[0]
            leases[key] = (who, now + ttl)  # re-acquire renews
            return 0, who
        if op == "release":
            who = parts[1] if len(parts) > 1 else "anon"
            key = parts[2] if len(parts) > 2 else "0"
            held = leases.get(key)
            if held and held[0] != who:
                return 1, held[0]
            leases.pop(key, None)
            return 0, "-"
        return 2, "unknown lease op"

    # A one-element box so the shell can be replaced without rebinding a
    # closure variable.
    box = [None]

    def spawn():
        env = dict(os.environ)
        env.setdefault("RISH_APPLICATION_ID", "com.termux")
        box[0] = subprocess.Popen(_shell_argv(), stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, text=True,
                                  bufsize=1, env=env,
                                  cwd=os.path.expanduser("~"),
                                  # own process group, so a deadline can take
                                  # the hung child down with the shell
                                  start_new_session=True)
        return box[0]

    def alive():
        return box[0] is not None and box[0].poll() is None

    def run_one(cmd, _retry=True):
        # Retry only when the shell was ALREADY dead before we wrote — never
        # after a timeout, because the command may well have taken effect and
        # re-running a tap or a send is worse than failing.
        # A command can legitimately kill the shell — `exit`, a crash, the OS
        # reaping it. The daemon has to outlive its shell, or one bad command
        # silently bricks every later call.
        if not alive():
            spawn()
        try:
            return _run_in(cmd)
        except (BrokenPipeError, OSError, ValueError):
            if not _retry:
                return 127, ""
            spawn()
            try:
                return _run_in(cmd)
            except Exception:
                return 127, ""

    def _run_in(cmd, deadline_s=None):
        # A DEADLINE, because readline() on a hung command blocks the single
        # accept loop forever: one `uiautomator dump` waiting on a screen that
        # never goes idle wedged the daemon permanently, and every later
        # client then waited out its own timeout. Without this the fast path
        # is slower than the spawn path it replaced, on exactly the screens
        # that already fail.
        #
        # Enforced with a watchdog that kills the shell, NOT with select():
        # select() reports the fd, but a text-mode reader keeps data in its
        # own buffer, so select says "nothing readable" while a full response
        # is sitting there — measured, it silently truncated 5000 lines to
        # 3499. Blocking readline is correct; the timer is what bounds it.
        import threading
        proc = box[0]
        timed_out = [False]

        def _fire():
            timed_out[0] = True
            # Kill the whole PROCESS GROUP. Killing just the shell leaves its
            # child (the actually-hung command) alive holding the same stdout
            # pipe, so readline never returns and the deadline does nothing —
            # measured: a 3s deadline still took the full 30s.
            try:
                os.killpg(os.getpgid(proc.pid), 9)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

        wd = threading.Timer(deadline_s or _SHELLD_DEADLINE, _fire)
        wd.daemon = True
        wd.start()
        proc.stdin.write("%s\n" % cmd)
        # A LEADING newline: without it, a command whose output does not end
        # in one leaves the sentinel on that same line, the startswith()
        # check never matches, and the daemon waits out the full deadline —
        # measured at 75.20s for `head -c 100`, with the data already there.
        # The extra newline is removed from the result below, so output is
        # byte-identical either way.
        proc.stdin.write('printf "\\n%%s %%s\\n" %s "$?"\n' % SENTINEL)
        proc.stdin.flush()
        lines = []
        while True:
            line = proc.stdout.readline()
            if not line:
                wd.cancel()
                if timed_out[0]:
                    # The shell was killed for running too long. Abandoned,
                    # not retried: the command may well have taken effect.
                    return 124, "".join(lines)
                # The shell ended mid-command (e.g. `exit`). Report what we
                # got; the next call respawns.
                return 127, "".join(lines)
            if line.startswith(SENTINEL):
                wd.cancel()
                rc_s = line[len(SENTINEL):].strip()
                try:
                    rc = int(rc_s)
                except ValueError:
                    rc = 0
                body = "".join(lines)
                # Drop exactly the newline we injected, so a command that
                # ended with one keeps it and one that did not stays bare.
                if body.endswith("\n"):
                    body = body[:-1]
                return rc, body
            lines.append(line)

    def still_ours():
        """False once this daemon can no longer be reached.

        Checked on every idle tick because the two ways a daemon is abandoned
        — its socket unlinked, or a second daemon binding the same path — are
        both INVISIBLE from inside accept(). Nothing errors; the process just
        waits forever on a name that no longer routes to it.
        """
        if my_sock is None:
            return True
        try:
            st = os.stat(path)
        except OSError:
            return False            # unlinked: nothing can dial us again
        return (st.st_dev, st.st_ino) == my_sock

    last = time.time()
    srv.settimeout(_SHELLD_TICK)
    stopping = False
    try:
        # The shell starts INSIDE the try, so that one which cannot start at
        # all — no rish on this phone — still runs the cleanup below. Dying
        # before it would leave the socket and the pidfile behind: names that
        # read as a healthy daemon, and a pid for --stop to signal long after
        # it belongs to something else.
        try:
            spawn()
        except OSError as e:
            sys.stderr.write("phone: shelld has no shell to keep: %s (%s)\n"
                             % (_shell_argv()[0], e.strerror or e))
            return 3
        while not stopping:
            try:
                conn, _ = srv.accept()
            except _s.timeout:
                if not still_ours():
                    break           # abandoned — do not become an orphan
                if _SHELLD_IDLE > 0 and time.time() - last > _SHELLD_IDLE:
                    break           # nobody has used the fast path in an hour
                continue
            last = time.time()
            try:
                conn.settimeout(120)
                data = b""
                while not data.endswith(b"\n"):
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
                raw = data.decode("utf-8", "replace")
                cmd = raw.strip()
                if not cmd:
                    continue
                if raw.startswith(SHELLD_CTL):
                    # Answer BEFORE exiting, so the stopper learns it worked
                    # rather than timing out and resorting to signals.
                    stopping = True
                    rc, out = 0, "stopping"
                elif raw.startswith(LEASE_CTL):
                    rc, out = lease_op(raw[len(LEASE_CTL):].strip())
                else:
                    rc, out = run_one(cmd)
                conn.sendall(out.encode("utf-8", "replace"))
                conn.sendall(("%s %d\n" % (SENTINEL, rc)).encode())
            except Exception:
                # Anything, not only OSError: one connection that goes wrong
                # must not end the loop every driver's lease lives in.
                pass
            finally:
                try:
                    conn.close()
                except OSError:
                    pass
    finally:
        # Only clean up the names if they are still OURS. A daemon that was
        # replaced must not delete the live socket on its way out.
        if still_ours():
            for p in (path, pidf):
                try:
                    os.unlink(p)
                except OSError:
                    pass
        # Take the shell's whole process GROUP. terminate() on the shell alone
        # leaves whatever it was running mid-command alive and holding the
        # same pipes — the same mistake the deadline watchdog above already
        # had to correct.
        try:
            if box[0]:
                os.killpg(os.getpgid(box[0].pid), signal.SIGKILL)
        except Exception:
            try:
                if box[0]:
                    box[0].kill()
            except Exception:
                pass
    return 0


def cmd_sh(args):
    """Run a raw command at device-shell level (through the persistent shell
    when it is up). The escape hatch, and how the fast path is exercised."""
    # The escape hatch shows everything. Anyone reaching for `phone sh` is
    # diagnosing, and withholding the half of the output that says WHY is
    # the opposite of useful.
    cmd = merged(" ".join(args.cmd))
    if args.checked:
        rc, out = dev_shell_checked(cmd, timeout=args.timeout)
    else:
        r = shelld_call(cmd)
        if r is None:
            rc, out = dev_shell(cmd, timeout=args.timeout)
        else:
            rc, out = r
    sys.stdout.write(out if out.endswith("\n") or not out else out + "\n")
    return rc



# ----------------------------------------------------------------- the lease
# Two drivers acting on one phone is not a race that produces a wrong pixel —
# it is one agent typing into another agent's chat. So a driver takes a lease
# before it acts.
#
# The lease lives in SHELLD, for two reasons: it is on-device, so it
# arbitrates the local agent and a remote controller identically; and every
# shell verb already funnels through it. Check-and-set takes the daemon's own
# lease lock (see cmd_shelld), so it does not depend on the accept loop
# staying single-threaded.
#
# The CLI does the GATING rather than the daemon, because the termux-api
# verbs (open, play, say, photo, torch) never reach shelld at all — a gate
# only shelld enforced would leave exactly those unguarded.
#
# It carries a TTL because the failure that matters is a driver that dies
# holding it. A phone that can be bricked by a crashed agent is worse than
# one with no lease.

LEASE_CTL = "\0lease "          # NUL: a shell command can never begin this way
DEFAULT_TTL = 300


def actor():
    return os.environ.get("PHONE_ACTOR") or "anon"


# ONE WORD, because the lease protocol is a line split on spaces. A holder
# called "agent b" reached the daemon as `acquire agent b 300 0`: the "b" was
# read as the TTL, and the ValueError ended the shared daemon (reproduced
# against a local sh daemon) — every lease it held went with it, and every
# later verb ran unarbitrated, because no daemon means nothing to arbitrate.
# A release under the same name read "b" as the display and printed
# "released" for a lease it never touched.
_HOLDER_RE = re.compile(r"\A[A-Za-z0-9._@:+-]{1,64}\Z")


def lease_holder(who):
    """`who`, checked as a lease holder BEFORE anything is sent."""
    if not _HOLDER_RE.match(who or ""):
        die("a lease holder is one word of letters, digits and ._@:+- (at "
            "most 64 characters), got %r — pass --as <name>, or set "
            "PHONE_ACTOR to one" % who, 2)
    return who


# Verbs that CHANGE the world need the wheel. Reads never do: watching must
# not require taking control, or a second pair of eyes becomes an outage.
MUTATING = {"tap", "type", "key", "open", "play", "media", "msg", "reply",
            "say", "photo", "torch", "notify", "clip", "swipe", "scroll",
            "scan"}
# ...and the verb's NAME is only where the question starts; mutates() below
# answers it from the parsed arguments. `scan` without `--tap` scrolls, which
# moves the screen, but it does not commit anything, and a second pair of
# eyes must be able to look around without taking the wheel out of the
# driver's hands. With `--tap` it taps, and is gated like `tap`.


def mutates(verb, args=None):
    """Does THIS invocation change the world?

    Decided from what was asked, not from the verb's name alone. By name,
    acts hid behind flags and reads were refused for sharing a name with an
    act: `scan --tap` went through a display someone else held while a bare
    `tap` there was refused, and `media --current` (even a parse of a local
    file with --from) and `clip get` were refused with exit 5 under another
    driver's lease.
    """
    if verb not in MUTATING:
        return False

    def opt(name):
        return getattr(args, name, None)

    if verb == "scan":
        return bool(opt("tap"))
    if verb == "media":
        return opt("action") not in (None, "status")
    if verb == "clip":
        return opt("action") == "set"
    if verb == "reply":
        return not opt("list")
    # A form that only prints what it would do acts on nothing.
    return not (opt("print_only") or opt("print_url") or opt("dry_run"))


def lease_call(args, timeout=15):
    """Talk to the lease held inside shelld. None if there is no daemon."""
    return shelld_call(LEASE_CTL + args, timeout=timeout)


def foreign_holder(did):
    """Who holds display `did`, when that is somebody other than us.

    None when it is free, held by us, or unarbitrated: no daemon (nothing
    to arbitrate), or PHONE_NO_LEASE, the named switch that turns the gate
    off.
    """
    if os.environ.get("PHONE_NO_LEASE"):
        return None
    r = lease_call("status %d" % did)
    if r is None:
        return None               # no daemon: nothing to arbitrate, act
    _rc, out = r
    holder, _, _rest = (out or "").strip().partition(" ")
    if holder and holder != "-" and holder != actor():
        return holder
    return None


def lease_check(verb, args=None):
    """Refuse a mutating invocation when somebody else holds the wheel."""
    if not mutates(verb, args):
        return
    holder = foreign_holder(display_id())
    if holder:
        me = actor()
        die("%s is held on display %d by %r — one driver per screen. "
            "Wait, take it with `phone %slease acquire --as %s`, or work on "
            "a display of your own (`phone display create`)."
            % (verb, display_id(), holder,
               "--display %d " % display_id() if display_id() else "",
               me if _HOLDER_RE.match(me) else "<name>"), 5)


def refuse_held(did, what):
    """Exit 5 when another actor holds display `did`. For the verbs that
    act on a display they NAME rather than on --display: `display rm` and
    `display move`."""
    holder = foreign_holder(did)
    if holder:
        die("display %d is held by %r, so %s is refused. It is theirs until "
            "they release it or the lease runs out (`phone --display %d "
            "lease status`)." % (did, holder, what, did), 5)


def cmd_lease(args):
    if args.action == "status":
        r = lease_call("status %d" % display_id())
        if r is None:
            print("(no daemon; nothing holds the phone)")
            return 0
        out = (r[1] or "").strip()
        holder = out.split(" ")[0] if out else "-"
        print("free" if holder in ("", "-") else out)
        return 0
    who = lease_holder(args.holder or actor())
    if args.action == "acquire":
        r = lease_call("acquire %s %d %d" % (who, args.ttl, display_id()))
        if r is None:
            die("no daemon to hold a lease (start `phone shelld --start`)", 3)
        rc, out = r
        if rc != 0:
            die("held by %s" % (out or "").strip(), 5)
        record("lease", {"holder": who, "ttl": args.ttl,
                         "display": display_id()}, "act", "acquired")
        print("acquired by %s (display %d)" % (who, display_id()))
        return 0
    r = lease_call("release %s %d" % (who, display_id()))
    if r is None:
        die("no daemon", 3)
    rc, out = r
    if rc != 0:
        die("not yours to release (%s)" % (out or "").strip(), 5)
    record("lease", {"holder": who}, "act", "released")
    print("released")
    return 0



# ----------------------------------------------------------- the displays
# A phone has one screen, which is why `phone` has a lease: two drivers on one
# screen is one agent typing into another agent's chat. A VIRTUAL DISPLAY is
# the way out of that — not a bigger screen, a SECOND one, with its own
# resumed activity, its own focus, and its own input stream.
#
# It costs a process. A VirtualDisplay is owned by whoever created it and is
# released when that process exits, so android/vdisplay is a HOLDER: it makes
# the display, prints its id, and idles until told to stop.
#
# The display has to be TRUSTED or it is not worth making — an untrusted one
# gets no IME, no own focus and no system decorations, all stripped silently
# by DisplayManagerService. TRUSTED needs ADD_TRUSTED_DISPLAY, which is
# signature|role and so ungrantable: `pm grant` refuses it outright. But
# com.android.shell HOLDS it (packages/Shell/AndroidManifest.xml, and it has
# since Android 13), and `phone sh` is already uid 2000 through Shizuku — so
# the holder runs under app_process at exactly the uid that has the
# permission, and the whole question disappears. Same mechanism scrcpy uses
# for --new-display. Verified on a reference device 2026-08-30: a Pixel 10,
# Android 16 (sdk 36).
#
# WHAT IS NOT VIRTUALISED: the apps. One WhatsApp process, one logged-in
# account, one notification stream, however many displays point at it. The
# same app on two displays is two agents in one conversation — the failure
# the lease exists to prevent, reached by another road. See guard_one_display.

VD_JAR = "/data/local/tmp/parallel-root-vdisplay.jar"
VD_MAIN = "parallelroot.vdisplay.Main"
VD_CLIENT = "parallelroot.vdisplay.Client"
VD_PREFIX = "pr-vd-"

# The display every screen-tier verb addresses, set once from --display in
# main(). A module global rather than a parameter because the value has to
# reach the handful of places that BUILD a device command, and threading it
# there by hand would touch every signature in between that only ever passes
# a tree around.
_DISPLAY = [0]


def display_id():
    return _DISPLAY[0]


def _dflag():
    """The `input` display selector, or nothing on the built-in screen.

    `-d`, not `--display`: that is the flag `input` has taken since Android
    10, and it rejects the long form. Empty rather than an explicit `-d 0` so
    that every command this file issued before displays existed is still
    byte-identical when nobody asks for a second screen.
    """
    d = display_id()
    return " -d %d" % d if d else ""


def _amflag():
    """The `am start` display selector. Here it IS the long form."""
    d = display_id()
    return " --display %d" % d if d else ""


def _wmflag():
    d = display_id()
    return " -d %d" % d if d else ""


def vd_run(cls, rest, timeout=60):
    """Run a class out of the holder jar, at shell uid."""
    return dev_shell("CLASSPATH=%s app_process / %s %s" % (VD_JAR, cls, rest),
                     timeout=timeout)


def vd_client(sock, cmd, timeout=60):
    """Ask a running holder something.

    Through app_process rather than over ssh, because of a uid boundary: the
    holder's socket is in the abstract namespace and owned by shell, and
    SELinux refuses a connection from the Termux app (measured: EACCES). The
    ssh path that serves every other termux verb is on the wrong side of it.
    """
    import shlex as _sh
    return vd_run(VD_CLIENT, "%s %s" % (_sh.quote(sock), _sh.quote(cmd)),
                  timeout=timeout)


_DISP_HEAD = re.compile(r"Display id (\d+):")
_ACT_REC = re.compile(r"ActivityRecord\{\S+ u\d+ ([A-Za-z0-9_.]+)/")


def displays():
    """Every display this phone has, asked of the phone.

    No registry file, deliberately. Which displays exist is a fact about the
    device, and a file that disagrees is the stale map this codebase already
    decided not to keep (the phone map: ask, do not assume). The holders
    are named, so their names are the only bookkeeping there is.
    """
    rc, out = dev_shell("cmd display get-displays", timeout=30)
    if rc != 0 or not out:
        return []
    marks = list(_DISP_HEAD.finditer(out))
    res = []
    for i, m in enumerate(marks):
        end = marks[i + 1].start() if i + 1 < len(marks) else len(out)
        seg = out[m.start():end]
        name = re.search(r'DisplayInfo\{"([^"]*)"', seg)
        size = re.search(r"real (\d+) x (\d+)", seg)
        dens = re.search(r"density (\d+)", seg)
        kind = re.search(r"\btype ([A-Z_]+)", seg)
        res.append({
            "id": int(m.group(1)),
            "name": name.group(1) if name else "",
            "w": int(size.group(1)) if size else 0,
            "h": int(size.group(2)) if size else 0,
            "dpi": int(dens.group(1)) if dens else 0,
            "type": kind.group(1) if kind else "?",
            "trusted": "FLAG_TRUSTED" in seg,
            "ours": (name.group(1) if name else "").startswith(VD_PREFIX),
        })
    return res


def display_packages():
    """display id -> packages with a task there, topmost first.

    Reduced ON THE DEVICE. `dumpsys activity activities` runs to ~100 KB on
    a reference device and exactly two line shapes in it matter; shipping
    the rest back is the large read this file already keeps a checksum for,
    paid for nothing.
    """
    rc, out = dev_shell(
        "dumpsys activity activities 2>/dev/null | "
        "grep -E '^Display #|ActivityRecord'", timeout=45)
    if rc != 0 or not out:
        return {}
    res, cur = {}, None
    for line in out.splitlines():
        m = re.match(r"Display #(\d+)", line.strip())
        if m:
            cur = int(m.group(1))
            res.setdefault(cur, [])
            continue
        if cur is None:
            continue
        a = _ACT_REC.search(line)
        if a and a.group(1) not in res[cur]:
            res[cur].append(a.group(1))
    return res


def package_display(pkg, tasks=None):
    """Which display already hosts a package, or None."""
    tasks = display_packages() if tasks is None else tasks
    for d, pkgs in tasks.items():
        if pkg in pkgs:
            return d
    return None


def guard_one_display(pkg, target=None):
    """Refuse to put an app on a second display. THE invariant here.

    A virtual display multiplies screens; it does not multiply apps. There is
    one process, one logged-in account and one notification stream behind a
    package no matter how many displays are pointed at it — so the same app
    on two displays is two drivers in one conversation, which is precisely
    what the lease exists to prevent, arrived at from a direction the lease
    cannot see. Cheaper to make it impossible than to detect it afterwards.

    PHONE_NO_DISPLAY_GUARD exists for the same reason PHONE_NO_LEASE does:
    a deliberate override is better than a workaround somebody invents.
    """
    if os.environ.get("PHONE_NO_DISPLAY_GUARD"):
        return
    target = display_id() if target is None else target
    where = package_display(pkg)
    if where is not None and where != target:
        die("%s is already open on display %d — one app, one display. "
            "Either drive it there (`phone --display %d ...`), or close it "
            "first (`phone --display %d key back`)."
            % (pkg, where, where, where), 5)


def resumed_probe():
    """The device command that says what is in front — ON OUR DISPLAY.

    `dumpsys activity activities | grep -m1 ResumedActivity` was exactly
    right while a phone had one display: the first match in the dump was the
    only one there was. With several, dumpsys prints a section per display
    and the first match is whichever section it printed first — so a launch
    on display 4 gets verified against display 0, and an app sitting there
    perfectly is reported as "did not open". Which is worse than it sounds:
    cmd_msg gates SENDING on this check.
    """
    # Display 0 is scoped too, and that is not symmetry for its own sake:
    # dumpsys prints VIRTUAL displays before the built-in one, so the bare
    # `grep -m1` stopped meaning "display 0" the moment a virtual display
    # existed. Measured: with a clock on display 5, `phone foreground`
    # reported the clock as the phone's foreground app while the person was
    # looking at their launcher.
    #
    # Android 17 changed the shape (SDK 37, measured on the reference device
    # 2026-10-05). A display's own section no longer carries an
    # mResumedActivity line; it ends with "Resumed activities in task display
    # areas" and a "Resumed: ActivityRecord{...}" line. After the LAST
    # section comes one global "ResumedActivity:" line naming the top resumed
    # activity across EVERY display. So the old `grep ResumedActivity` found
    # nothing in a virtual display's section — every launch there read as
    # "did not come to the foreground" while the app sat there, resumed — and
    # on display 0, printed last, it ran on into the global line and could
    # name an agent's app as the person's. The section now stops at that
    # global line and at any top-level heading, and either per-display shape
    # is accepted.
    return ("dumpsys activity activities | "
            "awk '/^Display #%d /{on=1;next} /^[^ ]/{on=0} "
            "/^  ResumedActivity:/{on=0} on' | "
            "grep -m1 -E '(Resumed|mResumedActivity): ActivityRecord'"
            % display_id())


_FRONT_RE = re.compile(
    r"ActivityRecord\{\S+ u\d+ ([A-Za-z0-9_.]+/[A-Za-z0-9_.$]+)")


def foreground_of(out):
    """The package/activity a resumed_probe() reply names, or "(unknown)".

    Read out of the ActivityRecord itself, not after the label in front of
    it, because the label is the part Android renames (mResumedActivity up
    to Android 16, "Resumed:" from 17).
    """
    m = _FRONT_RE.search(out or "")
    return m.group(1) if m else "(unknown)"


def _display_by(which):
    """Find a display by id or by holder name."""
    ds = displays()
    for d in ds:
        if str(d["id"]) == str(which) or d["name"] == which:
            return d
    die("no display %r (have: %s)"
        % (which, ", ".join("%d:%s" % (d["id"], d["name"]) for d in ds)), 2)


def _display_name(display):
    d = _display_by(display)
    if d["type"] == "OVERLAY":
        die("display %s is a VISIBLE display, and those have no framebuffer "
            "of their own — Android composites them onto the built-in screen, "
            "so there is nothing to grab in isolation. Its TREE reads fine "
            "(`phone --display %s look`) and taps land in its own coordinate "
            "space; for pixels, screenshot the built-in screen (`phone "
            "screen`) and you will see it as the window it is."
            % (display, display), 4)
    if not d["ours"]:
        die("display %s is not one of ours (%r) — only a holder we started "
            "can be read or released this way" % (display, d["name"]), 2)
    return d["name"]


# The phone's sleep reaches every display. Measured on the reference device
# after its update to Android 17 (2026-10-05): a virtual display lands in
# display group 0, the person's, whatever OWN_DISPLAY_GROUP asks for, so it
# shares that group's power state. While the phone dozes, an app launched on
# an agent's display is resumed and still draws nothing: no frame for the
# holder to hand back, no window for uiautomator to dump. Waking that display
# IS waking the phone — a wake key sent to it woke the whole phone, and its
# group is group 0 — so nothing here wakes it on its own. The failure says
# why instead, and the person decides.
ASLEEP_HINT = ("the phone is asleep, and agent displays sleep with it (they "
               "share the person's power group). Wake it with `phone sh "
               "'input keyevent KEYCODE_WAKEUP'`, which turns on the "
               "person's screen, or plug it in and keep it awake while it "
               "charges (`phone sh 'svc power stayon true'`), then try again")


def phone_awake():
    """Is the phone awake? True, False, or None when it could not tell.

    Asked only on a failure path, to say WHY a read came back empty — never
    as a gate, because "could not tell" must not turn into a refusal.
    """
    rc, out = dev_shell("dumpsys power | grep -m1 'mWakefulness='",
                        timeout=20)
    m = re.search(r"mWakefulness=(\w+)", out or "")
    if rc != 0 or not m:
        return None
    return m.group(1) == "Awake"


def _vd_capture(display):
    """A PNG of a virtual display, from the holder that owns it.

    `screencap -d` cannot do this, and that is not a bug in this function.
    screencap addresses SurfaceFlinger's PHYSICAL display ids — a different
    namespace from the WM ids that `am start --display` and `input -d` speak
    — and a virtual display has no physical id at all, so the flag quietly
    hands back the built-in screen or nothing. The holder owns the Surface;
    it is the only process that can read those pixels back.
    """
    name = _display_name(display)
    # /sdcard, NOT /data/local/tmp, and that is about who can read it back.
    # A PNG cannot come home through shelld: its protocol is text with a
    # sentinel, which is the whole reason `screen` is a BINARY_VERB. /sdcard
    # is the one place the device shell can write and the Termux app can
    # read, so the bytes ride an ssh `cat` — the same hop the jar takes in
    # `android/vdisplay/build.sh install`, for the same reason.
    remote = "/sdcard/.phone/vdshot-%d-%d.png" % (os.getpid(),
                                                  int(time.time() * 1000))
    rc, out = vd_client(name, "cap %s" % remote)
    if rc != 0:
        if phone_awake() is False:
            die("display %s produced no frame: %s." % (display, ASLEEP_HINT), 4)
        die("display %s produced no frame (%s). A virtual display renders "
            "only when its content changes, so a display nothing has been "
            "launched on has never drawn."
            % (display, (out or "").strip() or "no reply"), 4)
    dev_shell("chmod 644 %s" % remote, timeout=15)
    device = os.environ.get("PHONE_DEVICE")
    if device:
        if not _DEV_RE.match(device):
            die("bad device name %r" % device, 2)
        pr = subprocess.run(["ssh", "-o", "BatchMode=yes",
                             "-o", "ConnectTimeout=8", device,
                             "cat %s" % remote],
                            capture_output=True, timeout=120)
        data = pr.stdout if pr.returncode == 0 else b""
    else:
        data = dev_read(remote, want_bytes=True)
    dev_shell("rm -f %s" % remote, timeout=15)
    if data and not data.startswith(PNG_MAGIC):
        die("display %s returned %d bytes that are not a PNG — the read did "
            "not survive the trip" % (display, len(data)), 4)
    return data


def display_filter(remote, d):
    """Cut ONE display's section out of a --windows dump, on the device.

    Not a nicety — a correctness fix. A --windows dump of a reference device
    with two extra displays measured 121 KB, and the checked read failed four
    attempts running: the large-read corruption documented in the phone
    skill's map (plugin/skills/phone/map.md), which starts around 8 KB and
    does not improve with size. Shipping only the section that was asked for
    is both a smaller read AND the only one whose size does not grow with how
    many OTHER displays happen to exist.

    sed, not awk: the dump is a single line, so this is substring surgery
    rather than line work, and sed's leftmost-longest rule does exactly the
    right thing at both ends — a greedy `.*` before the open tag consumes
    everything up to it, and `</display>.*` matches from the FIRST close tag
    to the end of the line.
    """
    return ("{ printf '<displays>'; "
            "sed -e 's|.*<display id=\"%d\">|<display id=\"%d\">|' "
            "-e 's|</display>.*|</display>|' %s; "
            "printf '</displays>'; }" % (d, d, remote))


def _hierarchy_for_display(text, display):
    """One display's windows, merged into a single <hierarchy>.

    `uiautomator dump --windows` answers with <displays><display id=N><window>
    and a <hierarchy> per window — and it lists windows TOP-FIRST: the status
    bar (layer 1) arrives before the application window (layer 0). Every
    reader below this line assumes the opposite, because inside a view
    hierarchy a LATER sibling is drawn on top, and that is what
    topmost_clickable_at resolves occlusion with. Merging in document order
    would therefore tell the tap resolver that the status bar is UNDERNEATH
    the app, and the first thing to break would be a tap near the top of the
    screen silently landing on the wrong thing.

    So the windows go out bottom-first: by layer ascending where every window
    declares one, and reversed document order where they do not.
    """
    if "<displays" not in (text or "")[:200]:
        return text                     # a plain single-display dump
    root = ET.fromstring(text)
    if root.tag != "displays":
        return text
    want = str(display)
    target = None
    for d in root.findall("display"):
        if (d.get("id") or "") == want:
            target = d
            break
    if target is None:
        die("display %s is not in the dump — it may have been released while "
            "this was running" % want, 4)
    wins = target.findall("window")

    def layer(w):
        try:
            return int(w.get("layer"))
        except (TypeError, ValueError):
            return None

    if wins and all(layer(w) is not None for w in wins):
        wins = sorted(wins, key=layer)
    else:
        wins = list(reversed(wins))
    parts, rotation = [], "0"
    for w in wins:
        h = w.find("hierarchy")
        if h is None:
            continue
        rotation = h.get("rotation") or rotation
        for child in list(h):
            parts.append(ET.tostring(child, encoding="unicode"))
    if not parts:
        die("display %s has no windows to read" % want, 4)
    return '<hierarchy rotation="%s">%s</hierarchy>' % (rotation,
                                                        "".join(parts))


OVERLAY_SETTING = "overlay_display_devices"


def overlay_specs():
    """The overlay displays Android is currently asked to make.

    Separated by `;`, not `,` — verified on the device, because `,` is what
    separates a display's FLAGS (`1080x2400/420,own_content_only`) and the
    two are easy to confuse from the docs alone.
    """
    rc, out = dev_shell("settings get global %s" % OVERLAY_SETTING, timeout=20)
    raw = (out or "").strip()
    if rc != 0 or not raw or raw == "null":
        return []
    return [x for x in (p.strip() for p in raw.split(";")) if x]


def write_overlay_specs(specs):
    val = ";".join(specs)
    return dev_shell("settings put global %s %s"
                     % (OVERLAY_SETTING, val if val else "null"), timeout=20)


VD_NAME_TRIES = 5


def _vd_start(name, w, h, dpi):
    """Start a holder called `name`. Its display id, or None when another
    holder already answers to that name (the caller tries the next one).

    Dies on anything else, including a display that came up whose holder
    then does not answer to its name: that is not a clash to retry past, it
    is a display nobody can be sure of, and the caller is told its id.
    """
    # A log path of this call's OWN. Named after the display alone, two
    # creates that chose the same name shared it, and the second one's
    # `rm -f` could delete the file the first was about to read its id
    # from. It is removed once read: the holder keeps writing to it
    # unlinked, and nothing reads it afterwards, so a log per create would
    # otherwise pile up on the phone.
    log = "/data/local/tmp/%s-%d-%d.log" % (name, os.getpid(),
                                            int(time.time() * 1000))
    # setsid, and it is load-bearing. shelld kills its shell's whole
    # PROCESS GROUP on a deadline and on shutdown, and a holder started
    # with a bare `&` is in that group — so the display would vanish the
    # next time any unrelated command timed out. A new session puts it
    # out of reach of that kill.
    script = (
        "rm -f {log}; "
        "CLASSPATH={jar} setsid app_process / {main} "
        "--size {w}x{h} --dpi {dpi} --name {name} --socket {name} "
        "> {log} 2>&1 < /dev/null & "
        "i=0; while [ $i -lt 80 ]; do [ -s {log} ] && break; "
        "sleep 0.25; i=$((i+1)); done; cat {log}; rm -f {log}"
    ).format(log=log, jar=VD_JAR, main=VD_MAIN, w=w, h=h, dpi=dpi,
             name=name)
    _rc, out = dev_shell(script, timeout=90)
    got = re.search(r"^display (\d+)$", out or "", re.M)
    if not got:
        # The holder claims its socket name BEFORE it makes a display, so a
        # name another holder answers to fails here with nothing created.
        if "already in use" in (out or "").lower():
            return None
        die("the holder did not come up:\n%s"
            % ((out or "").strip() or "(nothing on stdout or stderr)"), 4)
    did = int(got.group(1))
    # An id on stdout is not yet a display anyone can use. A holder built
    # before it claimed its name first makes the display, prints the id, and
    # only then finds the name taken — and its exit takes that display with
    # it. So the id is confirmed by asking the holder that answers to the
    # name: it is ours only if that holder reports the same display.
    rc, info = vd_client(name, "info")
    im = re.match(r"(\d+) ", (info or "").strip())
    if rc == 0 and im:
        return did if int(im.group(1)) == did else None
    die("display %d came up, but no holder answers to %s (%s), so it is "
        "not certain the display is still there — check `phone display ls`"
        % (did, name, (info or "").strip() or "no reply"), 4)


def cmd_display(args):
    need_shell()
    if args.action == "ls":
        tasks = display_packages()
        for d in displays():
            apps = [p for p in tasks.get(d["id"], [])
                    if p != "com.android.systemui"]
            print("%-3d %-12s %5dx%-5d dpi %-4s %-9s %s%s"
                  % (d["id"], d["name"][:12] or "-", d["w"], d["h"],
                     d["dpi"] or "?", d["type"].lower(),
                     "" if d["trusted"] else "untrusted ",
                     ", ".join(apps[:3]) if apps else "-"))
        return 0

    if args.action == "create" and args.visible:
        # A display the PERSON can see. Not a virtual display at all — an
        # OVERLAY display, which Android renders as a floating window on the
        # built-in screen. That makes it the opposite trade from `create`:
        # visible and in the way, rather than invisible and out of it.
        #
        # It is a real display, not a mirror: it has its own launcher, its
        # own resumed activity, and `look`/`tap` reach it (measured — four
        # taps on a calculator there produced 7789). Use it to SHOW work, not
        # to hide it.
        phys = [d for d in displays() if d["id"] == 0]
        m = re.match(r"^(\d+)x(\d+)$", args.size or "")
        if args.size and not m:
            die("--size wants WxH, e.g. 1080x2400", 2)
        w = int(m.group(1)) if m else (phys[0]["w"] if phys else 1080)
        h = int(m.group(2)) if m else (phys[0]["h"] if phys else 2400)
        dpi = args.dpi or (phys[0]["dpi"] if phys else 420)
        existing = [d for d in displays() if d["type"] == "OVERLAY"]
        # Adding an entry rewrites the one setting every overlay display
        # lives in, and Android re-creates them all on any change to it (see
        # `rm --all`), so an overlay somebody else holds is touched too.
        for o in existing:
            refuse_held(o["id"], "adding a visible display, which re-creates "
                        "it,")
        before = {d["id"] for d in existing}
        specs = overlay_specs()
        specs.append("%dx%d/%d" % (w, h, dpi))
        write_overlay_specs(specs)
        for _ in range(20):
            time.sleep(0.5)
            now = [d for d in displays() if d["type"] == "OVERLAY"]
            fresh = [d for d in now if d["id"] not in before]
            if fresh:
                record("display", {"action": "create", "kind": "overlay",
                                   "size": "%dx%d" % (w, h)}, "act",
                       "display %d" % fresh[0]["id"])
                print(fresh[0]["id"])
                return 0
        write_overlay_specs(overlay_specs()[:-1])
        die("the overlay display never appeared", 4)

    if args.action == "create":
        rc, out = dev_shell("ls %s 2>/dev/null" % VD_JAR, timeout=20)
        if rc != 0 or not (out or "").strip():
            die("no display holder on this phone. Build and stage it from a "
                "checkout: PHONE_DEVICE=<phone> android/vdisplay/build.sh "
                "install", 3)
        m = re.match(r"^(\d+)x(\d+)$", args.size or "")
        if args.size and not m:
            die("--size wants WxH, e.g. 1080x2400", 2)
        base = displays()
        phys = [d for d in base if d["id"] == 0]
        w = int(m.group(1)) if m else (phys[0]["w"] if phys else 1080)
        h = int(m.group(2)) if m else (phys[0]["h"] if phys else 2400)
        dpi = args.dpi or (phys[0]["dpi"] if phys else 420)
        # The name is chosen from a read made BEFORE the launch, in another
        # round trip, so two creates that overlap — two lanes, or one lane
        # interleaving — can both choose the same free pr-vd-N. A clash is
        # therefore an expected outcome of choosing, not a failure: the next
        # free name is tried. The clashed name is remembered here as well as
        # re-read, because the holder that won it may not have made its
        # display yet, and then the phone does not list it.
        taken = {d["name"] for d in base}
        for _ in range(VD_NAME_TRIES):
            n = 1
            while "%s%d" % (VD_PREFIX, n) in taken:
                n += 1
            name = "%s%d" % (VD_PREFIX, n)
            did = _vd_start(name, w, h, dpi)
            if did is not None:
                record("display", {"action": "create", "name": name,
                                   "size": "%dx%d" % (w, h), "dpi": dpi},
                       "act", "display %d" % did)
                print(did)
                return 0
            taken.add(name)
            taken |= {d["name"] for d in displays()}
        die("no free holder name after %d tries: each %s name chosen was "
            "taken by another holder before this one could claim it"
            % (VD_NAME_TRIES, VD_PREFIX), 4)

    if args.action == "move":
        if not args.which:
            die("move what? (an app name or package)", 2)
        pkg = pkg_of(args.which) or args.which
        if not package_present(pkg):
            die("%s is not installed on this device" % args.which, 4)
        to = args.to if args.to is not None else display_id()
        ds = {d["id"] for d in displays()}
        if to not in ds:
            die("no display %d (have: %s)"
                % (to, ", ".join(str(x) for x in sorted(ds))), 2)
        where = package_display(pkg)
        if where == to:
            print("%s is already on display %d" % (pkg, to))
            return 0
        # Both ends are somebody's screen. A move takes the app out from
        # under whoever drives the display it leaves, and lands it in front
        # of whoever holds the one it goes to. The --display gate in main()
        # cannot see either: they are named here, not there.
        if where is not None:
            refuse_held(where, "moving %s off it" % pkg)
        refuse_held(to, "moving %s onto it" % pkg)
        rc, out = dev_shell(
            "cmd package resolve-activity --brief -c "
            "android.intent.category.LAUNCHER %s | tail -1" % pkg, timeout=30)
        comp = (out or "").strip().splitlines()[-1].strip() if out else ""
        if rc != 0 or "/" not in comp:
            die("could not resolve a launcher activity for %s" % pkg, 4)
        # This is the SAME `am start --display` that `open` refuses to do
        # implicitly. It is allowed here because moving is what the caller
        # asked for: the task goes to the new display and leaves the old one,
        # which is the only behaviour Android offers. Naming it is the
        # difference between a move and an accident.
        dev_shell("am start --display %d -n %s" % (to, comp), timeout=30)
        landed = False
        for _ in range(10):
            time.sleep(0.5)
            if package_display(pkg) == to:
                landed = True
                break
        record("display", {"action": "move", "pkg": pkg, "from": where,
                           "to": to}, "act",
               "moved" if landed else "did not move")
        if not landed:
            die("%s did not move to display %d (it may refuse a secondary "
                "display)" % (pkg, to), 4)
        print("%s: display %s -> %d"
              % (pkg, "?" if where is None else where, to))
        return 0

    if args.action == "rm":
        if args.all:
            # A display somebody else holds is theirs, even under --all.
            # Releasing it takes their apps with it (the holder sets
            # DESTROY_CONTENT_ON_REMOVAL): the failure the lease exists to
            # prevent, reached through a verb that never asked about one.
            ds = displays()
            held = {}
            for d in ds:
                if d["ours"] or d["type"] == "OVERLAY":
                    who = foreign_holder(d["id"])
                    if who:
                        held[d["id"]] = who
            # Overlays go too: --all means "put the phone back", and an
            # overlay left behind is a window sitting on the person's screen.
            # They are entries in ONE setting, and Android answers any
            # change to it by dismissing every overlay display and creating
            # those still listed afresh (OverlayDisplayAdapter, in AOSP) —
            # so keeping a held one's entry would not keep its display, and
            # while one is held they all stay.
            ov = [d for d in ds if d["type"] == "OVERLAY"]
            busy = [d for d in ov if d["id"] in held]
            if busy:
                print("left every overlay display: they are one setting, "
                      "and %s" % ", ".join("%d is held by %r"
                                           % (d["id"], held[d["id"]])
                                           for d in busy))
            elif ov:
                write_overlay_specs([])
                print("released every overlay display")
            ours = [d for d in ds if d["ours"]]
            if not ours:
                print("no displays of ours to release")
                return 0
            for d in ours:
                if d["id"] in held:
                    print("left %d (%s): held by %r"
                          % (d["id"], d["name"], held[d["id"]]))
                    continue
                vd_client(d["name"], "bye")
                record("display", {"action": "rm", "name": d["name"]}, "act",
                       "released %d" % d["id"])
                print("released %d (%s)" % (d["id"], d["name"]))
            return 0
        if not args.which:
            die("which display? (an id, a name, or --all)", 2)
        d = _display_by(args.which)
        if d["type"] == "OVERLAY":
            # An overlay is a line in a settings string, not a process. Its
            # NAME carries its position — "Overlay #2" is the second entry —
            # which is the only handle Android gives back.
            n = re.search(r"#(\d+)", d["name"] or "")
            specs = overlay_specs()
            i = int(n.group(1)) - 1 if n else -1
            if not n or i < 0 or i >= len(specs):
                die("cannot place %r among the %d overlay entries"
                    % (d["name"], len(specs)), 4)
            refuse_held(d["id"], "releasing it")
            # Rewriting the setting dismisses EVERY overlay display and
            # creates the rest afresh (see --all above), so the others are
            # touched too, and one somebody else holds is not ours to touch.
            for o in displays():
                if o["type"] == "OVERLAY" and o["id"] != d["id"]:
                    refuse_held(o["id"], "releasing overlay %d, which "
                                "re-creates it," % d["id"])
            del specs[i]
            write_overlay_specs(specs)
            record("display", {"action": "rm", "kind": "overlay",
                               "name": d["name"]}, "act",
                   "released %d" % d["id"])
            print("released %d (%s)" % (d["id"], d["name"]))
            return 0
        if not d["ours"]:
            die("display %d is %r, not a holder we started — refusing"
                % (d["id"], d["name"]), 2)
        refuse_held(d["id"], "releasing it")
        rc, out = vd_client(d["name"], "bye")
        if rc != 0:
            die("the holder for display %d did not answer (%s). It may have "
                "died already; check `phone display ls`."
                % (d["id"], (out or "").strip()), 4)
        record("display", {"action": "rm", "name": d["name"]}, "act",
               "released %d" % d["id"])
        print("released %d (%s)" % (d["id"], d["name"]))
        return 0

    die("unknown display action %r" % args.action, 2)


# ------------------------------------------------------- driving from afar
# The controller belongs OFF the phone: an agent running on the phone itself
# gets a phone CPU, may have no current build for Android at all, and Android
# keeps reaping its session. A controller on a real machine gets a current
# model and stays alive.
#
# What makes that practical is not ssh-per-verb — Termux's sshd forks a shell
# for every command, ~0.45s, and no amount of connection multiplexing touches
# it (measured with a verified master). It is forwarding shelld's unix socket:
# the far sshd then never forks anything, it just hands bytes to a process
# that is already running. Measured 0.449s -> 0.066s for the same round trip.
#
# With PHONE_SHELL_SOCK pointed at the forward, every verb in this file works
# unchanged from another machine. That is the whole trick.


# Verbs that are Termux's own, not the device shell's. The forwarded socket
# runs commands at SHELL uid, and Termux's binaries live in an app-private
# prefix that shell uid cannot read — so these cannot ride the fast path at
# all. They run AS THE APP, on the device, over ssh. Slower (Termux's sshd
# forks a shell, ~0.45s) and correct, which is the right trade: a --device
# that silently covered only half the verbs would look like a broken phone.
TERMUX_VERBS = {"say", "listen", "notifs", "notify", "battery", "torch",
                "where", "clip", "photo", "watchdog"}

# Verbs that address a device but need no shell on it. `log` reads ledger
# files — one here, one fetched over ssh — so forwarding a socket for it is
# pure cost, and worse: a failure to forward would suppress the local half
# of a trace that reads fine on its own.
#
# `ask` needs the phone's shell only for the fast handlers that read it, and
# its router may need no phone at all. Forwarded up front, a phone that was
# away ended a question only the router needed with exit 3, which `ask` does
# not have. So the handler that needs the shell stands the link up itself
# (_fast_shell), and a phone that is away costs the fast tier, not the
# answer.
NO_LINK_VERBS = {"log", "ask"}

# Verbs whose RESULT is binary. The forwarded socket cannot carry them:
# shelld speaks a text protocol with a sentinel, so dev_shell skips it for
# bytes, and on a controller there is no rish and no adb-attached device
# either. So `screen` came back empty and died with "screen off or secure
# surface" — blaming the phone for a hop it could never have crossed, in the
# one verb the skill tells an agent to reach for when the UI tree fails.
#
# They run ON the device, writing to ITS stdout, and the bytes are streamed
# home. Same trade as the termux verbs: an ssh fork per call, for a
# capability that otherwise does not exist at all.
BINARY_VERBS = {"screen"}
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"


def remote_bin():
    """What this CLI is called on the far side of a hop.

    $PHONE_REMOTE_BIN, else `phone`. A phone can carry more than one copy of
    this file — a second install beside an older one — and a controller has
    to be able to say which of them it means. One word: a command on the
    phone's PATH or an absolute path, quoted as a single word wherever it is
    used, so nothing in it is ever re-parsed by the far shell.
    """
    return (os.environ.get("PHONE_REMOTE_BIN") or "").strip() or "phone"


def remote_exec(device, argv_rest):
    """Run `$PHONE_REMOTE_BIN <verb> ...` on the device itself, as the Termux
    app."""
    import shlex as _sh
    if not _DEV_RE.match(device or ""):
        die("bad device name %r" % device, 2)
    # The actor has to be carried EXPLICITLY. These verbs run on the device,
    # so it is the device's `phone` that writes the ledger line — and
    # PHONE_ACTOR is an environment variable here, on the controller, which
    # ssh does not forward (and SendEnv would need sshd's cooperation).
    # Without this, every notifs/clip/where/photo/listen driven from a
    # controller logs as "anon": the reads of personal data, which are
    # precisely the ones the record exists to attribute.
    #
    # Only when one is actually set. A bare PHONE_ACTOR= would override
    # whatever the device would otherwise have said with an empty string.
    # The display travels WITH the verb. main() strips --display before the
    # subparser sees it, so a remote hop that did not put it back would run
    # `screen` or `say` against display 0 while the caller believed it was
    # addressing their own.
    head = [remote_bin()]
    if display_id():
        head += ["--display", str(display_id())]
    remote = " ".join(_sh.quote(w) for w in (head + argv_rest))
    # A remote hop is the LAST hop. If the device's own environment names a
    # device — a two-phone fleet, a stray export in a profile — the far
    # `phone` would hop onward, and every row it returned would still be
    # labelled with THIS device's name, because that is the only name the
    # caller has. The origin column would then attribute a third machine's
    # actions to the phone in your hand. Cheaper to make the far side
    # incapable of hopping than to teach the labelling about hops it cannot
    # see.
    remote = "PHONE_DEVICE= " + remote
    # ...and it lands where the CALLER aimed it. The phone reads its own
    # config file, and a PHONE_LANE, PHONE_SHELL_SOCK or PHONE_DISPLAY set
    # there would quietly retarget the hop: the lease checked against some
    # lane's daemon instead of the shared arbiter, so a held display stops
    # refusing anyone, or a display-0 verb acting on display 5. An empty value
    # beats the file (the environment always wins) and reads as the default to
    # any build, older ones included; a display the caller did name travels
    # as --display above, which beats the empty one. PHONE_NO_LEASE and
    # PHONE_NO_DISPLAY_GUARD are left alone on purpose: they are named
    # switches, and whoever set one in the phone's file chose it for every
    # driver of that phone.
    remote = "PHONE_LANE= PHONE_SHELL_SOCK= PHONE_DISPLAY= " + remote
    who = os.environ.get("PHONE_ACTOR")
    if who:
        # Quote the VALUE only. Quoting the whole word — shlex.quote of
        # "PHONE_ACTOR=a; rm" gives "'PHONE_ACTOR=a; rm'" — stops being an
        # assignment at all: a word whose name part is quoted is a command
        # NAME to the shell, so the far side would hunt for a binary with
        # that name and never run phone. Safe, and silently broken.
        remote = "PHONE_ACTOR=%s %s" % (_sh.quote(who), remote)
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
            "-o", "StrictHostKeyChecking=accept-new", device, remote]


REMOTE_SOCK = "/data/data/com.termux/files/usr/tmp/phone-shell.sock"
_DEV_RE = re.compile(r"\A[a-z0-9][a-z0-9._-]{0,62}\Z")


def link_argv(device, local_sock):
    """The exact command that forwards a device's shelld socket here."""
    if not _DEV_RE.match(device or ""):
        die("bad device name %r" % device, 2)
    return [
        "ssh",
        # NOT the mux. Asking an existing master to add a stream-local
        # forward is accepted and then silently never created, and `-f -N -L`
        # attaches to the master instead of opening one. A dedicated
        # connection is what actually produces the socket.
        "-o", "ControlMaster=no",
        "-o", "ControlPath=none",
        "-o", "BatchMode=yes",
        "-o", "ExitOnForwardFailure=yes",
        "-o", "ServerAliveInterval=20",
        "-o", "StreamLocalBindUnlink=yes",
        "-f", "-N",
        "-L", "%s:%s" % (local_sock, _laned(REMOTE_SOCK)),
        device,
    ]


def local_sock_for(device):
    """Where a device's shell appears on THIS machine.

    Laned as well as per-device. It was per-device only, and ensure_link
    unlinks this path when its probe fails — so a second driver bringing up
    its own forward would delete the first driver's live socket and the first
    driver would simply stop being able to reach the phone.
    """
    return _laned(os.path.join(
        os.environ.get("TMPDIR", "/tmp").rstrip("/"),
        "phone-%s.sock" % re.sub(r"[^a-z0-9]+", "-", device.lower())))


def ensure_link(device):
    """Point this process at a remote phone, bringing the forward up if it is
    not already answering. Returns the local socket path."""
    sock = local_sock_for(device)
    os.environ["PHONE_SHELL_SOCK"] = sock
    probe = shelld_call("true", timeout=6)
    if probe is not None and probe[0] == 0:
        return sock                      # already forwarded and answering
    try:
        os.unlink(sock)
    except OSError:
        pass
    def forward_and_probe():
        rc, _out = run(link_argv(device, sock), timeout=30)
        if rc != 0:
            return False
        for _ in range(20):
            p = shelld_call("true", timeout=6)
            if p is not None and p[0] == 0:
                return True
            time.sleep(0.4)
        return False

    if forward_and_probe():
        return sock
    if lane():
        # A lane's daemon is nobody's job to have started, and the failure
        # arrives LATE: `ssh -L` binds the local socket whether or not the
        # remote one exists, so rc is 0 and only the probe finds out. Hence
        # the retry hangs off the probe, not off the exit status.
        #
        # The default lane is deliberately left alone — auto-starting THAT
        # would change what every existing caller does — but a driver that
        # asked for its own shell has, by asking, said it wants one.
        import shlex as _sh
        # The far side is pinned the way remote_exec pins it, for the same
        # reasons. PHONE_SHELL_SOCK cleared: a socket named in the phone's
        # config file would put this daemon somewhere the forward never
        # looks. PHONE_DEVICE cleared: a device named there sent the start
        # onward instead — reproduced with a phone-side file naming another
        # device, the far `phone` started no lane daemon and made three ssh
        # attempts of its own. PHONE_DISPLAY cleared, as on every hop.
        run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", device,
             "PHONE_DEVICE= PHONE_DISPLAY= PHONE_SHELL_SOCK= PHONE_LANE=%s "
             "%s shelld --start"
             % (_sh.quote(lane()), _sh.quote(remote_bin()))],
            timeout=40)
        try:
            os.unlink(sock)
        except OSError:
            pass
        if forward_and_probe():
            return sock
        die("lane %r has no shell on %s. The `%s` there must be new "
            "enough to know PHONE_LANE — check `ssh %s %s --help`."
            % (lane(), device, remote_bin(), device, remote_bin()), 3)
    die("forwarded %s but its shell never answered" % device, 3)


# ---------------------------------------------------------------- UI parsing

class El(object):
    __slots__ = ("text", "desc", "rid", "cls", "clickable", "enabled",
                 "bounds", "parent", "order", "checkable", "checked",
                 "scrollable")

    def __init__(self):
        self.text = ""
        self.desc = ""
        self.rid = ""
        self.cls = ""
        self.clickable = False
        self.enabled = True
        self.bounds = (0, 0, 0, 0)
        self.parent = None
        # Position in a pre-order walk. Siblings are dumped in draw order, so
        # a HIGHER order generally means DRAWN LATER — i.e. on top. That is
        # what makes the occlusion check below possible.
        self.order = 0
        self.checkable = False
        self.checked = False
        self.scrollable = False

    def contains(self, x, y):
        x1, y1, x2, y2 = self.bounds
        return x1 <= x <= x2 and y1 <= y <= y2

    def has_ancestor(self, other):
        cur = self
        while cur is not None:
            if cur is other:
                return True
            cur = cur.parent
        return False

    @property
    def center(self):
        x1, y1, x2, y2 = self.bounds
        return ((x1 + x2) // 2, (y1 + y2) // 2)

    @property
    def label(self):
        if self.text:
            return self.text
        if self.desc:
            return "[%s]" % self.desc
        return self.rid.split("/")[-1] if self.rid else ""


_BOUNDS = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")


def parse_ui(xml_text):
    """uiautomator XML -> flat element list, each knowing its parent.

    Parents matter: in real apps the visible label is a non-clickable TextView
    inside a clickable row, so tapping the label's own center can miss the
    handler entirely. `find` walks up from a match to the nearest clickable
    ancestor.
    """
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        die("could not parse the UI tree (%s)" % e, 4)
    out = []

    def walk(node, parent):
        el = None
        if node.tag == "node":
            el = El()
            a = node.attrib
            el.text = (a.get("text") or "").strip()
            el.desc = (a.get("content-desc") or "").strip()
            el.rid = a.get("resource-id") or ""
            el.cls = a.get("class") or ""
            el.clickable = (a.get("clickable") == "true")
            el.enabled = (a.get("enabled") != "false")
            el.checkable = (a.get("checkable") == "true")
            el.checked = (a.get("checked") == "true"
                          or a.get("selected") == "true")
            el.scrollable = (a.get("scrollable") == "true")
            el.order = len(out)
            m = _BOUNDS.match(a.get("bounds") or "")
            if m:
                el.bounds = tuple(int(g) for g in m.groups())
            el.parent = parent
            out.append(el)
        for kid in list(node):
            walk(kid, el if el is not None else parent)

    walk(root, None)
    return out


def clickable_target(el):
    """The element that should actually receive the tap: el if it is
    clickable, else its nearest clickable-and-enabled ancestor."""
    cur = el
    while cur is not None:
        if cur.clickable and cur.enabled:
            return cur
        cur = cur.parent
    return None


def topmost_clickable_at(els, x, y):
    """Which element will actually RECEIVE a tap at (x, y).

    Android delivers a touch to the topmost view under the finger. uiautomator
    dumps siblings in draw order, so among the clickable elements whose bounds
    contain the point, the one with the highest `order` is the one drawn last
    and therefore on top.

    This is a heuristic, not a law — `elevation` can reorder drawing without
    reordering the tree. It is here because the alternative was measured on a
    real screen and was worse: on a shopping app's store page the floating
    cart bar sits over the item list, and the centre of one item's row is
    INSIDE it. Tapping that centre opened the cart. On an item page the "Add
    to cart" footer covers the third option row, so tapping the option would
    have ADDED THE ITEM instead of selecting it. Both were watched, not
    inferred.
    """
    best = None
    for el in els:
        if not (el.clickable and el.enabled):
            continue
        if not el.contains(x, y):
            continue
        if best is None or el.order > best.order:
            best = el
    return best


def safe_point(target, els, prefer=None):
    """A point inside `target` that a tap will actually reach.

    Returns (x, y, contested). There is ALWAYS a point — the centre, if
    nothing better exists — because refusing to act is its own failure. A
    non-None `contested` means every candidate point had a later clickable
    element over it, so the tap may land there instead: a warning, not a veto.

    It is a warning and not a veto because the "later means on top" rule is
    only mostly true. Measured on a shopping app's Compose home screen: the
    bottom navigation bar appears at tree index 16 and a promo card at index
    159, with the card's bounds swallowing the nav — yet the nav is what is
    drawn on top and what a finger hits. Compose emits semantics nodes in
    traversal order, not draw order, so on those surfaces the rule simply
    does not hold. Vetoing there would make a perfectly tappable button
    unreachable, which is a worse failure than the one this function exists
    to prevent.

    Candidates, in order: the target's own centre — which is what `find` has
    always returned and what callers and tests expect — then the centre of the
    element whose label matched, then a vertical sweep through the target's
    box. Order matters: the centre stays the answer on an ordinary screen, and
    the other two only come into play when the centre is covered. The sweep is
    what rescues a row that is half-hidden by a footer, because there is
    usually a clear band above the occluder and the label lives in it.
    """
    cands = [target.center]
    if prefer is not None and prefer.bounds != (0, 0, 0, 0):
        cx, cy = prefer.center
        if target.contains(cx, cy):
            cands.append((cx, cy))
    x1, y1, x2, y2 = target.bounds
    mx = (x1 + x2) // 2
    if y2 > y1:
        # Sweep top-down: the readable part of a partly covered row is
        # almost always its top, because footers rise from the bottom.
        step = max(8, (y2 - y1) // 12)
        yy = y1 + max(4, (y2 - y1) // 24)
        while yy < y2:
            cands.append((mx, yy))
            yy += step
    seen = set()
    blocker = None
    for (cx, cy) in cands:
        if (cx, cy) in seen:
            continue
        seen.add((cx, cy))
        top = topmost_clickable_at(els, cx, cy)
        if top is None or top is target or top.has_ancestor(target):
            return cx, cy, None
        if blocker is None:
            blocker = top
    cx, cy = target.center
    return cx, cy, blocker


def el_handle(el):
    """A short name for an element, for messages a human has to act on."""
    if el is None:
        return "?"
    if el.rid:
        return el.rid.split("/")[-1]
    lab = (el.text or el.desc or "").strip()
    if lab:
        return "%r" % lab[:30]
    return el.cls.split(".")[-1] or "?"


def get_ui(from_file=None, display=None):
    d = display_id() if display is None else display
    if from_file:
        with open(from_file, "r", encoding="utf-8", errors="replace") as f:
            return _hierarchy_for_display(f.read(), d) if d else f.read()
    need_shell()
    # uiautomator writes to a file on the device; /dev/tty streams it back.
    # A UNIQUE path per call, so a stale tree is structurally impossible.
    # `uiautomator dump` fails routinely — it waits for window idle and gives
    # up on anything animating (video, a spinner, an ad), on secure windows,
    # and with the screen off. Writing to a fixed path meant those failures
    # silently served the PREVIOUS screen, and `find` then handed out
    # coordinates for a screen that was no longer there. That is the worst
    # failure this system can have: the agent taps something real, believing
    # it saw it.
    remote = "/sdcard/.phone/ui-%d-%d.xml" % (os.getpid(),
                                              int(time.time() * 1000))
    # --windows ONLY off the built-in screen. It is the sole way to reach a
    # second display's tree — plain `uiautomator dump` has no display
    # selector and always answers for display 0 — but it also returns a
    # different document (every window, not the focused one), so using it
    # everywhere would quietly change what the existing screen tier sees.
    # Display 0 keeps the dump it has always had.
    rc, marker = dev_shell(
        "mkdir -p /sdcard/.phone && uiautomator dump %s %s && echo __DUMP_OK__"
        % ("--windows" if d else "", remote), timeout=60)
    if rc != 0 or "__DUMP_OK__" not in (marker or ""):
        if d and phone_awake() is False:
            die("could not read display %d's UI tree: %s." % (d, ASLEEP_HINT),
                4)
        die("could not read the UI tree: the dump failed (screen off, a "
            "secure window, or the screen never went idle). Nothing guessed.",
            4)
    # CHECKED, because this read is exactly where the corruption was first
    # noticed. A UI tree is 20-80 KB, which is squarely in the range where
    # large reads come back with a region substituted by earlier content —
    # right length, right rc, and still opening with <hierarchy and closing
    # with </hierarchy>, so every guard below this line passes a spliced
    # document. XML being brittle enough to fail parsing was the only reason
    # anyone noticed at all; that made the screen tier look unreliable when
    # the transport was at fault.
    #
    # Measured before this change: look/ui failed 4 of 8 on a complex screen.
    _rc, out = dev_shell_checked(
        display_filter(remote, d) if d else "cat %s" % remote, timeout=90)
    dev_shell("rm -f %s" % remote, timeout=15)
    if "<hierarchy" not in (out or ""):
        if d and phone_awake() is False:
            die("could not read display %d's UI tree: %s." % (d, ASLEEP_HINT),
                4)
        die("could not read the UI tree (the screen may be off or secure)", 4)
    if d:
        return _hierarchy_for_display(out, d)
    i = out.index("<hierarchy")
    j = out.rfind("</hierarchy>")
    return out[i:j + len("</hierarchy>")] if j > 0 else out[i:]


def cmd_ui(args):
    xml = get_ui(args.from_file)
    if getattr(args, "save", None):
        with open(args.save, "w", encoding="utf-8") as f:
            f.write(xml)
        sys.stderr.write("wrote %d bytes to %s\n" % (len(xml), args.save))
    els = parse_ui(xml)
    lines = []
    for el in els:
        lab = el.label
        if not lab:
            continue
        if args.grep and args.grep.lower() not in lab.lower():
            continue
        tgt = clickable_target(el)
        if tgt is None:
            lines.append("%-11s %s" % ("-", lab))
        else:
            x, y = tgt.center
            lines.append("%-11s %s" % ("%d,%d" % (x, y), lab))
    if not lines:
        print("(nothing readable on screen)")
        return 0
    print("\n".join(lines))
    return 0


def cmd_look(args):
    """The screen, summarised for something that pays per token.

    `ui` prints every node carrying text — on a real app that is hundreds of
    lines, mostly container ids (drag_layer, scrim_view, *_container) an
    agent can do nothing with. A model paying that on every step spends its
    context on scaffolding instead of on the task.

    So: name the app, then list only what can be ACTED ON, deduplicated, with
    coordinates included so acting needs no second call.
    """
    xml = get_ui(args.from_file)
    els = parse_ui(xml)
    app = ""
    m = re.search(r'package="([^"]+)"', xml or "")
    if m:
        app = m.group(1)
    lines = []
    seen = set()
    for el in els:
        lab = el.label
        if not lab:
            continue
        # Scaffolding: a bare resource-id with no human text is a container
        # the agent cannot meaningfully target.
        if not el.text and not el.desc:
            continue
        tgt = clickable_target(el)
        if tgt is None and not args.all:
            continue
        # One line per TARGET, not per node. An element's text and its
        # content-desc are usually two descriptions of the same tappable
        # thing, and printing both doubles the cost for no new information.
        # Prefer the human text; a [desc] only stands in when there is none.
        key = tgt.center if tgt else ("nolabel", lab)
        if key in seen:
            continue
        if args.grep and args.grep.lower() not in lab.lower():
            continue
        if el.text:
            seen.add(key)
        else:
            # Hold a desc-only entry back one beat: if a text node for the
            # same target follows, it wins.
            if any(e.text and clickable_target(e) is not None
                   and clickable_target(e).center == key
                   for e in els):
                continue
            seen.add(key)
        # Checkable state, because a settings row or an option group is
        # unreadable without it: "Small" and "Small, selected" are different
        # facts and cost the same to print.
        box = ""
        cur = el
        for _ in range(4):
            if cur is None:
                break
            if cur.checkable:
                box = "[x] " if cur.checked else "[ ] "
                break
            cur = cur.parent
        if not box and tgt is not None:
            # The checkable node is usually a SIBLING of the label, not an
            # ancestor: a shopping app's option row is a RadioButton next to
            # a TextView inside one container. Walking up alone finds nothing
            # and silently drops the one bit that matters — which option is
            # currently selected.
            if tgt.checkable:
                box = "[x] " if tgt.checked else "[ ] "
            else:
                for other in els:
                    if other.checkable and other.has_ancestor(tgt):
                        box = "[x] " if other.checked else "[ ] "
                        break
        tail = ""
        if getattr(args, "ids", False) and tgt is not None and tgt.rid:
            tail = "   #%s" % tgt.rid.split("/")[-1]
        if tgt is None:
            lines.append("           %s%s" % (box, lab))
        else:
            x, y = tgt.center
            # Warn where a tap would NOT land on what is being named. This is
            # the difference between a coordinate and a usable coordinate.
            sx, sy, occ = safe_point(tgt, els, prefer=el)
            lines.append("%-11s %s%s%s%s"
                         % ("%d,%d" % (sx, sy), box, lab, tail,
                            ("  ?under %s" % el_handle(occ)) if occ else ""))
        if args.limit and len(lines) >= args.limit:
            lines.append("           … more (use `ui` for everything)")
            break
    print("app: %s" % (app or "unknown"))
    if not lines:
        print("(nothing actionable on screen)")
        return 0
    print("\n".join(lines))
    return 0


def match_els(els, query=None, rid=None, exact=False, after=None):
    """Every element matching a query, best matches first.

    Ranked: exact text/desc, then resource-id suffix, then substring. Ranking
    matters more than it looks. On a shopping app's item page, `find` for an
    option's label matched a *card* higher up whose description happened to
    quote the same words, not the option a person meant — because the card
    came first in the tree. Substring matching makes near-misses look
    like hits, so the caller needs to be able to see the whole candidate set
    (`--all`) and to cut it down (`--after`) rather than trust position.
    """
    start = 0
    if after:
        a = after.lower()
        for el in els:
            if a in (el.text or "").lower() or a in (el.desc or "").lower():
                start = el.order
                break
        else:
            return []
    pool = [el for el in els if el.order >= start]
    if rid:
        hits = [el for el in pool if el.rid == rid or
                el.rid.split("/")[-1] == rid]
        return [(el, clickable_target(el)) for el in hits]
    if not query:
        return []
    q = query.lower()
    exact_hits, rid_hits, part_hits = [], [], []
    for el in pool:
        t, d = (el.text or "").lower(), (el.desc or "").lower()
        if t == q or d == q:
            exact_hits.append(el)
        elif el.rid and el.rid.split("/")[-1].lower() == q:
            rid_hits.append(el)
        elif not exact and (q in t or q in d):
            part_hits.append(el)
    out = []
    for el in exact_hits + rid_hits + part_hits:
        out.append((el, clickable_target(el)))
    return out


def resolve_tap(els, query=None, rid=None, exact=False, after=None,
                raw=False):
    """One matching element -> the point to tap. (x, y, matched, target, why).

    On failure x is None and `why` says which of the three different failures
    it was: nothing matched, it matched nothing tappable, or it matched
    something tappable that another view is sitting on top of. Those need
    three different responses from the caller and used to be one message.
    """
    cands = match_els(els, query, rid, exact, after)
    if not cands:
        return None, None, None, None, "nothing on screen matches"
    contested = None
    for matched, target in cands:
        if target is None:
            continue
        if raw:
            x, y = target.center
            return x, y, matched, target, None
        x, y, occ = safe_point(target, els, prefer=matched)
        if occ is None:
            return x, y, matched, target, None
        # Keep looking: another candidate may be in the clear. Remember the
        # first contested one so there is still an answer if none are.
        if contested is None:
            contested = (x, y, matched, target, occ)
    if contested is not None:
        x, y, matched, target, occ = contested
        return (x, y, matched, target,
                "!contested: %s may be under %s — check what moved, or "
                "scroll it clear" % (el_handle(target), el_handle(occ)))
    return None, None, cands[0][0], None, "matched, but nothing tappable"


def cmd_find(args):
    els = parse_ui(get_ui(args.from_file))
    if args.all:
        cands = match_els(els, args.query, args.rid, args.exact, args.after)
        if not cands:
            sys.stderr.write("phone: nothing matches\n")
            return 1
        for matched, target in cands[:args.limit or 20]:
            if target is None:
                print("%-11s %-26s %s" % ("-", "(not tappable)",
                                          matched.label[:44]))
                continue
            x, y, occ = safe_point(target, els, prefer=matched)
            print("%-11s %-26s %s%s"
                  % ("%d,%d" % (x, y), el_handle(target),
                     matched.label[:44],
                     ("   ?under %s" % el_handle(occ)) if occ else ""))
        return 0
    if not args.query and not args.rid:
        die("give a label to find, or --id <resource-id>", 2)
    x, y, _m, _t, why = resolve_tap(els, args.query, args.rid, args.exact,
                                    args.after, args.raw)
    if x is None:
        # An honest miss. Never print coordinates we are not sure about: a
        # wrong tap on someone's phone is worse than no tap.
        sys.stderr.write("phone: %s (%r)\n" % (why, args.query or args.rid))
        return 1
    if why:
        sys.stderr.write("phone: %s\n" % why.lstrip("!"))
    print("%d %d" % (x, y))
    return 0


# ------------------------------------------------------- notification inbox

def get_notifs(from_file=None):
    if from_file:
        with open(from_file, "r", encoding="utf-8", errors="replace") as f:
            raw = f.read()
    else:
        rc, raw = termux("termux-notification-list", timeout=40)
        if rc != 0 or not (raw or "").strip():
            die("could not read notifications — is Termux:API granted "
                "notification access? (cmd notification allow_listener "
                "com.termux.api/.apis.NotificationListAPI$NotificationService)",
                4)
    try:
        data = json.loads(raw)
    except ValueError:
        die("notification list was not JSON", 4)
    return data if isinstance(data, list) else []


def body_of(n):
    """The readable text of a notification.

    termux-notification-list has a long-standing bug where MessagingStyle
    notifications — group chats, i.e. exactly the messages that matter most —
    come back with content:"" while the actual text sits in `lines`. Taking
    `content` alone silently hides them, so fall through the alternatives.
    """
    for key in ("content", "bigText", "text"):
        v = n.get(key)
        if isinstance(v, str) and v.strip():
            return v.replace("\n", " ").strip()
    lines = n.get("lines")
    if isinstance(lines, list):
        joined = " / ".join(str(x).strip() for x in lines if str(x).strip())
        if joined:
            return joined
    return ""


def cmd_notifs(args):
    items = get_notifs(args.from_file)
    if args.app:
        want = pkg_of(args.app)
        if not want:
            die("unknown app %r (use a package name or one of: %s)"
                % (args.app, ", ".join(sorted(APPS))), 2)
        items = [n for n in items if n.get("packageName") == want]
    if args.since:
        items = [n for n in items if (n.get("when") or "") > args.since]
    record("notifs", {"app": args.app or "all", "n": len(items)}, "read")
    items.sort(key=lambda n: n.get("when") or "", reverse=True)
    if args.limit:
        items = items[:args.limit]
    if args.json:
        print(json.dumps(items, indent=2))
        return 0
    if not items:
        print("(no notifications)")
        return 0
    for n in items:
        app = (n.get("packageName") or "?").split(".")[-1]
        when = (n.get("when") or "")[11:16]
        title = n.get("title") or ""
        print("%s  %-10s %s: %s" % (when, app, title, body_of(n)))
    return 0


# ------------------------------------------------------------- device verbs

def cmd_say(args):
    # termux-api only. That has two costs worth knowing: termux-tts-speak
    # binds a whole TextToSpeech engine per sentence, so first audio is slow;
    # and it cannot report when speech actually FINISHED, so an agent that
    # says two things in a row can talk over itself.
    text = " ".join(args.text)
    if not text.strip():
        die("nothing to say", 2)
    rc, _ = termux("termux-tts-speak", text, timeout=args.timeout)
    record("say", text[:200], "act",
           "spoken" if rc == 0 else "failed: termux-tts-speak exited %d" % rc)
    return 0 if rc == 0 else 1


def cmd_listen(args):
    # termux-api only, like say.
    #
    # Every call opens the microphone, and an open microphone is not free.
    # Measured on a reference device: a loop that kept opening it whether or
    # not anyone meant to speak took the phone from 50% to 20% in two hours.
    # And a recogniser answers the room, not the person: whatever is audible
    # comes back as text, so an agent that acts on everything `listen`
    # returns will sooner or later act on overheard speech — a worse failure
    # than missing a request. Open it when someone is about to talk.
    need_termux()
    rc, out = termux("termux-speech-to-text", timeout=args.timeout)
    text = (out or "").strip()
    # The microphone captured someone's voice; that is a personal read
    # whether or not anything was recognised.
    record("listen", {"heard": bool(text)}, "read")
    if not text:
        sys.stderr.write("phone: heard nothing\n")
        return 1
    print(text)
    return 0


def cmd_notify(args):
    rc, _ = termux("termux-notification", "--title", args.title,
                   "--content", args.content, "--id", str(args.id))
    record("notify", args.title, "act")
    return 0 if rc == 0 else 1


_SCREEN = {}


def screen_size(display=None):
    """(w, h) in pixels for a display, read once per display per process.

    KEYED, because the cache predates displays. One global (w, h) was right
    while there was one screen and silently wrong the moment a second one had
    different dimensions: scroll_plan would compute a swipe from the physical
    screen's height and send it to a display of another size, landing the
    gesture somewhere nobody asked for.
    """
    d = display_id() if display is None else display
    if d not in _SCREEN:
        rc, out = dev_shell("wm size%s" % (" -d %d" % d if d else ""),
                            timeout=20)
        m = re.search(r"(\d+)x(\d+)", out or "")
        _SCREEN[d] = (int(m.group(1)), int(m.group(2))) if m else (1080, 2400)
    return _SCREEN[d]


def cmd_tap(args):
    need_shell()
    if args.label or args.rid:
        # Resolve and tap in ONE call. Two calls (`find` then `tap`) is not
        # just twice the wall clock — the coordinates have to travel out to
        # the caller's reasoning and back, which on a model is the expensive
        # half. It also closes the window in which the screen can move
        # between reading a coordinate and using it.
        els = parse_ui(get_ui())
        x, y, matched, target, why = resolve_tap(
            els, args.label, args.rid, args.exact, args.after, args.raw)
        if x is None:
            record("tap", args.label or args.rid, "act", "not found: %s" % why)
            sys.stderr.write("phone: %s (%r)\n"
                             % (why, args.label or args.rid))
            return 1
        if why:
            sys.stderr.write("phone: %s\n" % why.lstrip("!"))
        rc, _ = dev_shell("input%s tap %d %d" % (_dflag(), x, y))
        record("tap", "%s -> %d,%d" % (args.label or args.rid, x, y), "act",
               "dispatched" if rc == 0 else "failed")
        sys.stderr.write("tapped %s at %d,%d (%s)\n"
                         % (el_handle(target), x, y, matched.label[:40]))
    else:
        if args.x is None or args.y is None:
            die("give x and y, or --label/--id", 2)
        x, y = args.x, args.y
        rc, _ = dev_shell("input%s tap %d %d" % (_dflag(), x, y))
        # `input tap` exits 0 whether or not anything handled the event, so
        # the record says what we actually know: it was dispatched.
        record("tap", "%d,%d" % (x, y), "act",
               "dispatched" if rc == 0 else "failed")
    if rc == 0 and args.look:
        time.sleep(args.settle)
        return cmd_look(argparse.Namespace(
            limit=args.limit, all=False, from_file=None, grep=None,
            ids=False))
    return 0 if rc == 0 else 1


def cmd_swipe(args):
    need_shell()
    rc, _ = dev_shell("input%s swipe %d %d %d %d %d"
                      % (_dflag(), args.x1, args.y1, args.x2, args.y2,
                         args.ms))
    record("swipe", "%d,%d->%d,%d" % (args.x1, args.y1, args.x2, args.y2),
           "act", "dispatched" if rc == 0 else "failed")
    return 0 if rc == 0 else 1


def scroll_plan(direction, w, h, frac):
    """The gesture for one screenful, kept inside a band that is safe to
    touch. The outer ~12% top and bottom belong to the status bar, the
    gesture-navigation strip, and whatever the app floats over its own
    content — starting or ending a drag there gets the swipe eaten by the
    system instead of scrolling the list."""
    top, bot = int(h * 0.30), int(h * 0.80)
    mid_x = w // 2
    span = int((bot - top) * frac)
    if direction in ("down", "up"):
        # "down" means SEE WHAT IS FURTHER DOWN, which is a finger swipe UP.
        if direction == "down":
            return (mid_x, top + span, mid_x, top)
        return (mid_x, top, mid_x, top + span)
    left, right = int(w * 0.15), int(w * 0.85)
    y = h // 2
    if direction == "right":
        return (right, y, left, y)
    return (left, y, right, y)


def cmd_scroll(args):
    need_shell()
    w, h = screen_size()
    x1, y1, x2, y2 = scroll_plan(args.direction, w, h, args.frac)
    for _ in range(max(1, args.n)):
        rc, _ = dev_shell("input%s swipe %d %d %d %d %d"
                          % (_dflag(), x1, y1, x2, y2, args.ms))
        if rc != 0:
            record("scroll", args.direction, "act", "failed")
            return 1
        time.sleep(args.pause)
    record("scroll", "%s x%d" % (args.direction, max(1, args.n)), "act",
           "dispatched")
    if args.look:
        return cmd_look(argparse.Namespace(
            limit=args.limit, all=False, from_file=None, grep=None,
            ids=False))
    return 0


_SCAN_SH = r"""
p=%(path)s
mkdir -p /sdcard/.phone
i=0
prev=
while [ $i -lt %(max)d ]; do
  rm -f "$p"
  uiautomator dump %(win)s "$p" >/dev/null 2>&1
  if [ ! -s "$p" ]; then echo "__SCANDUMPFAIL__ $i"; break; fi
  if tr '<' '
' < "$p" %(only)s| grep -qi -- %(needle)s; then
    echo "__SCANFOUND__ $i"
    %(emit)s
    break
  fi
  # A list that has stopped moving is the bottom of the list. Without this a
  # scan spends the rest of its budget re-dumping the same final screen at
  # ~3.1s each, then reports "not found" as if it had searched that far.
  sig=$(tr '<' '
' < "$p" %(only)s| wc -c)
  if [ "$sig" = "$prev" ]; then echo "__SCANBOTTOM__ $i"; break; fi
  prev="$sig"
  input%(d)s swipe %(sx1)d %(sy1)d %(sx2)d %(sy2)d %(ms)d
  i=$((i+1))
  sleep %(pause)s
done
# NO `exit` anywhere above. dev_shell_checked wraps this in `{ ...; } > file`
# and then prints the md5 of that file; `exit` leaves the shell before the
# checksum is ever computed, and every scan comes back as "the read did not
# survive the trip". The loop has to fall off its own end.
[ $i -ge %(max)d ] && echo "__SCANEXHAUSTED__ %(max)d"
rm -f "$p"
"""


def cmd_scan(args):
    """Scroll until a label is on screen — with the LOOP ON THE DEVICE.

    A dump costs ~3.1s and it is all on-device work; shipping the 25-60 KB of
    XML back costs ~0.5s (measured on a reference device, 2026-08-30). So a
    controller-side scroll-look-decide loop pays a full round trip and a full
    model turn per screenful to learn one bit: is it here yet. Ten screens of
    a long catalogue is a minute of wall clock and ten turns of reasoning.

    Putting the loop on the phone pays the dumps once, ships ONE tree back —
    the one that matched — and returns a tap point from it. The caller spends
    one turn regardless of how far it had to scroll.
    """
    need_shell()
    import shlex
    w, h = screen_size()
    x1, y1, x2, y2 = scroll_plan(args.direction, w, h, args.frac)
    d = display_id()
    # A UNIQUE path, interpolated HERE. It was `scan-$$.xml`, and `$$` expands
    # in the DEVICE shell — which under shelld is the one persistent shell, so
    # every caller got the same pid and therefore the same filename. Two scans
    # at once wrote and `rm -f`ed each other's dump. Every other temp path in
    # this file already interpolates the controller's pid in Python; this one
    # was written when a scan meant a fresh shell.
    path = "/sdcard/.phone/scan-%d-%d.xml" % (os.getpid(),
                                              int(time.time() * 1000))
    # Off the built-in screen the dump has to carry every display, so both the
    # needle test and the "has the list stopped moving" signature have to be
    # narrowed to ours first — otherwise a match on ANOTHER display ends the
    # scan, and another display's clock ticking looks like our list scrolling.
    only = ("| awk -v d='display id=\"%d\"' "
            "'index($0,d)==1{on=1;next} "
            "on&&index($0,\"/display\")==1{on=0} on' " % d) if d else ""
    script = _SCAN_SH % {
        "max": max(1, args.max), "needle": shlex.quote(args.query),
        "sx1": x1, "sy1": y1, "sx2": x2, "sy2": y2, "ms": args.ms,
        "pause": args.pause, "path": path, "d": _dflag(),
        "win": "--windows" if d else "", "only": only,
        "emit": display_filter('"$p"', d) if d else 'cat "$p"',
    }
    # .strip() is load-bearing. dev_shell_checked wraps its argument as
    # `{ <cmd> ; } > file`, so a command ending in a newline becomes a line
    # that begins with a bare `;` — a syntax error that kills the shell, and
    # the failure surfaces as "the read did not survive the trip", which
    # points at the transport instead of at the quoting.
    rc, out = dev_shell_checked(script.strip(),
                                timeout=30 + 8 * max(1, args.max))
    out = out or ""
    if "__SCANDUMPFAIL__" in out:
        die("the UI dump failed while scanning (screen off, a secure window, "
            "or the screen never went idle). Nothing guessed.", 4)
    if "__SCANBOTTOM__" in out:
        m = re.search(r"__SCANBOTTOM__ (\d+)", out)
        n = int(m.group(1)) if m else 0
        record("scan", args.query, "read",
               "not found; list ended after %d screens" % n)
        sys.stderr.write("phone: %r is not here. The list stopped moving "
                         "after %d screen(s), so that was the end of it — "
                         "not the end of my budget.\n" % (args.query, n))
        return 1
    if "__SCANEXHAUSTED__" in out:
        n = max(1, args.max)
        record("scan", args.query, "read", "not found in %d screens" % n)
        sys.stderr.write("phone: %r is not in the next %d screens going %s. "
                         "The list may be shorter than that, or the label "
                         "may differ — `look` to see what is there.\n"
                         % (args.query, n, args.direction))
        return 1
    m = re.search(r"__SCANFOUND__ (\d+)", out)
    if not m or "<hierarchy" not in out:
        die("scan returned nothing readable", 4)
    if d and "<displays" not in out:
        die("scan asked display %d for a windows dump and got a "
            "single-display one — the device build may predate --windows" % d,
            4)
    screens = int(m.group(1))
    if d:
        # --windows returns every display; take ours, merged bottom-first.
        i = out.index("<displays")
        j = out.rfind("</displays>")
        xml = _hierarchy_for_display(
            out[i:j + len("</displays>")] if j > 0 else out[i:], d)
    else:
        i = out.index("<hierarchy")
        j = out.rfind("</hierarchy>")
        xml = out[i:j + len("</hierarchy>")] if j > 0 else out[i:]
    els = parse_ui(xml)
    x, y, matched, target, why = resolve_tap(
        els, args.query, None, args.exact, args.after, args.raw)
    where = "on screen %d" % screens if screens else "without scrolling"
    if x is None:
        record("scan", args.query, "read", "found %s but %s" % (where, why))
        sys.stderr.write("phone: found %r %s, but %s\n"
                         % (args.query, where, why))
        return 1
    record("scan", args.query, "read", "found %s at %d,%d" % (where, x, y))
    if args.tap:
        rc, _ = dev_shell("input%s tap %d %d" % (_dflag(), x, y))
        record("tap", "%s -> %d,%d" % (args.query, x, y), "act",
               "dispatched" if rc == 0 else "failed")
        sys.stderr.write("found %s; tapped %s at %d,%d\n"
                         % (where, el_handle(target), x, y))
        if rc == 0 and args.look:
            time.sleep(args.settle)
            return cmd_look(argparse.Namespace(
                limit=args.limit, all=False, from_file=None, grep=None,
                ids=False))
        return 0 if rc == 0 else 1
    sys.stderr.write("found %s\n" % where)
    print("%d %d" % (x, y))
    return 0


def focused_field():
    """What is currently accepting text. (state, description).

    state is "yes" (a real, enabled, focused editor), "no" (nothing is), or
    "unknown" (could not tell — never treat that as "no").

    This exists because `input text` writes into the void without complaining.
    Measured on a shopping app: an item sheet's notes box is rendered with
    enabled="false" and the store's refusal message sitting in it as text,
    while STILL reporting clickable="true". Tapping it and typing leaves the
    field untouched and every exit code zero, so `type` reported delivering
    every character it had thrown away. An actuator that lies about what it
    typed is worse than one that fails.

    ~0.65s against ~3.1s for a UI dump, so it is cheap enough to always do.
    """
    # Three lines mention mServedView and only one of them is the answer.
    # The standalone `  mServedView=<View>{...}` line is it. The
    # mFallbackInputConnection line above carries `mServedView=null` as a
    # substring at all times, so `grep -m1 mServedView` returns the wrong
    # line and reads "nothing focused" while a field is focused. And when
    # nothing IS focused the standalone line is absent altogether rather than
    # reading null — so its absence is the signal, not its contents.
    rc, out = dev_shell("dumpsys input_method 2>/dev/null | "
                        "grep 'mServedView'", timeout=20)
    if rc != 0 or not (out or "").strip():
        return "unknown", "could not read the input-method state"
    lines = (out or "").strip().splitlines()
    served = [ln for ln in lines if re.match(r"^\s*mServedView=", ln)]
    if not served:
        if any("mServedView=null" in ln for ln in lines):
            return "no", "no view is accepting text"
        return "unknown", "input-method state was not in a shape we know"
    m = re.search(r"mServedView=([\w.$]+)\{[0-9a-f]+ (\S+) (\S+)",
                  served[0])
    if not m:
        if "mServedView=null" in served[0]:
            return "no", "no view is accepting text"
        return "unknown", "input-method state was not in a shape we know"
    cls, flags1, flags2 = m.group(1), m.group(2), m.group(3)
    short = cls.rsplit(".", 1)[-1]
    if short.endswith("DecorView"):
        return "no", "the window itself is served, not a text field"
    enabled = len(flags1) > 2 and flags1[2] == "E"
    focused = len(flags2) > 1 and flags2[1] == "F"
    if not enabled:
        return "no", "%s is disabled" % short
    if not focused:
        return "no", "%s is not focused" % short
    return "yes", short


def cmd_type(args):
    # No need_shell() here: --print-only must work with no device, so the
    # exact argv can be inspected and tested off-device.
    import shlex
    text = " ".join(args.text)
    # `input text` mangles multi-word strings: the documented %s-for-space
    # escape silently dropped most of a sentence on a reference device
    # (measured — "Written by an AI agent over Shizuku" arrived as "iuku").
    # So: word by word with an explicit SPACE keyevent.
    #
    # Quote with shlex rather than stripping. The old strip-regex deleted
    # apostrophes, =, $, <, >, |, backtick and more, so "Don't" became "Dont"
    # and "x=2" became "x2" — and then it reported success, because it
    # counted WORDS WHOSE EXIT CODE WAS 0, which says nothing about what
    # arrived. An actuator that lies about what it typed is worse than one
    # that fails.
    words = text.split(" ")
    argv = []
    dropped = []
    for w in words:
        # Control characters are the only thing `input text` genuinely cannot
        # carry; everything else survives quoting.
        clean = "".join(c for c in w if c.isprintable())
        if clean != w:
            dropped.append(w)
        argv.append(clean)
    # (command, characters it delivers). NOT a bare list of strings: the
    # delivery count used to be recovered with step.startswith("input text ")
    # plus a plan.index() scan, and a display selector puts "-d 4" between
    # `input` and `text` — so the prefix stops matching, every count comes
    # back zero, and a type that worked is reported as one that failed.
    plan = []
    for i, w in enumerate(argv):
        if i:
            plan.append(("input%s keyevent 62" % _dflag(), 0))  # SPACE
        if w:
            plan.append(("input%s text %s" % (_dflag(), shlex.quote(w)),
                         len(w)))
    if args.print_only:
        print("\n".join(step for step, _n in plan))
        return 0
    need_shell()
    state, why = ("unknown", "") if args.force else focused_field()
    if state == "no":
        record("type", {"requested": text[:200]}, "act",
               "refused: nothing is accepting text (%s)" % why)
        die("nothing is accepting text right now — %s. Tap the field first; "
            "if it is disabled the app is refusing input, not you. "
            "(`--force` types anyway.)" % why, 4)
    delivered = 0
    for step, chars in plan:
        rc, _ = dev_shell(step)
        if rc != 0:
            break
        delivered += chars
    want = sum(len(w) for w in argv)
    ok_all = (delivered == want and not dropped)
    record("type", {"requested": text[:200], "sent": " ".join(argv)[:200]},
           "act", "delivered %d/%d chars%s"
           % (delivered, want,
              "; dropped unprintable" if dropped else ""))
    if not ok_all:
        sys.stderr.write("phone: typed %d of %d characters\n"
                         % (delivered, want))
    return 0 if ok_all else 1


def cmd_key(args):
    need_shell()
    k = args.key.upper()
    if not k.startswith("KEYCODE_"):
        k = "KEYCODE_" + k
    if not re.match(r"^KEYCODE_[A-Z0-9_]+$", k):
        die("bad keycode %r" % args.key, 2)
    rc, _ = dev_shell("input%s keyevent %s" % (_dflag(), k))
    record("key", k, "act", "dispatched" if rc == 0 else "failed")
    return 0 if rc == 0 else 1


def launch(url, print_only=False):
    """Level 1: hand a link to Android. No adb, so this keeps working when
    wireless debugging switches itself off."""
    if print_only:
        print(url)
        return 0
    exe = shutil.which("termux-open-url")
    if exe:
        rc, _ = run([exe, url], timeout=30)
        if rc == 0:
            return 0
    # Then the DEVICE SHELL — which is the forwarded socket when a
    # controller is driving, so this is the path that makes `open <url>` and
    # play's link tier work from another machine at all. Requiring adb here
    # meant both died with "Termux:API missing and adb is down" on a phone
    # where the shell was up the whole time.
    if not os.environ.get("PHONE_NO_DEVICE") and have_shell():
        rc, _out = dev_shell("am start%s -a android.intent.action.VIEW -d %s"
                             % (_amflag(), json.dumps(url)), timeout=30)
        if rc == 0:
            return 0
    die("could not open %s (Termux:API missing and adb is down)" % url, 3)


def cmd_open(args):
    target = args.target
    if is_url(target):
        return launch(target, args.print_url)
    key = target.strip().lower()
    p = pkg_of(target)
    if not p:
        # Refuse HERE, before any branch can quietly return 0. The
        # unresolved-name check used to live at the bottom of this function
        # and was unreachable whenever a device shell was present: `open
        # chrome` on a phone without Chrome exited 0 having done nothing at
        # all, which is the only outcome worse than launching the wrong app.
        pkgs = installed_packages(third_party_only=False)
        if pkgs:
            near = sorted({x.rsplit(".", 1)[-1] for x in pkgs
                           if key[:4] and key[:4] in x.lower()})[:8]
            die("no app matching %r on this device%s" %
                (target, (" — did you mean: %s" % ", ".join(near))
                 if near else ""), 4)
        die("unknown app %r and no device shell to check against" % target, 3)
    # LAUNCH the app when we can. The deep link is a fallback for when there
    # is no device shell — asking for "whatsapp" and getting a browser open
    # on wa.me is not what anyone means.
    if p and not have_shell():
        # LEVEL 1 LAUNCH. Measured on-device: `am start -n <component>`
        # succeeds from Termux with shizuku down and adb off, because
        # launching an activity does not need shell UID. Losing the shell
        # tier must not cost app launching — it is the first step of most
        # tasks, and the whole tier design is that level 1 keeps working.
        rc, out = run(["am", "start", "-n", "%s/.MainActivity" % p],
                      timeout=25)
        if rc != 0:
            # Without a shell we cannot resolve the real launcher activity,
            # so fall back to the monitor-free intent form.
            rc, out = run(["am", "start", "-a",
                           "android.intent.action.MAIN", "-c",
                           "android.intent.category.LAUNCHER", "-n", p],
                          timeout=25)
        if rc == 0:
            record("open", target, "act", "opened (level 1, no shell)")
            return 0
        # fall through to the link path below

    if p and have_shell():
        if args.print_url:
            die("%r launches as an app, not a link" % target, 2)
        # One app, one display — checked BEFORE the launch, because
        # `am start --display` on a package that already has a task
        # elsewhere does not create a second copy: it MOVES the task, and
        # the driver working on the old display loses its app mid-turn with
        # no error anywhere.
        guard_one_display(p)
        # Resolve first. `monkey` prints "No activities found to run" for an
        # uninstalled package and still exits 0, so `open whatsapp` reported
        # success on a phone with no WhatsApp — the most common first step of
        # any task, lying. (monkey also injects a random event, which is
        # reason enough to drop it.)
        rc, out = dev_shell(
            "cmd package resolve-activity --brief -c "
            "android.intent.category.LAUNCHER %s | tail -1" % p, timeout=30)
        comp = (out or "").strip().splitlines()[-1].strip() if out else ""
        if rc != 0 or "/" not in comp:
            record("open", target, "act", "failed: not installed")
            die("%s is not installed on this device" % target, 4)
        dev_shell("am start%s -n %s" % (_amflag(), comp), timeout=30)
        # Verify it actually came forward rather than assuming.
        landed = False
        for _ in range(8):
            time.sleep(0.5)
            _rc, fg = dev_shell(resumed_probe(), timeout=20)
            if p in (fg or ""):
                landed = True
                break
        record("open", target, "act", "opened" if landed else "did not open")
        if not landed:
            die("%s did not come to the foreground" % target, 4)
        return 0
    if key in LINKS:
        rc = launch(LINKS[key].replace("{q}", ""), args.print_url)
        if not args.print_url:
            record("open", target, "act", "via link")
        return rc
    if not p:
        pkgs = installed_packages()
        if pkgs:
            near = [x.rsplit(".", 1)[-1] for x in pkgs][:14]
            die("no app matching %r on this device. installed: %s"
                % (target, ", ".join(sorted(set(near)))), 4)
        die("unknown app %r and no device shell to check against" % target, 3)
    die("cannot launch %r: no device shell (start Shizuku)" % target, 3)


# Which app each search link actually needs present. Without this, the link
# is just a https URL and Android hands it to a browser — the wa.me shape.
PLAY_PKGS = {
    "ytmusic": "com.google.android.apps.youtube.music",
    "youtubemusic": "com.google.android.apps.youtube.music",
    "spotify": "com.spotify.music",
    "youtube": "com.google.android.youtube",
    "applemusic": "com.apple.android.music",
    "apple": "com.apple.android.music",
}


PLAY_FROM_SEARCH = "android.media.action.MEDIA_PLAY_FROM_SEARCH"


def intent_handlers(action, mime=None):
    """Which packages declare a handler for this intent, per THE DEVICE.

    Not a table, and the reason is sharper than "phones differ".

    This docstring used to say YouTube Music implements
    MEDIA_PLAY_FROM_SEARCH and another music app does not. Both halves were
    wrong within hours. The other app DOES declare it (a handler list read
    through `head` showed three of six). YouTube Music declares it and
    honours only half: it foregrounds, resolves the query correctly and
    builds a real queue, then sits at PAUSED position=0 and plays nothing.

    So a declaration is a hint, not a contract, and a written-down list is
    wrong faster than anyone will notice. Ask the device, then WATCH what
    happens.

    Returns None when we cannot look (no device shell), which is not the
    same as "nothing handles it".
    """
    # -t matters, and its absence under-reports. On a reference device
    # `query-activities -a SEND` resolves 4 handlers bare and 17 with
    # `-t text/plain` — a notes app among the thirteen that appear only with
    # it. A handler set that silently omits two thirds of the answer is worse
    # than none, because it reads as authoritative.
    q = "cmd package query-activities -a %s" % action
    if mime:
        q += " -t %s" % mime
    rc, out = dev_shell(merged(q), timeout=30)
    if rc != 0:
        return None
    pkgs = set()
    for line in (out or "").splitlines():
        line = line.strip()
        if line.startswith("packageName="):
            pkgs.add(line.split("=", 1)[1].strip())
    return pkgs


def cmd_play(args):
    from urllib.parse import quote_plus
    query = " ".join(args.query)
    app = (args.app or "ytmusic").strip().lower()
    tmpl = LINKS.get(app)
    if not tmpl or "{q}" not in tmpl:
        die("cannot search in %r — try ytmusic, spotify, or youtube" % app, 2)
    url = tmpl.replace("{q}", quote_plus(query))
    if args.print_url:
        return launch(url, True)

    # TIER 2 — ask the app. `am start -a MEDIA_PLAY_FROM_SEARCH --es query`
    # hands the app the words and lets IT do the searching and the choosing.
    # No UI dump, no coordinate, nothing to mis-tap, and it works with the
    # screen off. Only if the app does not declare the intent do we drop to
    # the link, and then we say so — a fallback that stays quiet reads like
    # the good path worked.
    pkg = PLAY_PKGS.get(app)
    handlers = intent_handlers(PLAY_FROM_SEARCH) if pkg else None
    use_intent = bool(pkg and handlers and pkg in handlers)
    if use_intent:
        # -p pins the package and lets Android resolve the component, so we
        # do not have to carry activity names that change between releases.
        cmd = ("am start%s -a %s --es query %s -p %s"
               % (_amflag(), PLAY_FROM_SEARCH, json.dumps(query), pkg))
        if args.dry_run:
            print("tier=intent  %s" % cmd)
            record("play", {"query": query, "app": app, "tier": "intent",
                            "dry_run": True}, "act", "planned")
            return 0
        rc, _out = dev_shell(cmd, timeout=40)
        if rc != 0:
            record("play", {"query": query, "app": app, "tier": "intent"},
                   "act", "failed: the app refused the intent", rc=1)
            die("%s did not accept the play intent" % app, 4)
        # Verify by asking media_session, not by assuming. The intent can be
        # accepted and resolve to a search screen without playing anything.
        started = None
        for _ in range(8):
            time.sleep(0.7)
            cur = current_session(parse_media_sessions(
                dev_shell("dumpsys media_session", timeout=30)[1] or ""))
            if cur and cur.get("package") == pkg and cur.get("state") == "PLAYING":
                started = cur
                break
        if started:
            record("play", {"query": query, "app": app, "tier": "intent",
                            "track": started.get("description")}, "act",
                   "started")
            print(describe_session(started))
            return 0
        # DECLARING the intent is not the same as HONOURING it. A music app
        # on the reference device declared MEDIA_PLAY_FROM_SEARCH, accepted
        # it, raised itself to the foreground — and played nothing. Without
        # the check above we would have reported "playing" on the strength
        # of `am start` exiting 0, which is the whole failure this file keeps
        # being about.
        #
        # So the ladder cascades: the tier that did not deliver is recorded
        # as not having delivered, and the next one is tried. What must never
        # happen is a silent fallback, because then a working tier and a
        # broken one produce the same output.
        record("play", {"query": query, "app": app, "tier": "intent"}, "act",
               "failed: %s took the intent and started no playback" % app,
               rc=1)
        sys.stderr.write("phone: %s accepted the play intent but started "
                         "nothing; falling back to opening its search\n" % app)

    if args.dry_run:
        why = ("%s does not declare %s on this device — falling back to the "
               "link" % (app, PLAY_FROM_SEARCH.rsplit(".", 1)[-1])
               if handlers is not None else
               "cannot check what %s declares (no device shell) — falling "
               "back to the link" % app)
        print("tier=link  %s\n%s" % (url, why))
        record("play", {"query": query, "app": app, "tier": "link",
                        "dry_run": True}, "act", "planned")
        return 0
    if handlers is not None and not use_intent:
        # Only true when the app really has no handler. Saying it after an
        # intent that WAS declared and simply did nothing sends whoever
        # reads it looking for a missing manifest entry that is present.
        sys.stderr.write("phone: %s does not declare a play-from-search "
                         "handler here; opening its search instead\n" % app)

    # Same shape as msg: a https link on a phone without the app opens a
    # browser and exits 0, and "playing" gets reported for a web page.
    pkg = PLAY_PKGS.get(app)
    here = package_present(pkg) if pkg else None
    if here is False:
        record("play", {"query": query, "app": app}, "act",
               "failed: %s is not installed on this device" % app)
        die("cannot play: %s is not installed on this device. "
            "(The link would open a browser, which is not music.)" % app, 4)

    # Record AFTER, with the outcome in hand. It used to record before the
    # attempt, so a launch that died outright still left a row asserting the
    # music was playing — the ledger stating as fact something no one had
    # any evidence for yet.
    try:
        rc = launch(url, False)
    except SystemExit as e:
        # Still record it. "I tried to play something and could not" is
        # exactly what the trace is for; silence would read as never asked.
        record("play", {"query": query, "app": app, "tier": "link"}, "act",
               "failed: could not open the link", rc=1)
        raise e
    # Verify the LINK tier the same way the intent tier is verified. The
    # verb is `play`; if nothing is playing it did not do what it says on
    # the tin, whichever route it took. Reporting 0 here would put the
    # disease back one tier down.
    playing = None
    if here and have_shell():
        for _ in range(6):
            time.sleep(0.7)
            cur = current_session(parse_media_sessions(
                dev_shell("dumpsys media_session", timeout=30)[1] or ""))
            if cur and cur.get("package") == pkg and cur.get("state") == "PLAYING":
                playing = cur
                break
    record("play", {"query": query, "app": app, "tier": "link",
                    "track": (playing or {}).get("description")}, "act",
           "started" if playing else
           ("opened the app; nothing started playing" if here else
            "unconfirmed: opened the link, but there is no device shell to "
            "confirm %s is installed" % app),
           rc=0 if (playing or not here) else 1)
    if playing:
        print(describe_session(playing))
        return 0
    if here:
        # 4, not 5: this was watched and did not happen, which is a failure.
        # 5 is a refusal — a held lease, one app one display — and a caller
        # reading it would wait for a lease nobody holds.
        sys.stderr.write("phone: opened %s but nothing is playing — it may "
                         "need a tap to choose a result\n" % app)
        return 4
    return rc


SEND_IDS = ("com.whatsapp:id/send", "com.whatsapp:id/send_container")


def cmd_msg(args):
    """Open a chat with the message prefilled, and — with --send — press send.

    Two-way is the point: an assistant that can only draft is a notepad. What
    makes it safe is not a permission prompt on every message but the ledger:
    the send is recorded here, at the chokepoint, whether or not anyone is
    watching. --send additionally VERIFIES rather than assuming: it re-reads
    the screen and reports honestly if the message did not go.
    """
    from urllib.parse import quote
    app = args.app.strip().lower()
    if app != "whatsapp":
        die("msg currently supports whatsapp only", 2)
    num = re.sub(r"[^\d]", "", args.to or "")
    if not num:
        die("--to must be a phone number in international form", 2)
    url = "https://wa.me/%s" % num
    if args.text:
        url += "?text=%s" % quote(args.text, safe="")
    if args.print_url:
        return launch(url, True)

    # Is WhatsApp actually here? A wa.me link handed to a phone without it
    # opens a BROWSER, exits 0, and used to be recorded as "drafted" — so the
    # agent would tell someone a message was sitting waiting to be tapped
    # when nothing of the kind existed. cmd_open learned this already
    # ("asking for whatsapp and getting a browser open on wa.me is not what
    # anyone means"); the verb where it matters most had not.
    #
    # installed_packages() is empty when there is no device shell, and an
    # empty list is "I could not look", not "it is not there" — the two must
    # not collapse, or losing the shell would start refusing sends on phones
    # that can perfectly well make them.
    pkgs = installed_packages()
    verified = bool(pkgs)
    if verified and not any(p == "com.whatsapp" for p in pkgs):
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act",
               "failed: WhatsApp is not installed on this device")
        die("cannot draft: WhatsApp is not installed on this device. "
            "(A wa.me link would open a browser, which is not a message.)", 4)

    if not args.send:
        try:
            rc = launch(url, False)      # dies loudly if it cannot open
        except SystemExit as e:
            # Record the attempt. It used to die here with nothing written,
            # so a message the agent tried and failed to draft left no trace
            # — indistinguishable, later, from never having been asked.
            record("msg", {"app": app, "to": num, "text": args.text,
                           "sent": False}, "act",
                   "failed: could not open the chat", rc=1)
            raise e
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False, "verified": verified}, "act",
               "drafted" if verified else
               "unconfirmed: opened the chat link, but there is no device "
               "shell to confirm WhatsApp is installed")
        return rc

    # --send needs to TOUCH the screen, which only the adb tier can do.
    if not have_shell():
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no device shell")
        die("cannot send: no device shell, so the send button cannot be "
            "pressed. Start Shizuku. (Refusing to report a send that did not "
            "happen.)", 3)
    launch(url, False)
    import time as _t
    deadline = _t.time() + 25
    # Only ever press send while WhatsApp is actually in front. The
    # content-desc fallback below ("Send") is not namespaced to any app, so
    # without this a stray overlay, another chat app, or a share sheet could
    # supply the button we tap.
    fg_ok = False
    while _t.time() < deadline and not fg_ok:
        rc, out = dev_shell(resumed_probe(), timeout=30)
        if "com.whatsapp" in (out or ""):
            fg_ok = True
            break
        _t.sleep(1.0)
    if not fg_ok:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: chat never opened")
        die("cannot send: WhatsApp never came to the foreground. "
            "Nothing was sent.", 4)
    coords = None
    while _t.time() < deadline:
        _t.sleep(1.5)
        try:
            els = parse_ui(get_ui(None))
        except SystemExit:
            continue
        for el in els:
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                tgt = clickable_target(el)
                if tgt is not None:
                    coords = tgt.center
                    break
        if coords:
            break
    if not coords:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "failed: no send button")
        die("cannot send: never found the send button (the chat may not have "
            "opened). Nothing was sent.", 4)
    dev_shell("input%s tap %d %d" % (_dflag(), coords[0], coords[1]))
    _t.sleep(2.0)
    # Verify rather than assume: after a send the composer empties, so the
    # send affordance disappears. If it is still there, the tap did not take.
    still = False
    try:
        for el in parse_ui(get_ui(None)):
            if el.rid in SEND_IDS or (el.desc or "").strip().lower() == "send":
                still = True
                break
    except SystemExit:
        still = False
    if still:
        record("msg", {"app": app, "to": num, "text": args.text,
                       "sent": False}, "act", "unconfirmed")
        sys.stderr.write("phone: tapped send but the composer still looks "
                         "full — treat as UNSENT and check the thread\n")
        return 1
    record("msg", {"app": app, "to": num, "text": args.text, "sent": True},
           "act", "sent")
    print("sent to %s" % num)
    return 0



# ------------------------------------------------------------- the bridge
# The bridge app (parallelroot.bridge, android/bridge) is the app half: a
# NotificationListenerService reachable on loopback. It exists for the one
# thing shell provably cannot do — firing a notification's reply action
# needs the live PendingIntent, which only a bound listener ever holds.
# Optional: only `reply` needs it.
#
# Reached the same way shelld is: an ssh forward. Same idiom, one more port.

BRIDGE_APP = "parallelroot.bridge"
BRIDGE_PORT = 8137              # on the DEVICE. Bridge.java binds this one.
BRIDGE_TOKEN_PATH = "/sdcard/Android/data/%s/files/token" % BRIDGE_APP
# How the listener is switched on, for messages that have to say so. As
# shell, which also avoids Android 13+'s "restricted settings" block on
# granting notification access to a sideloaded app from Settings.
BRIDGE_ENABLE = "cmd notification allow_listener %s/.Listener" % BRIDGE_APP


def bridge_local_port():
    """The LOCAL end of the forward, which is per-driver.

    It used to be BRIDGE_PORT at both ends, and ensure_bridge opened with an
    unconditional `pkill -f "L <port>:127.0.0.1:<port>"` — a kill of whatever
    forward was there, including another driver's. Two drivers on one
    controller meant the second one cut the first's bridge mid-request, and
    the first saw only a socket that stopped answering.

    The device end stays fixed because the app binds it; only this end moves.
    """
    try:
        return int(os.environ.get("PHONE_BRIDGE_PORT") or BRIDGE_PORT)
    except ValueError:
        return BRIDGE_PORT


def bridge_token(device=None):
    """The shared secret, read from where only the device shell can reach it.

    Loopback is not a permission boundary — every app on the phone can open a
    socket to 127.0.0.1 — so the token is what separates "has shell on this
    phone" from "is any app on this phone".

    PHONE_BRIDGE_TOKEN short-circuits the read for a controller that already
    holds it (and for the test suite, which has no device to read it from).
    """
    tok = (os.environ.get("PHONE_BRIDGE_TOKEN") or "").strip()
    if tok:
        return tok if re.match(r"\A[0-9a-f]{16,}\Z", tok) else None
    rc, out = dev_shell(merged("cat %s" % BRIDGE_TOKEN_PATH), timeout=25)
    tok = (out or "").strip()
    if rc != 0 or not re.match(r"\A[0-9a-f]{16,}\Z", tok):
        return None
    return tok


def ensure_bridge(device):
    """Forward the bridge port, if it is not already answering."""
    if not device:
        return True
    if _bridge_alive():
        return True
    if not _DEV_RE.match(device or ""):
        die("bad device name %r" % device, 2)
    lp = bridge_local_port()
    # Scoped to OUR port. A dead forward of ours still holds the port and
    # would make the fresh one fail; another driver's forward is none of our
    # business.
    subprocess.run(["pkill", "-f",
                    "L %d:127.0.0.1:%d" % (lp, BRIDGE_PORT)],
                   capture_output=True)
    rc, _ = run(["ssh", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
                 "-o", "ControlMaster=no", "-o", "ControlPath=none",
                 "-o", "ServerAliveInterval=20", "-f", "-N",
                 "-L", "%d:127.0.0.1:%d" % (lp, BRIDGE_PORT),
                 device], timeout=25)
    if rc != 0:
        return False
    for _ in range(10):
        time.sleep(0.3)
        if _bridge_alive():
            return True
    return False


def _bridge_alive():
    import socket as _s
    c = _s.socket(_s.AF_INET, _s.SOCK_STREAM)
    c.settimeout(1.5)
    try:
        c.connect(("127.0.0.1", bridge_local_port()))
        return True
    except OSError:
        return False
    finally:
        try:
            c.close()
        except OSError:
            pass


def bridge_call(op, device=None, wait=90, **kw):
    """One line of JSON out, one back. None when the bridge is unreachable —
    which callers treat as "fall back", never as "it said no"."""
    import socket as _s
    if not ensure_bridge(device):
        return None
    tok = bridge_token(device)
    if not tok:
        return None
    req = dict(kw)
    req["op"] = op
    req["token"] = tok
    c = _s.socket(_s.AF_INET, _s.SOCK_STREAM)
    # OUR deadline for the socket, deliberately not named `timeout`: an op can
    # carry its own `timeout` field, and a collision here meant a verb died
    # with "got multiple values for keyword argument" the first time it ran.
    # Different concepts, different names.
    c.settimeout(wait)
    try:
        c.connect(("127.0.0.1", bridge_local_port()))
        c.sendall((json.dumps(req) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = c.recv(65536)
            if not chunk:
                break
            buf += chunk
    except OSError:
        return None
    finally:
        try:
            c.close()
        except OSError:
            pass
    try:
        return json.loads(buf.decode("utf-8", "replace").split("\n", 1)[0])
    except ValueError:
        return None


# ------------------------------------------------------------ capabilities
# Every capability fact in this file is dated. Shell holds READ_SMS on
# Android 16 today; a music app declares MEDIA_PLAY_FROM_SEARCH today; six
# packages answer that intent on THIS phone and a different six will answer
# it on the next one. Written into a skill as fact, each of those starts
# lying on some future release and nothing tells anybody.
#
# So the skill teaches METHOD and this verb supplies FACTS — live, from the
# phone in front of you. An agent that needs to know what is possible here
# asks the device, the way it should have all along.
#
# Three-valued on purpose: True / False / None-for-could-not-check. Folding
# "I could not look" into "no" is the single mistake this codebase has made
# most often — an empty package list read as "the app is missing", an empty
# SMS table read as "SMS is blocked". A capability probe that cannot say
# "I don't know" manufactures confident wrong answers, which is worse than
# no probe at all.


def _cap_termux():
    """Is termux-api present ON THE PHONE — not on whoever is asking.

    Every other probe here runs through dev_shell, which the forwarded
    socket carries to the device, so those are already answers about the
    phone. This one is not: have_termux() looks at the local PATH, and on a
    controller that is a fact about the controller being reported as a fact
    about the phone. The one verb whose job is to avoid confident wrong
    answers must not open with one.

    Asked over ssh as a plain shell test, deliberately not as `phone
    something` — a diagnostic that needs the device's copy of this file to
    be up to date is useless exactly when you most want it.
    """
    dev = os.environ.get("PHONE_DEVICE")
    if not dev:
        return {"ok": bool(have_termux()),
                "detail": "termux-api binaries on PATH"
                if have_termux() else "not on this machine's PATH"}
    if not _DEV_RE.match(dev):
        return {"ok": None, "detail": "bad device name"}
    argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
            "-o", "StrictHostKeyChecking=accept-new", dev,
            "command -v termux-tts-speak >/dev/null 2>&1 && echo yes || echo no"]
    try:
        pr = subprocess.run(argv, capture_output=True, text=True, timeout=25)
    except (OSError, subprocess.SubprocessError) as e:
        return {"ok": None, "detail": "could not ask %s (%s)" % (dev, e)}
    if pr.returncode != 0:
        return {"ok": None, "detail": "could not reach %s" % dev}
    yes = (pr.stdout or "").strip() == "yes"
    return {"ok": yes,
            "detail": "termux-api present on %s" % dev if yes else
            "termux-api not installed on %s" % dev}


def _cap_provider(uri, label):
    """Readable, denied, or unknown — and EMPTY IS READABLE."""
    rc, out = dev_shell(merged("content query --uri %s --projection _id" % uri),
                        timeout=30)
    if rc != 0:
        return (None, "could not run the query")
    text = (out or "").strip()
    if "Exception" in text or "Permission Denial" in text:
        last = text.splitlines()[-1] if text.splitlines() else text
        return (False, "denied: %s" % last[:80])
    if "No result found" in text:
        return (True, "readable, currently empty")
    return (True, "readable")


def probe_capabilities():
    """What can this device actually do, right now."""
    caps, android = {}, {"release": None, "sdk": None}
    if not have_shell():
        for k in ("contacts", "calendar", "sms", "call_log", "media_session",
                  "notification_listeners", "notification_replies",
                  "play_from_search"):
            caps[k] = {"ok": None, "detail": "no device shell to ask"}
        caps["termux_api"] = _cap_termux()
        return {"android": android, "capabilities": caps}

    for key, prop in (("release", "ro.build.version.release"),
                      ("sdk", "ro.build.version.sdk")):
        rc, out = dev_shell("getprop %s" % prop, timeout=20)
        android[key] = (out or "").strip() or None if rc == 0 else None

    for key, uri in (
            ("contacts", "content://com.android.contacts/data/phones"),
            ("calendar", "content://com.android.calendar/calendars"),
            ("sms", "content://sms"),
            ("call_log", "content://call_log/calls")):
        ok, detail = _cap_provider(uri, key)
        caps[key] = {"ok": ok, "detail": detail}

    rc, out = dev_shell("cmd media_session list-sessions", timeout=25)
    if rc != 0:
        caps["media_session"] = {"ok": None, "detail": "could not ask"}
    else:
        pkgs = re.findall(r"package=([A-Za-z0-9._]+)", out or "")
        caps["media_session"] = {
            "ok": True,
            "detail": ("%d session(s): %s" % (len(pkgs), ", ".join(sorted(set(pkgs)))))
            if pkgs else "no app is holding a media session"}

    rc, out = dev_shell(
        "settings get secure enabled_notification_listeners", timeout=20)
    if rc != 0:
        caps["notification_listeners"] = {"ok": None, "detail": "could not ask"}
    else:
        names = [n.split("/")[0] for n in (out or "").strip().split(":") if n.strip()]
        caps["notification_listeners"] = {
            "ok": bool(names),
            "detail": ", ".join(sorted(set(names))) or "none enabled"}

    rc, out = dev_shell("dumpsys notification --noredact", timeout=40)
    if rc != 0:
        caps["notification_replies"] = {"ok": None, "detail": "could not ask"}
    else:
        # This used to count /[Rr]emoteInput/ and report "26 direct-reply
        # actions". All 26 were `android.remoteInputHistory=null` — one
        # standard extras key per notification record, present whether or not
        # anything is repliable. Case-sensitive RemoteInput matches ZERO.
        # A capability probe reporting a capability that does not exist is
        # worse than one reporting nothing.
        #
        # dumpsys cannot answer this honestly at all: the authority is
        # Notification.Action.getRemoteInputs(), which only a bound listener
        # can call. So say who to ask instead of guessing.
        hist = len(re.findall(r"remoteInputHistory", out or ""))
        caps["notification_replies"] = {
            "ok": None,
            "detail": ("shell cannot tell — dumpsys shows %d "
                       "remoteInputHistory keys, which are NOT reply actions. "
                       "Ask the bridge app's listener (%s: `phone reply "
                       "--list`, op \"list\", field \"repliable\")"
                       % (hist, BRIDGE_APP))}

    handlers = intent_handlers(PLAY_FROM_SEARCH)
    caps["play_from_search"] = ({"ok": None, "detail": "could not ask"}
                                if handlers is None else
                                {"ok": bool(handlers),
                                 "detail": ", ".join(sorted(handlers))
                                 or "no app declares it"})
    caps["termux_api"] = _cap_termux()
    return {"android": android, "capabilities": caps}


def cmd_capabilities(args):
    d = probe_capabilities()
    record("capabilities", {"n": len(d["capabilities"])}, "read")
    if args.json:
        print(json.dumps(d, indent=2))
        return 0
    a = d["android"]
    print("android %s (sdk %s)" % (a.get("release") or "?", a.get("sdk") or "?"))
    for k in sorted(d["capabilities"]):
        v = d["capabilities"][k]
        mark = {True: "yes", False: "no", None: "?"}[v["ok"]]
        print("  %-24s %-4s %s" % (k, mark, v["detail"]))
    return 0


# ------------------------------------------------- the structured providers
# Shell UID is not just a way to press keys on the screen. com.android.shell
# declares READ_CONTACTS / READ_CALENDAR / READ_SMS / READ_CALL_LOG in its
# manifest and the platform pre-grants them, so the phone will simply ANSWER
# questions that the UI tier has to go hunting for. Reading a phone number
# off the Contacts app costs a launch, a dump, a tap and another dump; here
# it is one query, works with the screen off, and cannot mis-tap.


def parse_content_rows(text, keys):
    """`content query` output -> dicts, splitting on KEYS not on commas.

    The command prints `Row: 0 k=v, k=v` and quotes nothing. A calendar
    event called "Lunch with Alice, Bob, and Carol", or a contact filed as
    "Smith, John", shreds under a naive split on ", ". We chose the
    projection, so we know exactly which keys can start a field — split on
    those boundaries and everything between them is the value, commas and
    all.
    """
    rows = []
    # ", key=" is the only real delimiter, and only for keys we asked for.
    delim = re.compile(r",\s+(?=(?:%s)=)" % "|".join(re.escape(k) for k in keys))
    for line in (text or "").splitlines():
        line = line.strip()
        if not line.startswith("Row:"):
            continue
        body = line.split(" ", 2)
        if len(body) < 3:
            continue
        row = {}
        for field in delim.split(body[2]):
            k, _, v = field.partition("=")
            if k.strip() in keys:
                row[k.strip()] = v
        if row:
            rows.append(row)
    return rows


def provider_query(uri, keys, sort=None, timeout=40):
    cmd = "content query --uri %s --projection %s" % (uri, ":".join(keys))
    if sort:
        cmd += " --sort %s" % json.dumps(sort)
    rc, out = dev_shell(merged(cmd), timeout=timeout)
    if rc != 0:
        die("could not read %s from the device" % uri, 4)
    # An empty table says "No result found." — that is a legitimate answer,
    # not a failure. A denial raises instead, and lands in `out` as an
    # exception, which the caller sees rather than silently getting [].
    if "Exception" in (out or ""):
        die("provider refused: %s" % (out or "").strip().splitlines()[-1], 4)
    return parse_content_rows(out or "", keys)


CAL_KEYS = ["title", "begin", "end", "eventLocation", "allDay"]


def cmd_cal(args):
    if args.from_:
        with open(args.from_, "r", encoding="utf-8", errors="replace") as f:
            rows = parse_content_rows(f.read(), CAL_KEYS)
    else:
        need_shell()
        now = int(time.time() * 1000)
        end = now + int(args.days) * 86400000
        rows = provider_query(
            "content://com.android.calendar/instances/when/%d/%d" % (now, end),
            CAL_KEYS)
    events = []
    for r in rows:
        try:
            begin = int(r.get("begin") or 0)
        except ValueError:
            begin = 0
        events.append({
            "title": r.get("title") or "(untitled)",
            "begin_ms": begin,
            "all_day": (r.get("allDay") or "0").strip() == "1",
            "location": (r.get("eventLocation") or "").strip() or None,
        })
    events.sort(key=lambda e: e["begin_ms"])
    record("cal", {"days": args.days, "n": len(events)}, "read")
    if args.json:
        print(json.dumps(events, indent=2))
        return 0
    if not events:
        print("(nothing on the calendar)")
        return 0
    for e in events:
        when = (time.strftime("%a %d %b", time.localtime(e["begin_ms"] / 1000))
                if e["all_day"] else
                time.strftime("%a %d %b %H:%M",
                              time.localtime(e["begin_ms"] / 1000)))
        print("%-18s %s%s" % (when, e["title"],
                              ("  @ " + e["location"]) if e["location"] else ""))
    return 0


CONTACT_KEYS = ["display_name", "data1"]


def cmd_contacts(args):
    if args.from_:
        with open(args.from_, "r", encoding="utf-8", errors="replace") as f:
            rows = parse_content_rows(f.read(), CONTACT_KEYS)
    else:
        need_shell()
        rows = provider_query("content://com.android.contacts/data/phones",
                              CONTACT_KEYS)
    people = [{"name": (r.get("display_name") or "").strip(),
               "number": (r.get("data1") or "").strip()} for r in rows]
    q = (args.query or "").strip().lower()
    if q:
        people = [p for p in people if q in p["name"].lower()]
    # The detail is a COUNT, never the rows. A trace that copies the address
    # book out of the phone is a second copy of the thing it is meant to
    # protect — and unlike the phone's own store, it is a flat file.
    record("contacts", {"query": args.query or None, "n": len(people)}, "read")
    if args.json:
        print(json.dumps(people, indent=2))
        return 0 if people or not q else 1
    if not people:
        # Never guess. A wrong number is worse than no number.
        sys.stderr.write("phone: no contact matching %r\n" % (args.query or ""))
        return 1
    for p in people:
        print("%-28s %s" % (p["name"][:28], p["number"]))
    return 0


_STATE_RE = re.compile(r"state=([A-Z_]+)\((\d+)\), position=(-?\d+)")


def parse_media_sessions(text):
    """`dumpsys media_session` -> structured sessions.

    This is the phone TELLING us what is playing. The alternative — dumping
    the UI tree, reading artist names off the screen and tapping a
    coordinate — is computer use, and it is the wrong tool when the device
    will simply answer the question: app, transport state, position, track,
    and the error if the session is broken.
    """
    out, cur = [], None
    # Which session will actually receive `cmd media_session dispatch`.
    # The command takes no session argument: it goes to the media button
    # session — the app that last held AUDIO — which is not necessarily the
    # foreground app, and not necessarily the one you just addressed with an
    # intent. Watched on the device: with YouTube Music foregrounded, active
    # and holding a loaded queue, `dispatch play` started a different music
    # app.
    bm = re.search(r"Media button session is ([A-Za-z0-9._]+)/", text or "")
    button = bm.group(1) if bm else None
    for raw in (text or "").splitlines():
        line = raw.strip()
        if line.startswith("package="):
            pkg = line.split("=", 1)[1].strip()
            cur = {"package": pkg, "active": False,
                   "state": None, "position_ms": None, "description": None,
                   "error": None,
                   "media_button": button is not None and pkg == button}
            out.append(cur)
            continue
        if cur is None:
            continue
        if line.startswith("active="):
            cur["active"] = line.split("=", 1)[1].strip() == "true"
        elif line.startswith("state=PlaybackState"):
            m = _STATE_RE.search(line)
            if m:
                cur["state"] = m.group(1)
                cur["position_ms"] = int(m.group(3))
            # error=... is last on the line and may contain commas/spaces.
            em = re.search(r"error=(.+?)\}\s*$", line)
            if em and em.group(1).strip() != "null":
                cur["error"] = em.group(1).strip()
        elif line.startswith("metadata:"):
            body = line.split(":", 1)[1].strip()
            dm = re.search(r"description=(.*)$", body)
            if dm and dm.group(1).strip() not in ("", "null"):
                cur["description"] = dm.group(1).strip()
    return out


def current_session(sessions):
    """The session that MATTERS.

    Not the first printed and not merely the first active one: an app can
    hold an active session that is erroring (a music app that is signed out
    sits there with state=ERROR) and dispatching transport keys at it does
    nothing. Prefer something actually playing, then something paused with a
    real position, then anything active and not errored.
    """
    def rank(s):
        if s.get("error") or not s.get("active"):
            return -1
        if s.get("state") == "PLAYING":
            return 3
        if s.get("state") == "PAUSED":
            return 2
        return 1 if s.get("state") else 0
    best = max(sessions, key=rank) if sessions else None
    return best if best and rank(best) >= 0 else None


def describe_session(s):
    bits = [s["package"], (s.get("state") or "no state").lower()]
    if s.get("media_button"):
        bits.append("<- keys")
    if s.get("description"):
        bits.append(s["description"])
    if s.get("position_ms") not in (None, -1):
        bits.append("%d:%02d" % divmod(s["position_ms"] // 1000, 60))
    if s.get("error"):
        bits.append("error: %s" % s["error"])
    return "  ".join(bits)


def read_media(args):
    if getattr(args, "from_", None):
        with open(args.from_, "r", encoding="utf-8", errors="replace") as f:
            return parse_media_sessions(f.read())
    need_shell()
    _rc, out = dev_shell("dumpsys media_session", timeout=40)
    return parse_media_sessions(out or "")


# The transport keys `cmd media_session dispatch` accepts. NOT
# `input keyevent`: that injects a key into whatever happens to hold audio
# focus and exits 0 whether or not anything consumed it — the same
# report-success-you-did-not-observe shape as `input tap`. media_session
# targets the real session and, with dumpsys, lets us check afterwards.
DISPATCH = {"play": "play", "pause": "pause", "toggle": "play-pause",
            "next": "next", "prev": "previous", "stop": "stop"}


def cmd_media(args):
    sessions = read_media(args)
    if args.action in (None, "status"):
        if args.current:
            cur = current_session(sessions)
            if not cur:
                print("(nothing is playing)")
                return 0
            sessions = [cur]
        if args.json:
            print(json.dumps(sessions, indent=2))
            return 0
        if not sessions:
            print("(no media sessions)")
            return 0
        for s in sessions:
            print(describe_session(s))
        return 0

    need_shell()
    # Verify against the session the keys will actually reach. Comparing
    # `current_session` before and after re-ranks in between: if the dispatch
    # lands on a different app, the ranking can hand back a DIFFERENT session
    # afterwards, the two states differ, and the move reads as success —
    # crediting one app's playback to another.
    target = next((x for x in sessions if x.get("media_button")), None)
    before = target or current_session(sessions)
    if target and args.strict and current_session(sessions) is not None \
            and current_session(sessions).get("package") != target["package"]:
        die("the media keys go to %s, but the session that looks current is "
            "%s — name what you mean or drop --strict"
            % (target["package"], current_session(sessions)["package"]), 4)
    rc, _out = dev_shell("cmd media_session dispatch %s"
                         % DISPATCH[args.action], timeout=25)
    if rc != 0:
        record("media", {"action": args.action}, "act", "failed: dispatch", rc=1)
        die("could not dispatch %s to the media session" % args.action, 4)

    # Watch for the change rather than assuming it. A transport key can be
    # accepted and ignored — the app may not honour it, or the session may
    # have gone away between the read and the dispatch.
    def _same_session(fresh):
        """Re-find the SAME app, so before/after is one session's story."""
        if before is None:
            return current_session(fresh)
        for x in fresh:
            if x.get("package") == before["package"]:
                return x
        return None

    after = None
    for _ in range(6):
        time.sleep(0.5)
        after = _same_session(read_media(args))
        if _media_moved(before, after, args.action):
            break
    moved = _media_moved(before, after, args.action)
    record("media", {"action": args.action,
                     "package": (after or before or {}).get("package"),
                     "before": (before or {}).get("state"),
                     "after": (after or {}).get("state")}, "act",
           "%s -> %s" % (args.action, (after or {}).get("state") or "gone")
           if moved else
           "unconfirmed: dispatched %s, state did not change" % args.action)
    if after:
        print(describe_session(after))
    if not moved:
        # Watched, and it did not happen: a failure (4), not a refusal (5).
        sys.stderr.write("phone: dispatched %s but the session did not "
                         "change — it may have been ignored\n" % args.action)
        return 4
    return 0


def _media_moved(before, after, action):
    """Did the dispatch actually do anything we can see?"""
    if after is None:
        return False
    if action in ("play", "pause", "toggle", "stop"):
        return (before or {}).get("state") != after.get("state")
    # next/prev change the track, not the transport state.
    return (before or {}).get("description") != after.get("description")


def cmd_screen(args):
    need_shell()
    out_path = args.out or "screen.png"
    if display_id():
        # A virtual display cannot be screencap'd — see _vd_capture. The
        # holder that owns the Surface is the only process that can read it.
        data = _vd_capture(display_id())
        if not data:
            die("display %d produced no image" % display_id(), 4)
        if out_path == "-":
            record("screen", "stdout", "read")
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
            return 0
        with open(out_path, "wb") as f:
            f.write(data)
        record("screen", out_path, "read")
        print(out_path)
        return 0
    # Same split, and the same unique-path rule: a screenshot that failed
    # must not hand back the last one that worked.
    remote = "/sdcard/.phone/shot-%d-%d.png" % (os.getpid(),
                                                int(time.time() * 1000))
    rc, _m = dev_shell("mkdir -p /sdcard/.phone && screencap -p %s" % remote,
                       timeout=60)
    data = dev_read(remote, want_bytes=True) if rc == 0 else b""
    dev_shell("rm -f %s" % remote, timeout=15)
    if not data and not os.environ.get("PHONE_NO_DEVICE") \
            and shutil.which("adb") and adb_ready():
        _rc, data = adb("exec-out", "screencap -p", timeout=60,
                        want_bytes=True)
    if not data:
        die("screenshot failed (screen off or secure surface)", 4)
    if out_path == "-":
        # Straight to stdout so a controller can stream it over ssh without
        # leaving a picture of someone's phone lying around on disk.
        record("screen", "stdout", "read")
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        return 0
    with open(out_path, "wb") as f:
        f.write(data)
    record("screen", out_path, "read")
    print(out_path)
    return 0


def cmd_photo(args):
    rc, _ = termux("termux-camera-photo", "-c", str(args.cam), args.out,
                   timeout=60)
    # The camera is the most invasive thing here. It records whether it
    # succeeded or not.
    record("photo", {"cam": args.cam, "out": args.out}, "act",
           "captured" if rc == 0 else "failed")
    if rc != 0:
        return 1
    print(args.out)
    return 0


def cmd_torch(args):
    rc, _ = termux("termux-torch", args.state)
    record("torch", args.state, "act")
    return 0 if rc == 0 else 1


def cmd_battery(args):
    rc, out = termux("termux-battery-status")
    if rc != 0:
        return 1
    try:
        d = json.loads(out)
        print("%s%%  %s  %s" % (d.get("percentage"), d.get("status", "?"),
                                d.get("plugged", "")))
    except ValueError:
        print((out or "").strip())
    return 0


def cmd_where(args):
    rc, out = termux("termux-location", "-p",
                     args.provider, timeout=60)
    # Location is named in the policy above as a logged read. It was not
    # logged at all — the single sharpest contradiction in this file.
    record("where", args.provider, "read")
    print((out or "").strip())
    return 0 if rc == 0 else 1


def cmd_clip(args):
    if args.action == "get":
        rc, out = termux("termux-clipboard-get")
        record("clip", "get", "read")       # the clipboard is personal
        print((out or "").rstrip("\n"))
        return 0 if rc == 0 else 1
    rc, _ = termux("termux-clipboard-set", " ".join(args.text))
    record("clip", "set", "act")
    return 0 if rc == 0 else 1


def cmd_apps(args):
    need_shell()
    rc, out = dev_shell("pm list packages -3", timeout=40)
    pkgs = sorted(l.replace("package:", "").strip()
                  for l in (out or "").splitlines() if l.strip())
    rev = {v: k for k, v in APPS.items()}
    for p in pkgs:
        if args.grep and args.grep.lower() not in p.lower():
            continue
        print("%-45s %s" % (p, rev.get(p, "")))
    return 0


def cmd_foreground(args):
    need_shell()
    rc, out = dev_shell(resumed_probe(), timeout=40)
    print(foreground_of(out))
    return 0



# ------------------------------------------------------------- action ledger
# Full two-way agency on someone's real phone is acceptable when it is
# ACCOUNTABLE, not when it is gated into uselessness. Every capability on this
# device flows through this CLI, which makes this CLI the one chokepoint where
# a record can be written — an agent cannot act on the phone without leaving a
# trace here. `phone log` reads it back, and anything else may render it; the
# record is the safety property.
#
# What gets recorded:
#   act   — anything that changes the world (send, tap, type, play, torch...)
#   read  — reads of PERSONAL data (the inbox, the screen, location)
# Mechanical reads (ui, find, battery, apps) are deliberately NOT recorded:
# a record nobody can read is not accountability, it is noise.

def ledger_path():
    p = os.environ.get("PHONE_LEDGER")
    if p:
        return p
    return os.path.join(os.path.expanduser("~"), ".local", "state",
                        "parallel-root", "actions.jsonl")


_T0 = time.time()


def record(verb, detail, kind="act", result=None, rc=None):
    """Append one line to the trace.

    It carries WHO, HOW LONG and WHETHER IT WORKED, not just what was
    attempted. Without those, a slow tap and a failed one read identically,
    and a request cannot be followed back to whoever asked for it — which is
    the whole point of keeping the record at all.
    """
    row = {"ts": round(time.time(), 3), "verb": verb, "kind": kind,
           "actor": actor(),
           # Process start to here: for a one-verb CLI that IS the verb's
           # duration, and it is honest about what it measures.
           "ms": int(round((time.time() - _T0) * 1000)),
           "rc": rc if rc is not None else (
               1 if isinstance(result, str)
               and result.lower().startswith(("failed", "unconfirmed",
                                              "did not")) else 0),
           "detail": detail}
    if result is not None:
        row["result"] = result
    path = ledger_path()
    try:
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, 0o700)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
        try:
            os.chmod(path, 0o600)   # it holds message text and contacts
        except OSError:
            pass
    except OSError:
        # Never let bookkeeping break the action itself; but say so, so a
        # missing trail is visible rather than silent.
        sys.stderr.write("phone: WARNING could not write the action ledger\n")


def _read_ledger(path):
    rows = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        return []
    return rows


# How many rows of the phone's half `log --limit 0` asks for. Unlimited would
# put the whole of a long ledger on one ssh read with a timeout on it.
REMOTE_LOG_CAP = 5000


def _remote_ledger(device, kind=None, who=None, limit=0):
    """The DEVICE's own half of the trace.

    The record is split by where the work runs, not by choice: shell-tier
    verbs go through the forwarded socket, so this process writes their line
    here; termux verbs run on the device, so the device writes theirs there.
    Two machines, half a story each — `log` here showed taps with no reads,
    `log` there showed reads with no taps.

    Merged at READ time rather than shipped at write time, because writing
    across the hop would put an ssh round trip on the hot path the forwarded
    socket exists to remove.

    Returns (rows, error). An error is not an empty list: a device that
    cannot be reached must not read as a device that did nothing.

    The PHONE filters before it limits. It used to send its newest 500 rows
    from anyone and have --actor and --kind applied here, afterwards, so a
    driver's older rows on the phone vanished behind 500 newer ones from
    everybody else, and `--limit 0` stopped at 500 — both with exit 0. The
    caller's own limit travels; only an unlimited ask is capped, and the
    caller reports a half that came back at the cap (REMOTE_LOG_CAP).
    """
    rest = ["log", "--json", "--limit", str(limit or REMOTE_LOG_CAP)]
    if kind:
        rest += ["--kind", kind]
    if who:
        rest += ["--actor", who]
    argv = remote_exec(device, rest)
    try:
        pr = subprocess.run(argv, capture_output=True, text=True, timeout=25)
    except (OSError, subprocess.SubprocessError) as e:
        return [], str(e)
    if pr.returncode != 0:
        tail = (pr.stderr or "").strip().splitlines()
        return [], (tail[-1] if tail else "exit %d" % pr.returncode)
    try:
        rows = json.loads(pr.stdout or "[]")
    except ValueError:
        return [], "unreadable ledger from %s" % device
    return (rows if isinstance(rows, list) else []), None


def cmd_notif_reply(args):
    """Reply to a message without touching the screen.

    Only the bridge can do this. Shell can SEE a notification's reply action
    through dumpsys and cannot fire it: a PendingIntent is a live Binder
    token in system_server, and dumpsys prints a description of it. Verified
    against AOSP — registerListener admits uid 1000/1001/0, and shell is
    2000.
    """
    r = bridge_call("list", device=os.environ.get("PHONE_DEVICE"))
    if r is None:
        die("the bridge app (%s) is not reachable — is it installed "
            "(PHONE_DEVICE=<phone> android/bridge/build.sh install), and is "
            "its listener enabled? As shell: %s" % (BRIDGE_APP, BRIDGE_ENABLE),
            3)
    if not r.get("ok"):
        die(r.get("err") or "the bridge refused", 4)
    rows = r.get("notifications") or []
    repliable = [n for n in rows if n.get("repliable")]
    if args.list:
        # A read of personal data — who has written, from which app — so it
        # is recorded like `notifs`: a count, never the titles.
        record("reply", {"list": True, "n": len(repliable)}, "read")
        if not repliable:
            print("(nothing on this phone can be replied to right now)")
            return 1
        for n in repliable:
            print("%-46s %-22s %s" % (n["key"][:46], (n.get("package") or "")[:22],
                                      (n.get("title") or "")[:30]))
        return 0
    if not args.key:
        die("say which notification: --list to see the keys", 2)
    if not (args.text or "").strip():
        die("refusing to send an empty message", 2)
    got = bridge_call("reply", device=os.environ.get("PHONE_DEVICE"),
                      key=args.key, text=args.text)
    if got is None:
        die("the bridge stopped answering mid-reply — nothing was sent", 3)
    if not got.get("ok"):
        record("reply", {"key": args.key[:40]}, "act",
               "failed: %s" % got.get("err"), rc=1)
        die(got.get("err") or "the reply was refused", 4)
    # The message text is NOT recorded. The ledger says a reply was sent and
    # to which notification; keeping a second copy of the user's outgoing
    # messages on another machine is not accountability, it is a transcript.
    record("reply", {"key": args.key[:40], "chars": len(args.text)},
           "act", "sent")
    print("sent")
    return 0




# --------------------------------------------------------- the fast path
# Asking a frontier model at maximum reasoning effort "what is my battery"
# costs 30-70 seconds, for a fact the phone can state in under one. So for
# the handful of things people actually ask a phone most often, the agent is
# not thinking — it is queueing.
#
# These answer from the verbs directly, in about a second, and fall through
# to the next tier the moment a question is not obviously one of them. The bar
# for matching is deliberately high: answering the WRONG question instantly
# is worse than answering the right one slowly, and a near-miss here is
# indistinguishable from the agent having misunderstood.


def _self_argv(rest):
    """This CLI's own verb, run where the answer lives: on the phone over
    ssh when a controller is asking, right here when this IS the phone.

    It was the first only, so on the phone itself the fast tier declined
    three of the questions it is documented to answer. Reproduced with stub
    termux tools: `phone battery` printed the level, and `phone ask "what is
    my battery level"` escalated.
    """
    dev = os.environ.get("PHONE_DEVICE")
    if dev:
        return remote_exec(dev, rest)
    return [sys.executable or "python3", PHONE_SELF] + rest


def _fast_shell():
    """Can a shell-backed handler reach THE phone? True or False, never an
    exit.

    `ask` stands up no forward of its own (see NO_LINK_VERBS), so a handler
    that needs the phone's shell brings the link up here, and says no when
    it cannot: the question then goes to the next tier. Asking dev_shell
    without the link would be worse than declining — it falls back to adb,
    and on a controller the adb device is whatever happens to be attached,
    not the phone that was named.
    """
    dev = os.environ.get("PHONE_DEVICE")
    if not dev:
        return True
    try:
        ensure_link(dev)
    except SystemExit:
        return False
    return True


# termux-battery-status's status, as it is said aloud. Named, never guessed
# from substrings: "charg" in the status called FULL said "discharging", and
# NOT_CHARGING (plugged in, not taking charge) said "charging". A status
# missing here is left out rather than guessed at.
_BATTERY_SAID = {"charging": "charging", "discharging": "discharging",
                 "full": "fully charged",
                 "not_charging": "plugged in but not charging"}


def _spoken_battery(_m):
    rc, out = run(_self_argv(["battery"]), timeout=30)
    if rc != 0:
        return None
    txt = (out or "").strip().split("\n")[0]
    m = re.search(r"(\d+)%\s+(\S+)", txt)
    if not m:
        return None
    pct, state = m.group(1), m.group(2).lower()
    said = _BATTERY_SAID.get(state)
    return ("%s percent, %s." % (pct, said)) if said else ("%s percent." % pct)


def _spoken_time(_m):
    # From the PHONE's clock, not ours. A controller can sit in another
    # timezone from the device, so answering from local time would be
    # confidently wrong, which is the failure mode this whole codebase keeps
    # being about.
    if not _fast_shell():
        return None
    rc, out = dev_shell("date '+%H:%M|%A %d %B'", timeout=20)
    txt = (out or "").strip()
    if rc != 0 or "|" not in txt:
        return None
    hhmm, day = txt.split("|", 1)
    try:
        h, m = [int(x) for x in hhmm.split(":")]
    except ValueError:
        return None
    ampm = "AM" if h < 12 else "PM"
    h12 = h % 12 or 12
    # Spelled for a SPEAKER, not a display. "12 02" is read aloud as
    # "twelve two"; "12 oh 2" comes out as a person would say it.
    if not m:
        return "It's %d o'clock %s." % (h12, ampm)
    mins = "oh %d" % m if m < 10 else str(m)
    return "It's %d %s %s." % (h12, mins, ampm)


def _spoken_date(_m):
    if not _fast_shell():
        return None
    rc, out = dev_shell("date '+%A, %d %B'", timeout=20)
    txt = (out or "").strip()
    return ("It's %s." % txt) if rc == 0 and txt else None


def _spoken_playing(_m):
    if not _fast_shell():
        return None      # could not ask — NOT "nothing is playing"
    rc, raw = dev_shell("dumpsys media_session", timeout=30)
    if rc != 0 or not (raw or "").strip():
        return None      # could not ask — NOT "nothing is playing"
    sessions = parse_media_sessions(raw)
    cur = current_session(sessions)
    if not cur:
        return "Nothing is playing."
    desc = cur.get("description")
    if cur.get("state") != "PLAYING":
        return ("Nothing is playing right now. %s is paused."
                % (desc.split(",")[0] if desc else cur["package"]))
    return desc.split(",")[0] if desc else "Something is playing."


def _spoken_notifs(_m):
    rc, out = run(_self_argv(["notifs", "--json"]), timeout=40)
    if rc != 0:
        return None      # could not ask — NOT "nothing is waiting"
    try:
        rows = json.loads(out or "[]")
    except ValueError:
        return None
    # A group summary is Android's own rollup, not a message; counting it
    # reports two things for one.
    real = [r for r in rows if (r.get("title") or "").strip()
            and "::SUMMARY::" not in (r.get("tag") or "")]
    if not real:
        return "Nothing is waiting."
    apps = {}
    for r in real:
        apps[r.get("packageName", "")] = apps.get(r.get("packageName", ""), 0) + 1
    top = sorted(apps.items(), key=lambda kv: -kv[1])[:3]
    bits = ["%d from %s" % (n, p.rsplit(".", 1)[-1]) for p, n in top]
    return "%d notifications: %s." % (len(real), ", ".join(bits))


def _spoken_cal(_m):
    rc, out = run(_self_argv(["cal", "--days", "1", "--json"]), timeout=40)
    if rc != 0:
        return None      # could not ask — NOT "nothing on the calendar"
    try:
        evs = json.loads(out or "[]")
    except ValueError:
        return None
    if not evs:
        return "Nothing on the calendar today."
    first = evs[0]
    when = time.strftime("%H:%M", time.localtime(first["begin_ms"] / 1000))
    if len(evs) == 1:
        return "One thing today: %s at %s." % (first["title"], when)
    return "%d things today, next is %s at %s." % (len(evs), first["title"], when)


def _media_action(action):
    def go(_m):
        if not _fast_shell():
            return None
        rc, _o = dev_shell("cmd media_session dispatch %s" % DISPATCH[action],
                           timeout=25)
        if rc != 0:
            return None
        time.sleep(1.2)
        cur = current_session(parse_media_sessions(
            dev_shell("dumpsys media_session", timeout=30)[1] or ""))
        state = (cur or {}).get("state", "")
        # Say what actually happened, not what was asked for.
        if action in ("pause", "stop"):
            return "Paused." if state != "PLAYING" else "It did not pause."
        if action == "play":
            return "Playing." if state == "PLAYING" else "It did not start."
        return (cur or {}).get("description", "").split(",")[0] or "Skipped."
    # Named for its action, so "fast path declined (...)" says which one.
    go.__name__ = "_media_%s" % action
    return go


# Anchored deliberately, and to the WHOLE question: a pattern must match all
# of what was said, give or take the words a speaker puts around a question
# (see _utterance), never a word somewhere inside it. Matched on nouns
# anywhere, instructions were answered as questions, with exit 0: "turn on
# battery saver", "power off the phone" and "remind me to charge the car" got
# the battery, "add lunch to my calendar" and "open the calendar app" the
# calendar, "clear my notifications" a count of them, and "what time does the
# store close" the phone's clock. A phrasing these do not cover goes to the
# next tier, which is where it belongs. "what is playing" matches; "play
# something by the artist who wrote the song about playing" does not, and
# goes to the agent.
_WHATS = r"what(?:'s|s| is)"
FAST = [
    (re.compile(_WHATS + r" the (?:current )?time|what time is it"
                r"|what time it is|(?:the )?(?:current )?time"),
     _spoken_time),
    (re.compile(_WHATS + r" (?:the date(?: today)?|today's date)"
                r"|what (?:date|day) is (?:it(?: today)?|today)"
                r"|(?:the |today's )?date(?: today)?"),
     _spoken_date),
    (re.compile(_WHATS + r" (?:my|the) battery"
                r"(?: level| percentage| percent| status)?(?: at)?"
                r"|what percent(?:age)? is (?:my|the) battery(?: at)?"
                r"|how much battery(?: do i have| have i got| is left"
                r"| is there)?(?: left)?"
                r"|how(?:'s| is) (?:my|the) battery(?: doing)?"
                r"|(?:my |the )?battery"
                r"(?: level| percentage| percent| status| left)?"),
     _spoken_battery),
    (re.compile(_WHATS + r" (?:playing|this song|the song|this track)"
                r"|what song is (?:this|playing)|what am i listening to"),
     _spoken_playing),
    (re.compile(r"(?:(?:do i have|have i got|are there|is there) )?any "
                r"(?:new )?(?:messages?|notifications?|texts)(?: for me)?"
                r"|what (?:new )?(?:messages|notifications) "
                r"(?:do i have|have i got)"
                r"|how many (?:new )?(?:messages|notifications)"
                r"(?: do i have| have i got)?"
                r"|(?:my )?(?:new )?notifications"
                r"|(?:is there |do i have )?anything (?:new |waiting )?for me"
                r"|(?:is there )?anything waiting|what did i miss"),
     _spoken_notifs),
    (re.compile(_WHATS + r" on (?:my |the )?(?:calendar|schedule|agenda)"
                r"(?: (?:for )?today)?"
                r"|" + _WHATS + r" on(?: for)? today"
                r"|" + _WHATS + r" (?:my|today's) (?:calendar|schedule|agenda)"
                r"(?: (?:for |like )?today)?"
                r"|what does my day look like(?: today)?"
                r"|" + _WHATS + r" my day(?: look(?:ing)? like)?"
                r"|(?:do i have|have i got) any(?:thing| meetings| events) "
                r"(?:on )?today"
                r"|(?:my |today's )(?:calendar|schedule|agenda)"),
     _spoken_cal),
    (re.compile(r"pause(?: (?:the |this )?(?:music|song|track|playback|it))?"
                r"|stop (?:the |this )?(?:music|song|track|playback|it)"
                r"|stop playing"),
     _media_action("pause")),
    (re.compile(r"(?:resume|unpause)"
                r"(?: (?:the |this )?(?:music|song|track|playback|it))?"
                r"|(?:keep|continue) playing|play(?: the music| music)?"),
     _media_action("play")),
    (re.compile(r"(?:next|skip)(?: (?:the |this )?(?:song|track|one|it))?"
                r"|(?:play |go to )?the next (?:song|track)"),
     _media_action("next")),
]


# What a speaker puts around a question, taken off both ends before the
# patterns above are tried against all that is left. Nothing else is
# removed: a word that is not one of these is part of the question, and a
# question with words the patterns do not expect is not one of theirs.
_FILLER_HEAD = re.compile(
    r"\A(?:(?:hey|hi|ok|okay|so|um+|uh+|well|please|and)[,.!]?\s+)*"
    r"(?:(?:can|could|would) you (?:please )?(?:tell me|check)\s+"
    r"|(?:do you know|tell me|let me know)\s+)?")
_FILLER_TAIL = re.compile(
    r"(?:[,\s]+(?:please|thanks|thank you|right now|now))*\s*[?.!]*\Z")


def _utterance(text):
    t = re.sub(r"\s+", " ", (text or "").lower().replace("\u2019", "'"))
    t = _FILLER_TAIL.sub("", _FILLER_HEAD.sub("", t.strip()))
    return t.strip()


# A REQUEST TO SEND SOMETHING IS NOT A QUESTION, and when the patterns above
# matched nouns anywhere in a sentence they could not tell the two apart.
# Measured: "open whatsapp and send bob a message about dinner" hit the
# notifications pattern on the word "message" and was answered with a count
# of notifications by app. The person is told what is in their inbox and Bob
# never hears from them — the read tier swallowed an instruction and reported
# success. Whole-question matching keeps that sentence out by itself now;
# this guard stays as the second line over the exact collision that was
# measured, so a pattern loosened later cannot reopen it.
#
# This is not an intent classifier and must not grow into one. It is a narrow
# guard over the exact collision: verbs of communication, which are the only
# ones whose objects ("a message", "a text") are also the nouns the read
# patterns key on. `tell` and `ask` are here too, but only when they are not
# directed at the speaker — "tell me the time" is a question, "tell alice to
# merge" is an errand.
#
# Media transport words are deliberately absent: "pause", "skip" and "play"
# collide with nothing, and blocking them would break the controls the fast
# tier exists to serve.
_ACT_REQUEST = re.compile(
    r"\b(send|text|reply|respond|forward|dm|whats\s?app|email)\b"
    r"|\b(tell|ask)\b(?!\s+me\b)")


def fast_match(text):
    """Which fast handler should answer this, or None.

    Split out from fast_answer so the DECISION can be tested without a device
    attached: every handler here shells out to the phone, so asserting on the
    answer needs hardware, while asserting on the choice needs nothing.
    """
    low = " " + text.lower().strip() + " "
    if _ACT_REQUEST.search(low):
        return None
    said = _utterance(text)
    for pat, fn in FAST:
        m = pat.fullmatch(said)
        if m:
            return m, fn
    return None


def fast_answer(text):
    """A spoken answer without waking an agent, or None to fall through."""
    got = fast_match(text)
    if not got:
        return None
    m, fn = got
    try:
        return fn(m)
    except Exception as e:
        # Falling through is right — the shortcut must never break the slow
        # path — but doing it SILENTLY turned "the handler failed" into "no
        # pattern matched", and cost an hour of staring at a regex that was
        # correct all along.
        sys.stderr.write("phone: fast path declined (%s: %s) — "
                         "falling through to the next tier\n"
                         % (fn.__name__, e))
        return None



# ------------------------------------------------------------- the router
# The middle tier is a command you choose: `--router CMD`, or $PHONE_ROUTER.
# There is no default. Which model answers questions about someone's phone,
# under which sandbox and on whose account, is the owner's decision, not
# this file's.
#
# THREE TIERS, and the middle one is why the regexes are not the whole
# story. Measured on a reference setup:
#
#   fast       ~1.5s   nine question shapes, no model, no judgement
#   router     5-10s   a SMALL model, warm — any phrasing, and it
#                      genuinely reasons ("is my phone about to
#                      die" -> "no, you're at 51 percent")
#   agent      ~40s    a frontier model, for work rather than answers
#
# The regexes survive only because 1.5s is perceptibly better than 7s on the
# handful of things people ask constantly. Everything else should reach a
# model, because "how much juice have I got left" is the same question as
# "what's my battery" and no pattern list ever ends.
#
# CMD is split the way a shell would split it (shlex; no shell runs it) and
# the brief is appended as ONE final argument, so a question can carry any
# punctuation without being re-parsed by anything. A headless coding agent
# is the usual choice. Two small models, A and B, driven that way measured
# close enough that the choice is a preference rather than a finding:
#
#   sistine chapel   A 2.0s "Michelangelo"
#                    B 5.6s "Michelangelo painted the Sistine Chapel
#                            ceiling, completing it between 1508 and 1512"
#   train arithmetic A 4.5s "4 15"           B 3.3s "It arrives at 4:15."
#   battery          A 6.5s                  B 8.8s
#
# Neither got anything wrong. Note B's verbosity is a real cost HERE that it
# would not be on a screen — "Michelangelo" is the better spoken answer, and
# every extra clause is another second of someone waiting to talk.
#
# Whatever the router loads at startup it pays for on every question: one
# dangling MCP server entry cost 7.4s of handshake timeout per call — 11.05s
# down to 3.66s once it was removed. A router has no use for MCP servers, so
# point --router at a configuration that starts none.

# THIS file, resolved from the module rather than argv[0]. argv[0] is right
# when someone types `phone`, and wrong the moment this is imported, exec'd,
# or invoked through a wrapper — where the router is then briefed to run a
# binary that does not exist. It spent 53 seconds discovering that and
# answered ESCALATE, which reads exactly like a question it judged too hard.
PHONE_SELF = os.path.realpath(globals().get("__file__") or sys.argv[0])

# The verbs the brief offers the router. Every one of them is a read: a
# router that would have to act on the phone has been asked the wrong thing,
# and the brief tells it to say ESCALATE instead.
ROUTER_VERBS = ("battery | media --current | notifs | cal --days 1 | "
                "foreground | contacts <name>")


def router_argv(cmd):
    """The router command as an argv list, or None when there is none.

    Raises ValueError for a command shlex cannot split (an unbalanced quote).
    """
    import shlex as _sh
    return _sh.split(cmd or "") or None


def router_brief(text, device):
    """What the router is told: ONE string, appended as its last argument."""
    import shlex as _sh
    me = _sh.quote(PHONE_SELF)
    if device:
        me += " --device %s" % _sh.quote(device)
    return (
        "You answer out loud for someone LISTENING. One or two SHORT "
        "sentences, no markdown, no preamble, numbers as a person says "
        "them.\n"
        "You may run: %s <verb>\n"
        "verbs: %s\n"
        "Answer questions on ANY subject from your own knowledge. Reply with "
        "exactly ESCALATE only if it needs multi-step action, the screen, or "
        "sending something to a person.\n"
        "Question: %s" % (me, ROUTER_VERBS, text))


def router_answer(stdout):
    """The answer out of everything the router printed, or None.

    The LAST non-empty line, because agents print their progress first and
    the answer at the end — skipping lines that open with `[` (status and
    log lines) and any that report "tokens used".
    """
    lines = [l for l in (stdout or "").splitlines()
             if l.strip() and not l.startswith("[")
             and "tokens used" not in l.lower()]
    return lines[-1].strip() if lines else None


def ask_router(argv, text, device, timeout):
    """Run the router once. Returns (answer, err); exactly one is None.

    A non-zero exit is a failure even when something was printed: an error
    message on stdout must never be read out as the answer.
    """
    name = os.path.basename(argv[0])
    try:
        # stdin closed: a router that waits for input would otherwise sit
        # there until the timeout and then read as a failure to answer.
        pr = subprocess.run(argv + [router_brief(text, device)],
                            capture_output=True, text=True, timeout=timeout,
                            stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, "%s gave no answer within %ds" % (name, timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "%s did not run (%s)" % (name, e)
    if pr.returncode != 0:
        tail = (pr.stderr or "").strip().splitlines()
        return None, "%s exited %d%s" % (name, pr.returncode,
                                         (": %s" % tail[-1]) if tail else "")
    answer = router_answer(pr.stdout)
    if not answer:
        return None, "%s returned nothing" % name
    return answer, None


def cmd_ask(args):
    """The ladder, without the microphone.

    Whatever is asking already has the ears and the mouth — a voice front
    end, a chat bridge, a person at a terminal — so all it needs back is the
    answer, from the cheapest tier that can give one honestly. A general
    knowledge question ("tell me about X") sent straight to a frontier agent
    at high effort took forty seconds, when a small router model answers it
    from its own knowledge in five — which is the whole reason the router
    tier exists.

    Prints the answer on stdout and the tier it came from on stderr, so a
    caller that wants only the answer can take stdout and a person watching
    can still see what happened. Exit 4 means ESCALATE: no tier here could
    answer it, and the caller should put it to an agent. Exit 5 means the
    router itself failed to run.
    """
    text = " ".join(args.text).strip()
    if not text:
        die("nothing to ask", 2)
    # --device is stripped from argv before argparse ever sees it and lands
    # in the environment, so there is no args.device to read.
    device = os.environ.get("PHONE_DEVICE")

    if not args.no_fast:
        quick = fast_answer(text)
        if quick:
            record("ask", {"tier": "fast", "chars": len(text)}, "read")
            sys.stderr.write("tier: fast\n")
            print(quick)
            return 0

    # `--router ''` is an explicit "none", even with PHONE_ROUTER set.
    cmd = (args.router if args.router is not None
           else os.environ.get("PHONE_ROUTER") or "")
    try:
        argv = router_argv(cmd)
    except ValueError as e:
        # The command itself is not echoed: it is configuration, and it may
        # carry something its owner would not want copied into a log.
        sys.stderr.write("router failed: the router command cannot be split "
                         "(%s)\n" % e)
        return 5
    if not argv:
        sys.stderr.write("tier: none could answer, and no router is "
                         "configured — ESCALATE\n")
        return 4

    name = os.path.basename(argv[0])
    t0 = time.time()
    answer, err = ask_router(argv, text, device, args.router_timeout)
    took = time.time() - t0
    if answer and "ESCALATE" not in answer.upper():
        record("ask", {"tier": "router", "router": name,
                       "ms": int(took * 1000)}, "read")
        sys.stderr.write("tier: router (%s, %.1fs)\n" % (name, took))
        print(answer)
        return 0
    if answer:
        # The router read the question and said it needs more than it has.
        # That is a real answer, not a failure — report it as one.
        record("ask", {"tier": "router", "router": name, "escalate": True},
               "read")
        sys.stderr.write("tier: router said ESCALATE (%.1fs)\n" % took)
        return 4
    record("ask", {"tier": "router", "router": name}, "read",
           "failed: %s" % err, rc=1)
    sys.stderr.write("router failed: %s\n" % err)
    # A router that could not run is NOT an escalation decision. Saying so
    # separately matters: escalating on a crash would silently send
    # everything to the expensive tier the moment the router broke.
    return 5


def cmd_log(args):
    rows = _read_ledger(ledger_path())
    device = os.environ.get("PHONE_DEVICE")
    remote_err = None
    cut = False
    if device:
        # Only in --device mode does the split exist, so only here does the
        # output gain an origin. A local run keeps exactly the shape it had.
        for r in rows:
            r["origin"] = "here"
        far, remote_err = _remote_ledger(device, args.kind, args.actor,
                                         args.limit)
        # An unlimited read is capped on the phone's side, and a half that
        # came back AT the cap may have more behind it.
        cut = not args.limit and len(far) >= REMOTE_LOG_CAP
        for r in far:
            r["origin"] = device
        rows = rows + far
        rows.sort(key=lambda r: r.get("ts") or 0)
    if args.kind:
        rows = [r for r in rows if r.get("kind") == args.kind]
    if args.actor:
        rows = [r for r in rows if r.get("actor") == args.actor]
    rows.reverse()
    if args.limit:
        rows = rows[:args.limit]
    partial = None
    if remote_err:
        partial = "could not read %s's half of the trace (%s)" % (device,
                                                                  remote_err)
    elif cut:
        partial = ("%s's half of the trace stops at its newest %d rows; any "
                   "older ones were not fetched" % (device, REMOTE_LOG_CAP))
    if args.json:
        print(json.dumps(rows, indent=2))
        if partial:
            sys.stderr.write("phone: %s\n" % partial)
            return 3
        return 0
    if partial:
        # Loud, and BEFORE the rows, because the danger is reading a partial
        # trace as a complete one. Local rows still print: half an answer is
        # worth having, an empty one that looks whole is not.
        sys.stderr.write("phone: %s — what follows is %s\n"
                         % (partial, "this machine's half only" if remote_err
                            else "incomplete"))
    if not rows:
        print("(no actions recorded)")
        return 3 if partial else 0
    import time as _t
    for r in rows:
        when = _t.strftime("%H:%M", _t.localtime(r.get("ts") or 0))
        mark = "*" if r.get("kind") == "act" else " "
        det = r.get("detail")
        if not isinstance(det, str):
            det = json.dumps(det)
        res = r.get("result")
        who = r.get("actor") or "-"
        ms = r.get("ms")
        bad = "!" if r.get("rc") else " "
        # The origin column exists only when there are two ledgers to tell
        # apart. Without --device there is one, and naming it is noise.
        org = ("%-9s " % (r.get("origin") or "-")[:9]) if device else ""
        print("%s %s%s %s%-9s %-8s %s%s%s"
              % (when, mark, bad, org, who[:9], r.get("verb") or "?", det,
                 ("  -> " + str(res)) if res else "",
                 ("  %dms" % ms) if isinstance(ms, int) else ""))
    # A half-trace does not exit 0. Anything reading this to answer "what
    # was done to my phone" would take success as "and that was all of it".
    return 3 if partial else 0



# ----------------------------------------------------------------- watchdog
# Android is hostile to long-lived background work, and a phone is a device
# that wanders between networks and sleeps hard. Everything else here assumes
# the phone is reachable; this is what makes that assumption survivable.
#
# The scheduler matters as much as the checks. A `while true` loop in Termux
# gets killed — that is the whole problem — so the watchdog registers with
# Android's own JobScheduler via termux-job-scheduler, which the OS honours
# and which persists across reboots.

# The steps, in order. A pass prints each step's name, marks a failing one
# with `!`, and prints a step that does not apply here as `<name>-`.
# @SELF@ is this CLI, filled in at run time (see watchdog_plan).
WATCHDOG_STEPS = (
    ("wakelock", "termux-wake-lock",
     "hold the wake-lock so Termux is not reaped while idle"),
    ("sshd", "pgrep -x sshd >/dev/null 2>&1 || sshd",
     "sshd is how a controller reaches this phone at all"),
    ("shizuku", 'R="${PHONE_RISH:-$HOME/rish}"; test -x "$R" && '
                'RISH_APPLICATION_ID="${RISH_APPLICATION_ID:-com.termux}" '
                'timeout 20 "$R" -c true >/dev/null 2>&1',
     "shizuku is the shell tier; check it still answers"),
    # --start reuses a live daemon, busy or idle, rather than binding over
    # it, so this costs nothing while the daemon is up and is the restart
    # when it is not. Its exit status is the daemon's health: 0 only when a
    # daemon answers, or is busy answering someone else. The DEFAULT lane
    # only: a lane belongs to the driver that asked for it, and that driver
    # starts it (see ensure_link). Runs only after shizuku passed (see
    # WATCHDOG_NEEDS).
    ("shelld", "PHONE_LANE= @SELF@ shelld --start >/dev/null 2>&1",
     "the persistent shell, on the default lane; only when shizuku "
     "answers, and never in place of a live daemon"),
    # Opt-in. adb is the fallback shell tier, which a phone with Shizuku does
    # not need, and there is no address worth guessing at. A pinned port
    # (`adb tcpip 5555`) makes reconnecting a single dial. The device list
    # is read again after dialling, so the step passes when a device is
    # actually attached — not because a command exited 0.
    ("adb", "adb devices 2>/dev/null | grep -q 'device$' || "
            "{ adb connect \"$PHONE_ADB_ADDR\" >/dev/null 2>&1; "
            "adb devices 2>/dev/null | grep -q 'device$'; }",
     "reconnect adb, the fallback shell tier, at $PHONE_ADB_ADDR"),
)

# A step that is only worth running when another one passed, printed as
# `<name>-` when it did not. The daemon's shell IS rish: with Shizuku not
# answering, a fresh daemon would serve nothing but failures and — because
# dev_shell takes whatever the daemon says — would keep every verb from the
# adb fallback. A daemon that is already up is left alone; the leases live in
# it.
WATCHDOG_NEEDS = {"shelld": "shizuku"}

# JobScheduler replaces a job by its id, so a FIXED id is what makes
# `--install` idempotent: installing again updates this watchdog instead of
# stacking a second one, and a job registered under any other id is left
# alone.
WATCHDOG_JOB_ID = 7137


def watchdog_plan():
    """WATCHDOG_STEPS made concrete for this pass: [(name, command, why)].

    The command is None for a step that does not apply — adb, until
    PHONE_ADB_ADDR says where to dial.
    """
    import shlex as _sh
    me = "%s %s" % (_sh.quote(sys.executable or "python3"),
                    _sh.quote(PHONE_SELF))
    plan = []
    for name, cmd, why in WATCHDOG_STEPS:
        if name == "adb" and not (os.environ.get("PHONE_ADB_ADDR")
                                  or "").strip():
            plan.append((name, None, "skipped: PHONE_ADB_ADDR is not set "
                                     "(<phone-ip>:<port> turns it on)"))
            continue
        plan.append((name, cmd.replace("@SELF@", me), why))
    return plan


def watchdog_job_id():
    raw = (os.environ.get("PHONE_WATCHDOG_JOB_ID") or "").strip()
    if not raw:
        return WATCHDOG_JOB_ID
    if not re.match(r"\A[0-9]{1,9}\Z", raw):
        die("PHONE_WATCHDOG_JOB_ID wants a non-negative integer, got %r"
            % raw, 2)
    return int(raw)


def tier_notice(alive):
    """Tell the human when the shell tier is gone.

    Shizuku's service can stop while the phone stays up — observed with an
    uptime of two days — and Level 1 keeps working, which is by design. But
    a silent loss means the phone quietly sheds half its capability and the
    agent starts refusing things for reasons nobody can see. So it says so,
    on the device, with the fix in the notification.
    """
    if not have_termux():
        return
    if alive:
        run([shutil.which("termux-notification-remove") or "true",
             "phone-tier"], timeout=15)
        return
    run([shutil.which("termux-notification") or "true",
         "--title", "phone: shell tier down",
         "--content", "Shizuku stopped. Screen/tap unavailable; inbox and "
                      "voice still work. Open Shizuku and start it.",
         "--id", "phone-tier", "--priority", "high",
         "--button1", "Open Shizuku",
         "--button1-action",
         "am start -n moe.shizuku.privileged.api/"
         "moe.shizuku.manager.MainActivity"], timeout=20)


def cmd_watchdog(args):
    if args.install:
        import shlex as _sh
        script = os.path.join(os.path.expanduser("~"), ".local", "bin",
                              "parallel-root-watchdog.sh")
        job = watchdog_job_id()
        # Written for a STRIPPED environment. A script Termux launches by
        # itself — a notification action, a scheduled job — can run with
        # PATH set to $PREFIX/bin alone (no ~/.local/bin), and without the
        # termux-exec shim that normally rewrites shebangs at exec time; and
        # Termux has no /usr/bin/env, so `#!/usr/bin/env python3` is simply
        # "not found". Hence an absolute shebang, an exported PATH, and
        # python invoked explicitly on this file's absolute path instead of
        # through this file's own shebang. (Observed on a reference device,
        # from a notification action: a button silently did nothing because
        # `phone` was not found.)
        #
        # The log's directory is made by the script itself: the first pass
        # can run before anything else has created it.
        body = ("#!/data/data/com.termux/files/usr/bin/sh\n"
                "export PATH=\"$HOME/.local/bin:$PREFIX/bin:$PATH\"\n"
                "mkdir -p \"$HOME/.local/state/parallel-root\"\n"
                "%s %s watchdog "
                ">> \"$HOME/.local/state/parallel-root/watchdog.log\" 2>&1\n"
                % (_sh.quote(sys.executable or "python3"),
                   _sh.quote(PHONE_SELF)))
        argv = ["termux-job-scheduler",
                "--job-id", str(job),
                "--script", script,
                "--period-ms", str(args.every * 60 * 1000),
                "--persisted", "true",
                "--network", "any"]
        if args.print_only:
            print("write %s:" % script)
            print(body.rstrip())
            print(" ".join(argv))
            return 0
        need_termux()
        try:
            d = os.path.dirname(script)
            if d and not os.path.isdir(d):
                os.makedirs(d, 0o700)
            with open(script, "w") as f:
                f.write(body)
            os.chmod(script, 0o700)
        except OSError as e:
            die("could not write %s (%s)" % (script, e), 4)
        rc, out = run([shutil.which("termux-job-scheduler") or
                       "termux-job-scheduler"] + argv[1:], timeout=30)
        if rc != 0:
            die("could not register the job: %s" % (out or "").strip(), 4)
        record("watchdog", {"every_min": args.every, "job_id": job}, "act",
               "installed")
        print("watchdog registered (job %d, every %d min, persisted)"
              % (job, args.every))
        return 0

    plan = watchdog_plan()
    if args.print_only:
        for name, cmd, why in plan:
            print("%-9s %s" % (name if cmd else name + "-", why))
            if cmd:
                print("          %s" % cmd)
        return 0
    need_termux()
    marks, failed, passed = [], [], set()
    for name, cmd, _why in plan:
        if cmd is None:
            marks.append(name + "-")
            continue
        need = WATCHDOG_NEEDS.get(name)
        if need and need not in passed:
            marks.append(name + "-")
            continue
        rc, _out = run(["sh", "-c", cmd], timeout=60)
        if rc != 0:
            marks.append(name + "!")
            failed.append(name)
        else:
            marks.append(name)
            passed.add(name)
    # Only record when a step failed — a watchdog that writes a line every
    # 15 minutes buries the entries that matter.
    if failed:
        record("watchdog", " ".join(marks), "act",
               "failed: %s" % ", ".join(failed))
    # Raise or clear the tier notice based on what we just measured.
    tier_notice("shizuku" not in failed)
    print(" ".join(marks))
    return 0


# ------------------------------------------------------------ configuration
# PHONE_* settings in a file, for the shells that never read a profile — an
# agent's tool shell, a job scheduler, a one-off ssh command. Loaded once, at
# the very start of main(), so everything after it (the global flags
# included) sees the file's values exactly as if they had been exported.
#
# The environment ALWAYS wins, and present means present: an empty value is
# still a value. That is load-bearing on the far side of a hop, which runs
# `PHONE_DEVICE= phone ...` precisely so that it cannot hop onward. A config
# file on the phone that could fill that empty PHONE_DEVICE back in would
# make the last hop not the last.
#
# The format is the shell's assignment line, and no more of the shell than
# that: KEY=VALUE, an optional `export `, one layer of matching quotes, whole
# lines of `#` comment. Nothing is expanded and nothing is executed.

_CONFIG_LINE = re.compile(r"\A(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)\Z")


def config_path():
    p = os.environ.get("PHONE_CONFIG")
    if p:
        return p
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config")
    return os.path.join(base, "parallel-root", "config")


def parse_config(text):
    """KEY=VALUE text -> ({key: value}, [problem, ...]).

    Only PHONE_ keys are settings; any other key is a problem, reported by
    NAME and never by value — a value is the one thing in this file that
    might be a secret. A later line for the same key wins, as in a shell.
    """
    settings, problems = {}, []
    for n, raw in enumerate((text or "").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = _CONFIG_LINE.match(line)
        if not m:
            problems.append("line %d is not KEY=VALUE" % n)
            continue
        key, val = m.group(1), m.group(2).strip()
        if not key.startswith("PHONE_"):
            problems.append("line %d sets %s, which is not a PHONE_ setting"
                            % (n, key))
            continue
        if key == "PHONE_CONFIG":
            # The file has already been chosen by the time this line is
            # read. Exported, it would only send every process this one
            # starts to a different file than the one it was started from.
            problems.append("line %d sets PHONE_CONFIG, which only the "
                            "environment can choose" % n)
            continue
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        settings[key] = val
    return settings, problems


def load_config():
    """Apply the config file to os.environ. Returns what it applied.

    A missing file is the normal case and says nothing. An unreadable one,
    or lines that are not settings, get ONE warning on stderr and are
    otherwise ignored: the shape of the file is never the reason a verb did
    not run. A setting's VALUE is checked where it is used, exactly as if it
    had been exported — a bad PHONE_LANE fails the same way from here as
    from the environment.
    """
    path = config_path()
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        sys.stderr.write("phone: warning: cannot read config %s (%s); "
                         "ignoring it\n" % (path, e.strerror or e))
        return {}
    settings, problems = parse_config(text)
    if problems:
        sys.stderr.write("phone: warning: config %s: ignored %s\n"
                         % (path, "; ".join(problems)))
    applied = {}
    for key, val in settings.items():
        if key not in os.environ:
            os.environ[key] = val
            applied[key] = val
    return applied


def build_parser():
    p = argparse.ArgumentParser(prog="phone", add_help=True,
                                description="let agents drive an Android "
                                            "phone, on the phone or from any "
                                            "machine that can ssh to it")
    sub = p.add_subparsers(dest="verb")

    def add(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        return s

    s = add("say", cmd_say, "speak text aloud")
    s.add_argument("text", nargs="+")
    s.add_argument("--timeout", type=int, default=60)

    s = add("listen", cmd_listen, "speech -> text on stdout")
    s.add_argument("--timeout", type=int, default=60)

    s = add("notifs", cmd_notifs, "the universal inbox (all apps)")
    s.add_argument("--app")
    s.add_argument("--since")
    s.add_argument("--limit", type=int, default=0)
    s.add_argument("--json", action="store_true")
    s.add_argument("--from", dest="from_file")

    s = add("ui", cmd_ui, "read the screen as tappable text")
    s.add_argument("--grep")
    s.add_argument("--save", help="also write the raw UI XML to this file")
    s.add_argument("--from", dest="from_file")

    s = add("look", cmd_look, "the screen, summarised for an agent")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--all", action="store_true",
                   help="include things that cannot be tapped")
    s.add_argument("--grep", help="only lines whose label contains this")
    s.add_argument("--ids", action="store_true",
                   help="append each target's resource-id")
    s.add_argument("--from", dest="from_file")

    s = add("find", cmd_find, "label -> tap coordinates (or fail loudly)")
    s.add_argument("query", nargs="?")
    s.add_argument("--id", dest="rid", help="match a resource-id instead")
    s.add_argument("--all", action="store_true",
                   help="list every candidate instead of picking one")
    s.add_argument("--exact", action="store_true",
                   help="exact label match only, no substrings")
    s.add_argument("--after", metavar="LABEL",
                   help="only match below this label in the tree — how you "
                        "say WHICH 'Large' you meant")
    s.add_argument("--raw", action="store_true",
                   help="geometric centre, skipping the occlusion check")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--from", dest="from_file")

    s = add("tap", cmd_tap, "tap x y, or --label/--id in one call")
    s.add_argument("x", type=int, nargs="?")
    s.add_argument("y", type=int, nargs="?")
    s.add_argument("--label", help="find this and tap it, in one round trip")
    s.add_argument("--id", dest="rid", help="find this resource-id and tap it")
    s.add_argument("--after", metavar="LABEL")
    s.add_argument("--exact", action="store_true")
    s.add_argument("--raw", action="store_true")
    s.add_argument("--look", action="store_true",
                   help="look at the screen afterwards, in the same call")
    s.add_argument("--settle", type=float, default=2.0)
    s.add_argument("--limit", type=int, default=40)

    s = add("swipe", cmd_swipe, "swipe x1 y1 x2 y2")
    s.add_argument("x1", type=int)
    s.add_argument("y1", type=int)
    s.add_argument("x2", type=int)
    s.add_argument("y2", type=int)
    s.add_argument("--ms", type=int, default=260)

    s = add("scroll", cmd_scroll, "scroll the screen a page at a time")
    s.add_argument("direction", nargs="?", default="down",
                   choices=["down", "up", "left", "right"])
    s.add_argument("--n", type=int, default=1, help="how many screenfuls")
